@model PlanningCore.Models.MainSettingViewModel
@using PlanningCore.Utilities;
@inject IUtility _Utility
@{
    ViewData["Title"] = "कार्यालय सेटअप";
}
<div class="page-breadcrumb colr1">
    <div class="row">
        <div class="col-12 d-flex no-block align-items-center">
            <div class="ms-auto text-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="#">गृह पृष्ट</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            कार्यालय:
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div style="display:flex; margin-left:20px;">
                <h4 class="card1" style="background-color:#3c8dbc; color:#fff; height:40px; width:200px; padding-top:5px; text-align:center;">कार्यालय सेटअप </h4>
                <span style="height:2rem; background-color:#3c8dbc; width:10px; height:40px;"></span>
                <span style="height: 2rem; border-top: 17px solid transparent;border-left: 25px solid #3c8dbc;border-bottom: 22px solid transparent; height:40px;"> </span>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid colr1">
    <div class="main-card ms-3 card">
        <div class="card-body">
            <h5 class="card-title">कार्यालय सेटअप </h5>

            <form asp-action="CreateMainSetting" enctype="multipart/form-data">

                <div class="row d-flex">


                    <div class="form-group mt-2 col-md-3 col-3">
                        <input asp-for="Id" type="hidden" />
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-2 col-md-3 col-3">
                        <label asp-for="StateId" class="control-label"></label>
                        <select asp-for="StateId" asp-items=" await _Utility.GetStateSelectListItems()" class="form-control">
                            <option>--	<label asp-for="StateId" class="control-label"></label>--</option>
                        </select>
                    </div>

                    <div class="form-group mt-2 col-md-3 col-3 ">
                        <label asp-for="DistrictId" class="control-label"></label>
                        <select asp-for="DistrictId" asp-items=" await _Utility.GetDistrictSelectListItems()" class="form-control">
                            <option>--	<label asp-for="DistrictId" class="control-label"></label>--</option>
                        </select>

                    </div>
                    <div class="form-group mt-2 col-md-3 col-3">
                        <label asp-for="PalikaId" class="control-label"></label>
                        <select asp-for="PalikaId" asp-items=" await _Utility.GetPalikaSelectListItems()" class="form-control">

                            <option>--	<label asp-for="PalikaId" class="control-label"></label>--</option>

                        </select>

                    </div>

                    <div class="form-group mt-2 col-md-3 col-3 ">
                        <label asp-for="PalikaType" class="control-label"></label>
                        <select asp-for="PalikaType" asp-items=" await _Utility.GetPalikaType(0)" class="form-control">
                            <option>--	<label asp-for="PalikaType" class="control-label"></label>--</option>

                        </select>

                    </div>
                    <div class="form-group mt-2 col-md-3 col-3 ">

                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-2 col-md-3 col-2">

                        <label asp-for="ContactName" class="control-label"></label>
                        <input asp-for="ContactName" class="form-control" />
                        <span asp-validation-for="ContactName" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-2 col-md-3 col-3 ">

                        <label asp-for="ContactNumber" class="control-label"></label>
                        <input asp-for="ContactNumber" class="form-control" />
                        <span asp-validation-for="ContactNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-2 col-md-3 col-3">

                        <label asp-for="MobileNumber" class="control-label"></label>
                        <input asp-for="MobileNumber" class="form-control" />
                        <span asp-validation-for="MobileNumber" class="text-danger"></span>

                    </div>
                    <div class="form-group mt-2 col-md-3 col-3 ">
                        <label asp-for="FaxNo" class="control-label"></label>
                        <input asp-for="FaxNo" class="form-control" />
                        <span asp-validation-for="FaxNo" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-2 col-md-3 col-3 ">

                        <label asp-for="Website" class="control-label"></label>
                        <input asp-for="Website" class="form-control" />
                        <span asp-validation-for="Website" class="text-danger"></span>
                    </div>


                    <div class="form-group mt-2 col-md-3 col-3 ">

                        <label asp-for="Address" class="control-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>

                    </div>

                    <div class="form-group mt-2 col-md-3 col-3 ">

                        <label asp-for="Address2" class="control-label"></label>
                        <input asp-for="Address2" class="form-control" />
                        <span asp-validation-for="Address2" class="text-danger"></span>
                    </div>
                    <div class="col-lg-3 col-sm-3 col-3 mt-2"
                         style="padding-bottom:10px; margin-left:10px;">
                        <label>Logo</label>
                        <input type="file" style="width:210px;" asp-for="ProfileImage" multiple="multiple" class="form-control" accept="image/png, image/gif, image/jpeg, application/pdf" />
                    </div><br />

                    @*  <div class="col-lg-3 col-sm-3 col-3 mt-2">
                     <label asp-for="ProfileImage" class="control-label"></label>
                     <input type="file" accept=".png,.jpg,.jpeg" />
                     <span asp-validation-for="ProfileImage" class="text-danger"></span>
                     </div> *@

                </div>
                <div class="form-group mt-2 col-md-3 col-3">
                    <div class="form-check">
                        <input type="checkbox" asp-for="EnglishLetterHead" class="form-check-input" />
                        <label asp-for="EnglishLetterHead" class="form-check-label"></label>
                    </div>
                    <span asp-validation-for="EnglishLetterHead" class="text-danger"></span>
                </div>

                <div class="form-group mt-2  d-flex gap-4 justify-content-end ">

                    <button class="btn btn-success btn-sm text-white" type="submit">
                        <i class="fa fa-save"></i>
                        सुरक्षित गर्नुहोस्
                    </button>

                    <a asp-action="MainSetting" asp-controller="mainsetting" class="btn  btn-sm text-white" style=" background-color:#424f63;">
                        <i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
                    </a>



                </div>



            </form>
        </div>
    </div>
</div>

<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $('#StateId').change(function () {
            debugger;
            $.ajax({
                url: '@Url.Action("GetDistrictByStateId", "Ajax", new { area = "" })',
                type: 'GET',
                data: { id: $(this).val() },
                success: function (data) {
                    $('#PalikaId').empty().append("<option value=''>-न.पा/ग.पा छान्नुहोस्-</option>");
                    $('#DistrictId').empty().append("<option value=''>-जिल्ला छान्नुहोस्-</option>");
                    $.each(data, function (index, item) {
                        debugger
                        $('#DistrictId').append(`<option value="${item.Value}">${item.Text} </option>`);
                    });
                },
                error: function () {
                    alert('error in calling ajax !!');
                }
            });
        });

        $('#DistrictId').change(function () {
            $.ajax({
                url: '@Url.Action("GetPalikaByDistId", "Ajax", new { area = "" })',
                type: 'GET',
                data: { id: $(this).val() },
                success: function (data) {
                    $('#PalikaId').empty().append("<option value=''>-न.पा/ग.पा छान्नुहोस्-</option>");
                    $.each(data, function (index, item) {
                        $('#PalikaId').append(`<option value="${item.Value}">${item.Text}</option>`);
                    });
                },
                error: function () {
                    alert('error in calling ajax !!');
                }
            });
        });
    </script>
}
