@{
    // Check if we are in export mode
    var isExport = ViewData["IsExport"] != null && (bool)ViewData["IsExport"];
}
<!DOCTYPE html>
<html dir="ltr" lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Tell the browser to be responsive to screen width -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="keywords"
          content="योजना व्यवस्थापन प्रणाली" />
    <meta name="description"
          content="योजना व्यवस्थापन प्रणाली" />
    <meta name="robots" content="noindex,nofollow" />
    <title>योजना व्यवस्थापन प्रणाली</title>
    <partial name="_AllCssFile" />
</head>

<body>

    <div class="preloader">
        <div class="lds-ripple">
            <div class="lds-pos"></div>
            <div class="lds-pos"></div>
        </div>
    </div>

    <div id="main-wrapper"
         data-layout="vertical"
         data-navbarbg="skin5"
         data-sidebartype="full"
         data-sidebar-position="absolute"
         data-header-position="absolute"
         data-boxed-layout="full">

        <partial name="_Header" />

        <partial name="_SideMenuBar" />


        <div class="page-wrapper">
            <h1>@(!isExport ? "योजना व्यवस्थापन प्रणाली" : "")</h1>

            @RenderBody()

            <footer class="footer text-center">
                All Rights Reserved by Softech Foundation.

            </footer>

        </div>

    </div>
    <partial name="_AllScriptFile" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
