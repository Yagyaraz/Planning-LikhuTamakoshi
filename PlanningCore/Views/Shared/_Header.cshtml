@using Microsoft.AspNetCore.Identity
@using PlanningCore.Security
@using PlanningCore.Data
@using PlanningCore.Utilities
@using System.Security.Claims
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IUtility _Utility;
@{
    var headerData = await _Utility.GetHeaderData();
    var fiscalyear = await _Utility.GetCurrentFiscalYearName();
}
<header class="topbar" data-navbarbg="skin5">
    <nav class="navbar top-navbar navbar-expand-md navbar-dark">
        <div class="navbar-header" data-logobg="skin5">
            <a class="navbar-brand" asp-action="Index" asp-controller="Home" asp-area="">
                <b class="logo-icon ps-2">
                    <img src="~/template/assets/images/logo-icon.png"
                         alt="homepage"
                         class="light-logo"
                         width="25" />
                </b>
                <span class="logo-text ms-2">
                    योजना व्यवस्थापन प्रणाली
                </span>
            </a>

            <a class="nav-toggler waves-effect waves-light d-block d-md-none"
               href="javascript:void(0)">
                <i class="ti-menu ti-close"></i>
            </a>
        </div>

        <div class="navbar-collapse collapse"
             id="navbarSupportedContent"
             data-navbarbg="skin5">

            <ul class="navbar-nav float-start me-auto">
                <li class="nav-item d-none d-lg-block">
                    <a class="nav-link sidebartoggler waves-effect waves-light"
                       href="javascript:void(0)"
                       data-sidebartype="mini-sidebar">
                        <i class="mdi mdi-menu font-24"></i>
                    </a>
                </li>

                <li class="nav-item dropdown" style="font-size: 1.09375rem;color:#fff;display:inline-flex;align-items:center">
                    @headerData.PalikaName <br /> @headerData.Name @headerData.StateName   @headerData.DistrictName &nbsp; आ.ब @fiscalyear
                </li>

                <li class="nav-item search-box">
                </li>
            </ul>

            <ul class="navbar-nav float-end">
                <li class="nav-item dropdown">
                    <span style="color:white;font-weight:bold;">
                        <b>Hello @User.FindFirstValue("FullName") !</b> <br />
                        <u>@User.FindFirstValue("Post")</u>
                    </span>
                    <a class="nav-link dropdown-toggle text-muted waves-effect waves-dark pro-pic "
                       href="#"
                       id="navbarDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        <img src="~/template/assets/images/users/1.jpg"
                             alt="user"
                             class="rounded-circle"
                             width="31" />
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end user-dd animated"
                        aria-labelledby="navbarDropdown">
                        @if (User.IsInRole("Administrator") || User.IsInRole("SuperAdmin"))
                        {
                            <a class="dropdown-item" asp-area="Admin" asp-controller="UserRoles" asp-action="UserList"><i class="mdi mdi-email me-1 ms-1"></i> प्रयोगकर्ता सुची</a>
                        }
                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="mdi mdi-lock me-1 ms-1"></i>  खाता व्यवस्थापन गर्नुहोस्</a>
                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/ChangePassword"><i class="mdi mdi-lock me-1 ms-1"></i> पासवर्ड परिवर्तन गर्नुहोस्</a>
                        <a class="dropdown-item" href="javascript:void(0)">                            
                            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0"><i class="fa fa-power-off me-1 ms-1"></i> Logout</button>
                            </form>
                        </a>

                    </ul>
                </li>
                <!-- ============================================================== -->
                <!-- User profile and search -->
                <!-- ============================================================== -->
            </ul>
        </div>
    </nav>
</header>