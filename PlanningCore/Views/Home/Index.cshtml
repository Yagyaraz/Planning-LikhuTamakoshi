@model DashboardViewModel
@using PlanningCore.Utilities;
@inject IUtility _utility;
@{
	ViewData["Title"] = "Home Page";
	string[] css = { "bg-midnight-bloom", "bg-arielle-smile", "bg-grow-early" };

}
<style>
	.highcharts-figure,
	.highcharts-data-table table {
		min-width: 320px;
		max-width: 660px;
		margin: 1em auto;
	}

	.highcharts-data-table table {
		font-family: Verdana, sans-serif;
		border-collapse: collapse;
		border: 1px solid #ebebeb;
		margin: 10px auto;
		text-align: center;
		width: 100%;
		max-width: 500px;
	}

	.highcharts-data-table caption {
		padding: 1em 0;
		font-size: 1.2em;
		color: #555;
	}

	.highcharts-data-table th {
		font-weight: 600;
		padding: 0.5em;
	}

	.highcharts-data-table td,
	.highcharts-data-table th,
	.highcharts-data-table caption {
		padding: 0.5em;
	}

	.highcharts-data-table thead tr,
	.highcharts-data-table tr:nth-child(even) {
		background: #f8f8f8;
	}

	.highcharts-data-table tr:hover {
		background: #f1f7ff;
	}

	.highcharts-credits {
		display: none !important;
	}

	.container {
		display: flex;
		justify-content: space-between;
		gap: 1rem; /* Space between the components */
		margin-top: 2rem;
		padding-left: 27px;
	}

	.box {
		border: 1px solid black;
		padding-left: 12px;
		position: relative;
		height: 3.6rem;
		border-radius: 0.5rem;
		box-shadow: 0 4px 8px rgba(59, 156, 225, 0.99);
		background-color: #cde0ee;
		flex-shrink: 0; /* Prevent shrinking */
		width: 15.6rem; /* Adjust the width as needed */
	}

	.title {
		position: absolute;
		left: 3rem;
		top: 0;
		width: 9rem;
		height: 3rem;
		background-color: #1774d2;
		color: white;
		font-size: 0.875rem;
		border: 1px solid black;
		transform: translate(-50%, -50%);
		border-radius: 1.375rem;
		padding-left: 1rem;
		padding-top: 0.25rem;
	}

	.count-container {
		border-radius: 50%;
		width: 3.0rem;
		height: 3.0rem;
		background-color: rgba(211, 211, 211, 0.5);
		border: 1px solid black;
		display: flex;
		justify-content: center;
		align-items: center;
		margin-left: 8rem; /* Adjust as needed */
		margin-top: -0.4rem;
	}

	.count {
		display: flex;
		justify-content: center;
		align-items: center;
		font-weight: bold;
	}

</style>

<div class="page-breadcrumb">
	<div class="row">
		<div class="col-12 d-flex no-block align-items-center">
			<h4 class="page-title"></h4>
			<div class="ms-auto text-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="#">गृह पृष्ट</a></li>
						<li class="breadcrumb-item active" aria-current="page">

						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>
@if (User.IsInRole("Admin") || User.IsInRole("User"))
{
	@foreach (var item in Model.list)
	{
		<div class="container">
			<div class="box">
				<div class="title"> कुल योजना</div>
				<div class="count-container">
					<span class="count">@item.TotalYojana</span>
				</div>
			</div>
			<div class="box">
				<div class="title">सम्झौता भएको योजना</div>
				<div class="count-container">
					<span class="count">@item.TotalSamjhauta</span>
				</div>
			</div>
			<div class="box">
				<div class="title">सम्झौता नभएको योजना</div>
				<div class="count-container">
					<span class="count">@item.NonSamjhauta</span>
				</div>
			</div>
			<div class="box">
				<div class="title">जम्मा उपभोक्ता समिति</div>
				<div class="count-container">
					<span class="count">@item.TotalSamiti</span>
				</div>
			</div>
		</div>
	}


	<div class="row mt-2">
		<div class="col-md-12 col-lg-12">
			<div class="mb-3 card">
				<div class="card-box height-50-p pd-10">
					<figure class="highcharts-figure">
						<div id="pieChart"></div>
					</figure>
				</div>
			</div>
		</div>
	</div>
