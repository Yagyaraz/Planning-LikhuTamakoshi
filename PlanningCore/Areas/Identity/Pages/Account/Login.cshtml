@page
@model LoginModel
@using PlanningCore.Utilities
@inject IUtility _Utility
@{
    Layout = null;
    ViewData["Title"] = "Log in";
    var headerData = await _Utility.GetHeaderData();
}
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta name="description" content="">
<meta name="author" content="">
<link href="~/Login/css/bootstrap.min.css" rel="stylesheet">
<link href="~/Login/css/font-awesome.min.css" rel="stylesheet">
<link href="~/Login/css/style.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<section class="form-02-main">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="_lk_de">
                    <div class="form-03-main row ">
                        <div class="col-md-12 col-12 d-flex justify-content-center">
                            <div class="logo">
                                <img src="~/Login/images/user.png">                              
                            </div>
                        </div>
                        <div class="col-md-12 col-12 d-flex justify-content-center" style="font-weight:bold">
                            @headerData.PalikaName
                            योजना व्यवस्थापन प्रणालि
                        </div>

                        <form method="post" class="mt-3" id="loginform" autocomplete="off">
                            <div class="form-group">
                                @*  <div class="form-group py-2"> *@
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user-circle"></i></span>
                                    <input asp-for="Input.Email" type="text" class="form-control form-control-lg"
                                           placeholder="Username"
                                           aria-label="Username"
                                           aria-describedby="basic-addon1"
                                           required />
                                    @* //  </div> *@
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                    <input asp-for="Input.Password" type="password" class="form-control form-control-lg" placeholder="Password" aria-label="Password" aria-describedby="basic-addon1" required />
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>

                                </div>
                            </div>

                            <div class="checkbox form-group">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="remember">
                                    <label class="form-check-label text-muted" for="remember">Remember me</label>
                                    <a href="#" id="forgot" class="font-weight-bold">Forgot password?</a>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="_btn_04" style="background:none">
                                    <div>
                                        <button type="submit" class="btn btn-primary btn-block">Login</button>
                                    </div>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(".preloader").fadeOut();

        $("#to-recover").on("click", function () {
            $("#loginform").slideUp();
            $("#recoverform").fadeIn();
        });
        $("#to-login").click(function () {
            $("#recoverform").hide();
            $("#loginform").fadeIn();
        });
    </script>
}
