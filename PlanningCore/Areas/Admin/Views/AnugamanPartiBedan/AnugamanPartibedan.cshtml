@model AnugamanPartibedanViewModel
@inject IUtility _Utility
@{
    ViewData["Title"] = "AnugamanPartibedan Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .page {
        background: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        margin: auto;
    }

    .header {
        text-align: center;
        margin-bottom: 20px;
    }

        .header p {
            margin: 3px;
            font-size: 16px;
        }

    .title {
        text-align: center;
        margin-top: 15px;
    }

        .title u {
            font-size: 18px;
            font-weight: bold;
        }

    .content {
        margin-top: 20px;
        line-height: 1.7;
        font-size: 16px;
        text-align: justify;
    }

    .big-box {
        min-height: 150px;
        width: 100%;
        border: 1px solid #ccc;
        padding: 5px;
        border-radius: 5px;
    }
</style>
<div class="d-flex justify-content-end">
    <button class="btn btn-primary mt-5" type="button" onClick="Print('contentToPrint')"><i class="fa fa-print" aria-hidden="true"></i> Print</button>
</div>
<div class="row" id="contentToPrint">
    <style>
        .page {
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            margin: auto;
        }

        .header {
            text-align: center;
            margin-bottom: 20px;
        }

            .header p {
                margin: 3px;
                font-size: 16px;
            }

        .title {
            text-align: center;
            margin-top: 15px;
        }

            .title u {
                font-size: 18px;
                font-weight: bold;
            }

        .content {
            margin-top: 20px;
            line-height: 1.7;
            font-size: 16px;
            text-align: justify;
        }

        .big-box {
            min-height: 150px;
            width: 100%;
            border: 1px solid #ccc;
            padding: 5px;
            border-radius: 5px;
        }

        .image {
            max-width: 100%;
            height: auto;
            border: 1px solid #ccc;
            border-radius: 5px;
        }


            @@media print {
            
            .big-box{
                border: none;
            }

            .page {
                box-shadow: none;
            }

            .image{
                border: none
            }
        }
    </style>

    <div class="col-md-12 col-12 page">
        <div class="col-md-12 col-12 header">
            <p>अनुसूची १</p>
            <p>(कार्यविधिको परिच्छेद ४ को दफा ६ संग संबन्धित)</p>
            <p>नगरपालिका स्तरीय योजना अनुगमन तथा सुपरिवेक्षण प्रतिबेदन</p>
        </div>

        <div class="col-md-12 col-12 title ">
            <p><b><u>बिषय:- योजना अनुगमन सम्बन्धमा |</u></b></p>
        </div>

        <div class="col-md-12 col-12 content">
            <p>
                प्रस्तुत विषयमा यस नगरपालिकाको स्वीकृत वार्षिक नीति तथा कार्यक्रम र बजेट अन्तर्गत आ.व. @Model.PlanningSamjhauta.FiscalYearName मा संचालित तपशिल बमोजिमका योजनाहरुको कार्य सम्पन्न गरी भुक्तानीको लागि अनुरोध भई आएकोमा सो योजना नगरपालिका स्तरीय योजना अनुगमन तथा सुपरिवेक्षण समितिवाट मिति @Model.ParikxanDate गते स्थलगत अनुगमन गर्दा उक्त योजनाको कार्य @Model.SampannaType तरिकाले सम्पन्न/आंशिक सम्पन्न भएको देखिएकोले विनियोजित रकम सबै रनिङ विल वमोजिमको रकम रु.@Model.BillRakam भुक्तानी गर्नु होला ।
            </p>
        </div>

        <div class="content">
            <h3><u>योजना सम्बन्धि विवरण</u></h3>
            <p>१. योजनाको नाम: @Model.PlanningSamjhauta.YojanaNames </p>
            <p>२. योजना कार्यान्वयन स्थल: @Model.PlanningSamjhauta.YojanaAddress </p>

            <p><b>३. उपभोक्ता समितिको पदाधिकारीहरुको विवरण:</b></p>
            @foreach (var item in Model.PlanningSamjhauta.samitiView.samitiMemberDetaillist.Where(x => x.SamitiPostId == 1))
            {
                <p>क) अध्यक्ष: @item.MemberName सम्पर्क नं:@item.PhoneNo </p>
            }
            @foreach (var item in Model.PlanningSamjhauta.samitiView.samitiMemberDetaillist.Where(x => x.SamitiPostId == 3))
            {
                <p>ख) सचिव: @item.MemberName सम्पर्क नं:@item.PhoneNo </p>
            }
            @foreach (var item in Model.PlanningSamjhauta.samitiView.samitiMemberDetaillist.Where(x => x.SamitiPostId == 2))
            {
                <p>ग) कोषाध्यक्ष: @item.MemberName सम्पर्क नं:@item.PhoneNo </p>
            }

            <p><b>४. योजनाको लागत सम्बन्धि विवरण:</b></p>
            <p>क) लागत अनुमान रु:@Model.PlanningSamjhauta.Total_Amount_Source ..</p>
            <p>ख) लागत व्योरेका स्रोतहरु:</p>
            <ul>
                <li>१) गाउँपालिकाबाट रु: @Model.PlanningSamjhauta.Municipality</li>
                <li>२) अन्य @Model.PlanningSamjhauta.Other_Source </li>
                <li>३) गैरसरकारी संघ संस्थाबाट रु: @Model.PlanningSamjhauta.NGO_INGO </li>
                <li>४) समुदायमा आधारित संस्थाबाट रु: @Model.PlanningSamjhauta.Community </li>
                <li>५) उपभोक्ता समिति / टोल विकास संस्थाबाट रु: @Model.PlanningSamjhauta.Public_Community </li>
                <li>६) अन्यबाट रु: @Model.PlanningSamjhauta.Other_Source</li>
                <li>७) जम्मा रु: @Model.PlanningSamjhauta.Total_Amount_Source</li>
            </ul>
            <p><b>५. योजना सम्पन्न मिति:</b> @Model.PlanningSamjhauta.Project_End_Date</p>
            <p><b>६. योजना सम्पन्न गर्ने मिति:</b> @Model.PlanningSamjhauta.Project_End_Date</p>

            <p><b>७. योजना छनौट बारेमा आम भेलामा छरपस्ट भई निर्णय भएको हो?<br /></b> @((Model.IsNirnayaBhayako) ? "हो" : "होइन")</p>
            <p><b>८. उपभोक्ताहरुमा योजनाबाट छरिएको सन्दर्भमा कुनै विवाद छ?<br /></b> @((Model.IsBibad) ? "छ" : "छैन")</p>
            <p><b>९. योजनामा अन्य कुनै विवाद रहेको वा गम्भीर विवादका सम्भावनाहरु छन्?<br /></b> @((Model.IsGambirBibad) ? "छ" : "छैन")</p>
            <p>यदि छ भने विवादको किसिम, विवाद हुनाको कारणहरु तथा समाधानका उपायहरुः-</p>
            <div  >@Model.BibadDetails</div><br />

            <p>१०. कुनै विवाद, बाह्य जोखिमहरु जस्तै भूक्षय तथा अन्य तत्वहरुको कारणले रेखाइन उपयुक्त हुन नसकेको भए सुधारका विकल्पहरु तथा उपायहरु उल्लेख गर्नुहोस । साथै सडकको दायाँ बायाँ भू-भाग संरक्षण गर्न के तरिका अपनाईएको छ ?</p>
            <div  >@Model.BahiyaJokhim</div><br />

            <p>११. उपभोक्ता समितिका पदाधिकारीहरु योजनाको सन्दर्भमा आफ्नो भुमिका र जिम्मेवारीको बारेमा जानकार छन् ?<br /> @((Model.IsJimmewari) ? "छन्" : "छैनन्")</p>
            <p>यदि छैनन् भने किन छैनन्, पदाधिकारी कुन विषयमा जानकार छैनन् ? जानकार नहुनका कारणहरु तथा समाधानका उपायहरुः-</p>
            <div  >@Model.JimmwariDetails</div><br />

            <p>१२. बैंक खाता खोलिएको छ, छैन ? @((Model.IsBankAccountOppen) ? "छ" : "छैन")</p>
            <p>यदि छैन भने खाता नखोलिनुको कारणहरु उल्लेख गर्नुहोस् र खात खोल्ने सम्भावित समय समेत उल्लेख गर्नुहोस् ।</p>
            <div  >@Model.BankAcocuntDetail</div>

            <p>यदि खोलिएको छ भने खाताको विवरण उल्लेख गर्नुहोस् ।</p>
            <table class="border table table-bordered" style="text-align:center; width:100% !important;page-break-inside: avoid !important;">
                <tr style="border: 1px solid black !important;page-break-inside: avoid !important;">
                    <th style="border: 1px solid black !important;">क्र.स.</th>
                    <th style="border: 1px solid black !important;">बैंकको नाम</th>
                    <th style="border: 1px solid black !important;">बैंक रहेको स्थान</th>
                    <th style="border: 1px solid black !important;">खाता नं.</th>
                    <th style="border: 1px solid black !important;">खाताको किसिम</th>
                    <th style="border: 1px solid black !important;">कैफियत</th>
                </tr>
                <tr style="page-break-inside:avoid;">
                    <td>१</td>
                    <td>@Model.BankName</td>
                    <td>@Model.BankAddress</td>
                    <td>@Model.AccountNumber</td>
                    <td>@Model.AccountType</td>
                    <td>@Model.AccountRemarks</td>
                </tr>
            </table>

            <p><b>खाता संचालकहरुको नाम तथा पद </b></p>
            <table class="border table table-bordered" style="text-align:center; width:100% !important;page-break-inside: avoid !important;">
                <tr style="border: 1px solid black !important;page-break-inside: avoid !important;">
                    <th style="border: 1px solid black !important;">क्र.स.</th>
                    <th style="border: 1px solid black !important;">नाम थर</th>
                    <th style="border: 1px solid black !important;">लिङ्ग</th>
                    <th style="border: 1px solid black !important;">पद</th>
                    <th style="border: 1px solid black !important;">कैफियत</th>
                </tr>
                <tr style="page-break-inside:avoid;">
                    <td>१</td>
                    <td>@Model.KhataSanchalak1Name</td>
                    <td>@Model.KhataSanchalak1Gender</td>
                    <td>@Model.KhataSanchalak1Post</td>
                    <td>@Model.KhataSanchalak1Remarks</td>
                </tr>
                <tr style="page-break-inside:avoid;">
                    <td>२</td>
                    <td>@Model.KhataSanchalak2Name</td>
                    <td>@Model.KhataSanchalak2Gender</td>
                    <td>@Model.KhataSanchalak2Post</td>
                    <td>@Model.KhataSanchalak2Remarks</td>
                </tr>
                <tr style="page-break-inside:avoid;">
                    <td>३</td>
                    <td>@Model.KhataSanchalak3Name</td>
                    <td>@Model.KhataSanchalak3Gender</td>
                    <td>@Model.KhataSanchalak3Post</td>
                    <td>@Model.KhataSanchalak3Remarks</td>
                </tr>
            </table>

            <p>१३. यस योजनाबाट प्रत्यक्ष रुपमा महिला तथा वज्चितिकरणमा परेका समुहको घरधुरीहरुले प्रत्यक्ष फाइदा पाएका छन् ? @((Model.PratakshyaFaida) ? "छन्" : "छैनन्")</p>
            <p>यदि पाएका छन् भने कति घरधुरीले पाएका छन्: @Model.GharDhuri</p>
            <div  >@Model.PratakshyaFaidaDetails</div>

            <p>१४. योजनाको सूचना पाटी उपयुक्त स्थानमा राखिएको छ ? <br />@((Model.IsSuchanaPati) ? "छ" : "छैन")</p>
            <p>१५. आमभेला मार्फत सार्वजनिक परीक्षण गरिएको छ ?<br /> @((Model.IsAambhela) ? "छ" : "छैन")</p>
            <p>१६. प्राविधिक साइट इन्चार्जको नाम: @Model.EngineerName</p>
            <p>१७. भुक्तानीको लागि सिफारिस रकम रु. @Model.BhuktaniSifarishRakam</p>
            <p>१८. कार्यान्वयनमा देखिएका समस्याहरु:</p>
            <div  >@Model.KaryanayanDetails</div><br />
            <p>१९. समस्या समाधान गर्न अपनाइएका उपायहरु:</p>
            <div >@Model.SamasyaSamadhanUpaya</div><br />
            <p>२०. अनुगमन विवरण:</p>
            <div>@Model.AnugamanBibaran</div><br />

            <p>योजना अनुगमन तथा सुपरिवेक्षण समितिका पदाधिकारीहरुः-</p>
            <table style="width:100% !important" class="table table-bordered;page-break-inside: avoid !important;">
                <thead>
                    <tr style="page-break-inside:avoid;">
                        <th>क्र.स.</th>
                        <th>अनुगमन कर्ताको पद</th>
                        <th>नाम थर</th>
                        <th>दस्तखत</th>
                        <th>कैफियत</th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="page-break-inside:avoid;">
                        <td>१.</td>
                        <td>@Model.AnugamanKarta1Post</td>
                        <td>@Model.AnugamanKarta1Name</td>
                        <td></td>
                        <td>@Model.AnugamanKarta1Remarks</td>
                    </tr>
                    <tr style="page-break-inside:avoid;">
                        <td>२.</td>
                        <td>@Model.AnugamanKarta2Post</td>
                        <td>@Model.AnugamanKarta2Name</td>
                        <td></td>
                        <td>@Model.AnugamanKarta2Remarks</td>
                    </tr>
                    <tr style="page-break-inside:avoid;">
                        <td>३.</td>
                        <td>@Model.AnugamanKarta3Post</td>
                        <td>@Model.AnugamanKarta3Name</td>
                        <td></td>
                        <td>@Model.AnugamanKarta3Remarks</td>
                    </tr>
                    <tr style="page-break-inside:avoid;">
                        <td>४.</td>
                        <td>@Model.AnugamanKarta4Post</td>
                        <td>@Model.AnugamanKarta4Name</td>
                        <td></td>
                        <td>@Model.AnugamanKarta4Remarks</td>
                    </tr>
                    <tr style="page-break-inside:avoid;">
                        <td>५.</td>
                        <td>@Model.AnugamanKarta5Post</td>
                        <td>@Model.AnugamanKarta5Name</td>
                        <td></td>
                        <td>@Model.AnugamanKarta5Remarks</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <style>
            .photo-page {
                background: #fff;
                padding: 30px;
                border-radius: 12px;
                box-shadow: 0 0 10px rgba(0,0,0,0.1);
            }

            .photo-item {
                margin-bottom: 25px;
            }

            .photo-title {
                font-size: 18px;
                font-weight: 600;
                margin-bottom: 8px;
                border-left: 5px solid #007bff;
                padding-left: 10px;
            }

            .photo-img {
                width: 100%;
                max-height: 350px;
                object-fit: contain;
                border: 1px solid #ddd;
                border-radius: 8px;
                padding: 10px;
                background: #f8f8f8;
            }
        </style>

        <div class="photo-page" style="page-break-before:always;">

            <div class="photo-item">
                <p class="photo-title">योजना संचालन पूर्व अनुगमन गरिएको फोटो:</p>
                <img src="@Model.BeforePhotos" class="photo-img" alt="पूर्व अनुगमन" />
            </div>

            <div class="photo-item">
                <p class="photo-title">योजना संचालन भईरहदाँ अनुगमन गरिएको फोटो:</p>
                <img src="@Model.AfterPhotos" class="photo-img" alt="अनुगमन" />
            </div>

            <div class="photo-item" style="page-break-before:always;">
                <p class="photo-title">योजना सम्पन्न पश्चात अनुगमन गरिएको फोटो:</p>
                <img src="@Model.BetweenPhotos" class="photo-img" alt="पश्चात" />
            </div>

        </div>

    </div>

</div>
@section Scripts
{
    <script type="text/javascript">
        //$(function () {
        //    $('.currentdate').html(GetNepaliCurrentDate());
        //});
        function Print() {
            var elementHTML = document.getElementById('contentToPrint').innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = elementHTML;
            window.print();
            //document.body.innerHTML = oldPage;
            window.location.reload(true);
        }
    </script>
    }