        margin-top: 10px;
    }


    .button {
        width: 100%;
        text-align: center;
        border: 2px solid #007bff;
        padding: 10px;
        box-sizing: border-box;
        cursor: pointer;
    }


        .button img {
            max-width: 100%;
            height: auto;
        }


            .button img[src^="https://via.placeholder.com/"] {
            }


        .button:hover {
            background-color: #007bff;
            color: #fff;
        }

            .button:hover a {
                color: #fff;
