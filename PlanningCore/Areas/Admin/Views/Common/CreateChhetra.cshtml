@model ChettraViewModel
@inject IUtility _Utility
@{
	ViewData["Title"] = "Index";
	<style>
		.page-title {
			color: red;
		
		}

		.card-title {
			color: red;
		}

		.oval-button {
			border-radius: 25px;
		}
	</style>
	
}

<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

<div class="page-breadcrumb colr1">
	<div class="row">
		<div class="col-12 d-flex no-block align-items-center">
			<div style="display:flex;">
				<h4 class="card1" style="background-color:#3c8dbc; color:#fff; height:40px; width:150px; padding-top:5px; text-align:center;">क्षेत्र सम्बन्धि विवरण :</h4>
				<span style="height:2rem; background-color:#3c8dbc; width:10px; height:40px;"></span>
				<span style="height: 2rem; border-top: 17px solid transparent;border-left: 25px solid #3c8dbc;border-bottom: 22px solid transparent; height:40px;"> </span>
			</div>
			<div class="ms-auto text-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="#">गृह पृष्ट</a></li>
						<li class="breadcrumb-item active" aria-current="page">
							क्षेत्र सम्बन्धि विवरण :
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid colr1">
	<div class="row">
		<form asp-action="CreateChhetra" method="post">
			@Html.HiddenFor(model => model.ChettraId)
			<div class="col-md-12">
				<div class="card">
					<div class="card-body row">					
						<div class="form-group mt-3 col-md-4 col-4 ">
							<label asp-for="ChettraName" style=" font-size:14px;" ></label>
							<input type="text" asp-for="ChettraName" class="form-control  border-dark" style="width:250px;">
							<span asp-validation-for="ChettraName" class="text-danger"></span>
						</div>
						<div class="offset-9 mb-4" style="float:right; ">
							<button type="submit" class="btn btn-sm btn-success text-white ">
								<i class=" fas fa-save">  </i>
								सुरक्षित गर्नुहोस
							</button>

							<a asp-action="ChhetraIndex" asp-controller="Common" asp-area="Admin" class="btn  btn-sm  text-white"
							   style=" background-color:#424f63;">
								<i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
							</a>
						</div>
					</div>
				</div>
			</div>
		</form>
	
	</div>
</div>
