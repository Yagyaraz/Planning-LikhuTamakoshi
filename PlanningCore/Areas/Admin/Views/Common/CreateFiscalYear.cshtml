@model FiscalYearViewModel
@inject IUtility _Utility
@{
    ViewData["Title"] = "Index";
}
<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />
<div class="page-breadcrumb ">
    <div class="row">
        <div class="col-12 d-flex no-block align-items-center">
            <div style="display:flex;">
                <h4 class="card1" style="background-color:#3c8dbc; color:#fff; height:40px; width:100px; padding-top:5px; text-align:center;">आर्थिक वर्ष </h4>
                <span style="height:2rem; background-color:#3c8dbc; width:10px; height:40px;"></span>
                <span style="height: 2rem; border-top: 17px solid transparent;border-left: 25px solid #3c8dbc;border-bottom: 22px solid transparent; height:40px;"> </span>
            </div>
            <div class="ms-auto text-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="#">गृह पृष्ट</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            आर्थिक वर्ष
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <form asp-action="CreateFiscalYear" method="post">
        @Html.HiddenFor(model => model.Id)

        <div class="card row">
            <div class="card-body row">
                <h5 class="card-title"> नया आर्थिक वर्ष थप्नुहोस</h5>
                
                <div class="d-flex gap-5">

                    <div class="form-group mt-2 col-md-3 col-3 ">
                        <label asp-for="Name"> </label>
                        <input type="text" asp-for="Name" placeholder="Name" class="form-control"required >
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>



                    <div class="form-group mt-2 col-md-3 col-3 ">
                        <label asp-for="DateFrom"> </label>
                        <input type="text" asp-for="DateFrom" placeholder="Name" class="form-control">
                        <input type="datetime" asp-for="DateFromEng" placeholder="Name" class="form-control" hidden>
                    </div>



                    <div class="form-group mt-2 col-md-3 col-3 ">
                        <label asp-for="DateTo"> </label>
                        <input type="text" asp-for="DateTo" placeholder="Name" class="form-control">
                        <input type="datetime" asp-for="DateToEng" placeholder="Name" class="form-control" hidden>
                    </div>



                    <div class="form-group mt-4 col-md-1 col-1 d-flex justify-content-center align-items-center gap-3 ">
                        <label class="d-flex justify-content-center align-items-center gap-1 mt-2">
                            IsActive
                            <input type="checkbox" asp-for="IsActive" />
                        </label>                  
                    </div>      
            </div>                    
        </div>


     <div class="offset-9 mb-4" style="float:right;">
        <button type="submit" class="btn btn-success text-white btn-sm">
            <i class=" fas fa-save">  </i>
            सुरक्षित गर्नुहोस
        </button>


                <a asp-action="FiscalYearIndex" asp-controller="Common" asp-area="Admin" class="btn  btn-sm  text-white"
                   style=" background-color:#424f63;">
                    <i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
                </a>

    </div>
  </form>
</div>
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");

        }
        <script>
            $("#zero_config").DataTable();
        </script>
        <script>
            NepaliDatePickerCalWithAdDateConverter(document.getElementById('DateFrom'), document.getElementById('DateFromEng'))
            NepaliDatePickerCalWithAdDateConverter(document.getElementById('DateTo'), document.getElementById('DateToEng'))
            // NepaliDatePickerCalWithAdDateWithDisableNextDateForModal(document.getElementById('DateFrom'), document.getElementById('DateFromEng'))
            // NepaliDatePickerCalWithAdDateWithDisableNextDateForModal(document.getElementById('DateTo'), document.getElementById('DateToEng'))
        </script>
    }

