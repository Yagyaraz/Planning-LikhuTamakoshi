@model IEnumerable<BankViewModel>
@inject IUtility _Utility
@{
    ViewData["Title"] = "BankIndex";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .table thead {
        background-color: #ccd1d9;
        font-size: 13px;
        line-height: 35px !important;
    }

        .table thead th {
            font-weight: 800;
            border: 1px solid black !important;
            padding: 0px !important;
        }

    .table tbody td {
        padding: 0px !important;
        border: 1px solid black !important;
        vertical-align: middle;
    }

    .table tbody tr {
        text-align: center;
        font-size: 12px;
        height: 27px !important;
    }

    table.table-bordered.dataTable td {
        padding: 0px;
    }

    table.table-bordered.dataTable th {
        padding: 0px;
    }

    tr:nth-child(even) {
        background-color: #e9ecef;
    }

    tr:hover {
        background-color: #b3ffe6;
    }
</style>
<div class="page-breadcrumb colr1">
    <div class="row">
        <div class="col-12 d-flex no-block align-items-center">
            <div class="ms-auto text-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="#">गृह पृष्ट</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            बैंक सेटअप
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid colr1">
    <div class="row">
        <div class="col-md-12">
            <div style="display:flex; justify-content:space-between;">
                <div style="display:flex;">
                    <h4 class="card1" style="background-color:#3c8dbc; color:#fff; height:40px; width:100px; padding-top:5px; text-align:center;">कागजात</h4>
                    <span style="height:2rem; background-color:#3c8dbc; width:10px; height:40px;"></span>
                    <span style="height: 2rem; border-top: 17px solid transparent;border-left: 25px solid #3c8dbc;border-bottom: 22px solid transparent; height:40px;"> </span>
                </div>
                <div style="display:flex; gap:20px;">
                    <a asp-controller="Common" asp-action="CreateBank" asp-area="Admin" class="btn btn-sm d-flex justify-content-center align-items-center fw-bold text-white"
                       style="height:2rem; background-color:#33b35a; border:1px solid #3ec291; ">
                        <i class="fas fa-plus-circle">  </i>
                        <span style="padding-left:3px;"> नँया बैंक थप्नुहोस </span>
                    </a>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="zero_config"
                               class="table  table-bordered" style="border-collapse: collapse!important;">
                            <thead>
                                <tr>
                                    <th style="text-align:center; width:8%;">सि.न  </th>
                                    <th style="text-align:center;">बैंक  </th>
                                    <th style="text-align:center;">बैंक (Eng)  </th>
                                    <th style="text-align:center;">ठेगाना </th>
                                    <th style="text-align:center;"> कार्य  </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr style="text-align:center;">
                                        <td>@_Utility.ConvertEnglishToNepali(Model.ToList().IndexOf(item) + 1).</td>
                                        <td style="text-align:start;">@Html.DisplayFor(modelItem => item.BankName_Nep)</td>
                                        <td style="text-align:start;">@Html.DisplayFor(modelItem => item.BankName_Eng)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Address)</td>
                                        <td>
                                            <a asp-controller="Common" asp-action="CreateBank" title="Edit" asp-area="Admin" asp-route-id="@item.Id"
                                               class="btn  btn-sm ">
                                                <i class="fa fa-edit" style="font-weight:1; font-size:12px;">
                                                    <span style="color:blue;"> </span>
                                                </i>
                                            </a>
                                            <a asp-action="DeleteBank" title="Remove" asp-route-id="@item.Id" onclick="return confirm('Are you sure?')">
                                                <i class="fa fa-trash" style="color:red; padding-left:3px;">
                                                    <span>  </span>
                                                </i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="d-flex justify-content-end">
                            <a asp-action="Setup" asp-controller="Setup" asp-area="Admin" class="btn  btn-sm mt-3 mb-2 text-white"
                               style=" background-color:#424f63;">
                                <i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $("#zero_config").DataTable();
    </script>
    <script>
        $(function () { Message('@TempData["Msg"]') });
    </script>
}