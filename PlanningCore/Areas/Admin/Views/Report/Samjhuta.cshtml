@model IEnumerable<RepotSamjhutaViewModel>
@inject IUtility _Utility
@{
    ViewData["Title"] = "Samjhuta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .oval-button {
        border-radius: 25px;
    }
</style>

<div class="page-breadcrumb colr1">
    <div class="row">
        <div class="col-12 d-flex no-block align-items-center">
            <div style="display:flex;">
                <h4 class="card1" style="background-color:#3c8dbc; color:#fff; height:40px; width:220px; padding-top:5px; text-align:center;">सम्झौता भएका आयोजनाको सुची</h4>
                <span style="height:2rem; background-color:#3c8dbc; width:10px; height:40px;"></span>
                <span style="height: 2rem; border-top: 17px solid transparent;border-left: 25px solid #3c8dbc;border-bottom: 22px solid transparent; height:40px;"> </span>
            </div>
            <div class="ms-auto text-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            सम्झौता भएका आयोजनाको सुची
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid colr1">
    <div class="row">
        <div class="col-md-12">
            <div class="container">
                <form asp-action="@ViewData["Title"]" method="get">
                    <div class="pt-4 row">
                        <div class="col-2">
                            <label>आर्थिक वर्ष</label>
                            <select name="fiscalYearId" id="fiscalYearId" asp-items="@await _Utility.GetFiscalYearList()" class="form-control">
                                <option value="">--आर्थिक वर्ष छान्नुहोस--</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <label>आयोजनाको नाम</label>
                            <select name="yojanaId" id="yojanaId" asp-items="@await _Utility.GetyojanaList()" class="form-control">
                                <option value="">--आयोजनाको छान्नुहोस--</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <label>बजेट श्रोत</label>
                            <select name="budgetId" id="budgetId" asp-items="@await _Utility.GetBudgetSourceList()" class="form-control">
                                <option value="">--बजेट श्रोत छान्नुहोस--</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <label>वडा</label>
                            <select name="wardId" id="wardId" asp-items="@await _Utility.GetWardList()" class="form-control">
                                <option value="">--वडा छान्नुहोस--</option>
                            </select>
                        </div>

                        <div class="col-2">
                            <label> </label><br />
                            <input type="submit" value="खोज्नुहोस्" class="btn btn-success" />
                        </div>
                    </div>
                </form>
            </div>
            <br />
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="zero_config"
                               class="table table-striped table-bordered">
                            <thead style="background-color: #ccd1d9;">
                                <tr>
                                    <th style="text-align:center; width:5%!important;"><b>क्र.स. </b></th>
                                    <th style="text-align:center;"><b> आर्थिक वर्ष </b></th>
                                    <th style="text-align:center;"><b> बजेट श्रोत </b></th>
                                    <th style="width:600px!important; text-align:center!important;"><b> आयोजनाको नाम </b></th>
                                    <th style="text-align:center;"><b> वडा नम्बर </b></th>
                                    <th style="text-align:center;"><b> आयोजनाको स्थल </b></th>
                                    <th style="text-align:center; width:800px!important;"><b> सम्झौता गर्ने संस्थाको नाम </b></th>
                                    <th style="text-align:center;"><b> सुरु मिति </b></th>
                                    <th style="text-align:center;"><b> सम्पन्न मिति </b></th>
                                    <th style="text-align:center;"><b> विनियोजित रकम </b></th>
                                    <th style="text-align:center;"><b> लागत अनुमान रकम </b></th>
                                    <th style="text-align:center;"><b> कनटिनजेन्सी रकम </b></th>
                                </tr>
                            </thead>
                            <tbody style="background-color:#fff;">
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="text-align:center;">@_Utility.ConvertEnglishToNepali(Model.ToList().IndexOf(item) + 1)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.FiscalName)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.BudgetName)</td>
                                        <td style="text-align:start;">@Html.Raw(item.YojanaName)</td>
                                        <td style="text-align:center;">@Html.Raw(item.WardName)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.YojanaAddress)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.SamitiName)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.StartMiti)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.EndMiti)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.BinyojitRkm)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.LagatRkm)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.LagatRkm)</td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                        <div class=" d-flex justify-content-end">
                            <a asp-action="YojanaDetailsSuchi" asp-controller="Setup" asp-area="Admin" class="btn  btn-sm mt-3 mb-2 me-2 text-white"
                               style=" background-color:#424f63;">
                                <i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <link href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/3.0.2/css/buttons.bootstrap5.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/colreorder/2.0.3/css/colReorder.bootstrap5.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.bootstrap5.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.0.2/js/buttons.colVis.min.js"></script>
    <script src="https://cdn.datatables.net/colreorder/2.0.3/js/dataTables.colReorder.js"></script>
    @* 	<script>
		$("#zero_config").DataTable();
	</script> *@
    <script>
        $('#zero_config').DataTable({
            //colReorder: true,
            //lengthMenu: [5, 10, 50, 100, 500],
            layout: {
                topStart: {
                    buttons: [

                        {
                            extend: 'excelHtml5',
                            exportOptions: {
                                columns: ':visible'
                            }
                        },

                        'colvis',
                        "pageLength"
                    ]
                }
            }
        });
    </script>
    <script>
        // $("#zero_config").DataTable();
        $(document).ready(function () {
            $('#fiscalYearId').val('@ViewBag.fiscalYearId');
            $('#yojanaId').val('@ViewBag.yojanaId');
            $('#budgetId').val('@ViewBag.budgetId');
            $('#wardId').val('@ViewBag.wardId');

            var lengthOfRow = $('table tbody tr').length;
            var tableCells = [6, 8, 9, 10, 11, 12];
            for (var i = 1; i <= lengthOfRow; i++) {
                $.map(tableCells, function (val) {
                    var tableCode = `table tbody tr:nth-child(${i}) td:nth-child(${val})`;
                    $(tableCode).text(englishToNepali($(tableCode).text()));
                });
            }
        });
    </script>

}