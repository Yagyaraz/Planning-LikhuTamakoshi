@model IEnumerable<PlanningSamjhautaViewModel>
@inject IUtility _Utility
@{
	ViewData["Title"] = "Index";
	<style>
		.oval-button {
			border-radius: 25px;
		}

		#zero_config > thead > tr > th {
			font-weight: bold;
		}

		table.table-bordered.dataTable th, table.table-bordered.dataTable td {
			border-left-width: thin;
		}

			table.table-bordered.dataTable th:last-child, table.table-bordered.dataTable th:last-child, table.table-bordered.dataTable td:last-child, table.table-bordered.dataTable td:last-child {
				border-right-width: thin;
			}
	</style>
}

<div class="page-breadcrumb">
	<div class="row">
		<div class="col-12 d-flex no-block align-items-center">
			<h4 class="page-title">योजना सम्झौता</h4>
			<div class="ms-auto text-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
						<li class="breadcrumb-item active" aria-current="page">
							योजना सम्झौता
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid">
	<div class="row">
		<div class="col-md-12">
			<div style="text-align: right;">
				<a asp-controller="Planningsamjhauta" asp-action="Insertplanningsamjhauta" asp-area="Admin" class="btn btn-primary btn-sm oval-button">
					<i class="fas fa-plus-circle">
						नयाँ योजना सम्झौता गर्नुहोस
					</i>
				</a>
			</div>
			<br />
			<div class="card">
				<div class="card-body">


					<div class="table-responsive">
						<table id="zero_config"
							   class="table table-striped table-bordered">
							<thead>
								@{
									int i = 1;
								}
								<tr>
									<th>क्र.स.</th>
									<th>@Html.DisplayNameFor(model => model.FiscalYearName)</th>
									<th>@Html.DisplayNameFor(model => model.WardName)</th>
									<th>@Html.DisplayNameFor(model => model.Samjhauta_Org_Name)</th>
									<th>@Html.DisplayNameFor(model => model.Project_Name)</th>
									<th>@Html.DisplayNameFor(model => model.Project_Place)</th>
									<th>@Html.DisplayNameFor(model => model.Project_Start_Date)</th>
									<th>@Html.DisplayNameFor(model => model.Project_End_Date)</th>
									<th></th>

								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{

									<tr>
										<td>@_Utility.ConvertEnglishToNepali(i)</td>
										<td>@Html.DisplayFor(modelItem => item.FiscalYearName)</td>
										<td>@Html.DisplayFor(modelItem => item.WardName)</td>
										<td>@Html.DisplayFor(modelItem => item.Samjhauta_Org_Name)</td>
										<td>@Html.DisplayFor(modelItem => item.Project_Name)</td>
										<td>@Html.DisplayFor(modelItem => item.Project_Place)</td>
										<td>@Html.DisplayFor(modelItem => item.Project_Start_Date)</td>
										<td>@Html.DisplayFor(modelItem => item.Project_End_Date)</td>
										
									</tr>
									i++;
								}
							</tbody>

						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	<script>
		$("#zero_config").DataTable();
	</script>
}