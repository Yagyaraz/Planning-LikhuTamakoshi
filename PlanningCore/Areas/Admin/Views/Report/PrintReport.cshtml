@model IEnumerable<PrintReportViewModel>
@inject IUtility _Utility


<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari&display=swap" rel="stylesheet">
<style>
	#download {
		display: inline-block;
		padding: 10px 20px;
		font-size: 16px;
		font-weight: bold;
		color: white;
		background-color: #007bff;
		border: none;
		border-radius: 5px;
		cursor: pointer;
		text-align: center;
		text-decoration: none;
		transition: background-color 0.3s ease;
		margin-top: 20px;
		float: right;
		font-family: 'Noto Sans Devanagari', sans-serif;
		line-height: 1.5;
		word-spacing: 0.1em;
		white-space: normal;
	}
</style>
<style>
	/* Apply font and spacing to content */
	#content {
		font-family: 'Noto Sans Devanagari', sans-serif;
		font-size: 16px;
		line-height: 1.8; /* Proper spacing to avoid overlapping */
		white-space: normal;
		margin: 20px;
	}

	h1, p {
		margin: 0 0 10px;
	}
</style>
<div class="container m-2 pt-5 mt-5 pb-4">
	<div class="row container">
		<div class="container">
			<form asp-action="PrintReport" method="get">
				<div class="pt-4 row">
					<div class="col-5">
						<label>योजना</label>
						<select name="PlanningSamjhautaId" asp-items="@await _Utility.GetYojanaAccToSamjhautaList()" class="form-control">
							<option value="">--छान्नुहोस--</option>
						</select>
					</div>
					<div class="col-2">
						<label> </label><br />
						<input type="submit" value="खोज्नुहोस्" class="btn btn-success" />
					</div>
				</div>
			</form>
		</div>

		<div class="mt-5">
			<button id="download" class="btn btn-primary">Download PDF</button>
		</div>

		<div id="content" class="mt-4">
			@foreach (var item in Model)
			{
				if (item.DocTypeName == null)
				{
					<div class="report-section mb-3 print-content" style="page-break-after:always;">
						<h3>@item.ReportName</h3>
						<div>
							@Html.Raw(item.PrintContent)
						</div>
					</div>
				}
				else
				{
					<div class="report-section mb-3 print-content" style="page-break-after:always;">
						<h3>@item.DocTypeName</h3>
						<div>
							<img src="@item.DocPath" />
						</div>
					</div>
				}

			}
		</div>
	</div>
</div>
@section Scripts {
