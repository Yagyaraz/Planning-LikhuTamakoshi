	<script>
		document.getElementById('download').addEventListener('click', async () => {
			const { jsPDF } = window.jspdf;

			// Initialize jsPDF instance
			const pdf = new jsPDF('p', 'mm', 'a4');
			const margin = 10;
			const pageWidth = pdf.internal.pageSize.width - margin * 2;
			const pageHeight = pdf.internal.pageSize.height - margin * 2;
			let currentY = margin; // Current Y position in the PDF

			// Select all print-content divs
			const printContents = document.querySelectorAll('.print-content');

			for (const content of printContents) {
				// Render each content section to a canvas
				const canvas = await html2canvas(content, {
					scale: 2, // High scale for better resolution
					useCORS: true, // Allow cross-origin images
				});

				const imgWidth = pageWidth;
				const imgHeight = (canvas.height * imgWidth) / canvas.width;

				let imgPosition = 0; // Current Y position in the canvas

				// Split the canvas into pages properly
				while (imgPosition < canvas.height) {
					// Create a temporary canvas for the current page
					const pageCanvas = document.createElement('canvas');
					pageCanvas.width = canvas.width;
					pageCanvas.height = Math.min(canvas.height - imgPosition, (pageWidth * pageHeight) / imgWidth);

					const ctx = pageCanvas.getContext('2d');
					ctx.drawImage(
						canvas,
						0, imgPosition, // Source X, Y in the original canvas
						canvas.width, pageCanvas.height, // Source width and height
						0, 0, // Destination X, Y in the temporary canvas
						pageCanvas.width, pageCanvas.height // Destination width and height
					);

					// Convert the temporary canvas to an image
					const imgData = pageCanvas.toDataURL('image/jpeg', 0.7); // JPEG format for smaller size

					// Check if the current content fits within the page
					if (currentY + (pageCanvas.height * imgWidth) / canvas.width > pageHeight) {
						pdf.addPage(); // Add a new page if the content doesn't fit
						currentY = margin; // Reset Y position for the new page
					}

					// Add the image to the PDF
					pdf.addImage(imgData, 'JPEG', margin, currentY, imgWidth, (pageCanvas.height * imgWidth) / canvas.width);

					imgPosition += pageCanvas.height; // Move to the next portion of the canvas
					currentY += (pageCanvas.height * imgWidth) / canvas.width; // Update Y position
				}

				// Add spacing between sections
				currentY += 10;

				// Ensure a new page if the current section exceeds page bounds
				if (currentY + 10 > pageHeight) {
					pdf.addPage();
					currentY = margin;
				}
			}

			// Save the PDF
			pdf.save('रीपोर्ट.pdf');
		});
	</script>
}