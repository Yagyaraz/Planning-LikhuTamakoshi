@model IEnumerable<RepotWardWiseViewModel>
@inject IUtility _Utility
@{
    ViewData["Title"] = "WardWiseReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .oval-button {
        border-radius: 25px;
    }
</style>
<div class="page-breadcrumb">
    <div class="row">
        <div class="col-12 d-flex no-block align-items-center">
            <h4 class="page-title"> वडा अन्तर्गत रिपोर्ट सुची	</h4>
            <div class="ms-auto text-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            वडा अन्तर्गत रिपोर्ट सुची
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="container">
                <form asp-action="@ViewData["Title"]" method="get">
                    <div class="pt-4 row">
                        <div class="col-2">
                            <label>आर्थिक वर्ष</label>
                            <select name="fiscalYearId" id="fiscalYearId" asp-items="@await _Utility.GetFiscalYearList()" class="form-control">
                                <option value="">--आर्थिक वर्ष छान्नुहोस--</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <label>आयोजनाको नाम</label>
                            <select name="yojanaId" id="yojanaId" asp-items="@await _Utility.GetyojanaList()" class="form-control">
                                <option value="">--आयोजनाको छान्नुहोस--</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <label>बजेट श्रोत</label>
                            <select name="budgetId" id="budgetId" asp-items="@await _Utility.GetBudgetSourceList()" class="form-control">
                                <option value="">--बजेट श्रोत छान्नुहोस--</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <label>वडा</label>
                            <select name="wardId" id="wardId" asp-items="@await _Utility.GetWardList()" class="form-control">
                                <option value="">--वडा छान्नुहोस--</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <label> </label><br />
                            <input type="submit" value="खोज्नुहोस्" class="btn btn-success" />
                        </div>
                    </div>
                </form>
            </div>
            <br />
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="zero_config"
                               class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th><b> क्र.स. </b></th>
                                    <th><b> आर्थिक वर्ष </b></th>
                                    <th><b> बजेट श्रोत </b></th>
                                    <th><b> आयोजनाको नाम </b></th>
                                    <th><b> वडा नम्बर </b></th>
                                    <th><b> आयोजनाको स्थल </b></th>
                                    <th><b> लागत अनुमान रकम </b></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@(Model.ToList().IndexOf(item) + 1)</td>
                                        <td>@Html.DisplayFor(modelItem => item.FiscalName)</td>
                                        <td>@Html.DisplayFor(modelItem => item.BudgetName)</td>
                                        <td>@Html.Raw(item.YojanaName)</td>
                                        <td>@Html.Raw(item.WardName)</td>
                                        <td>@Html.DisplayFor(modelItem => item.YojanaAddress)</td>
                                        <td>@Html.DisplayFor(modelItem => item.LagatRkm)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $("#zero_config").DataTable();
        $(document).ready(function () {
            $('#fiscalYearId').val('@ViewBag.fiscalYearId');
            $('#yojanaId').val('@ViewBag.yojanaId');
            $('#budgetId').val('@ViewBag.budgetId');
            $('#wardId').val('@ViewBag.wardId');
            var lengthOfRow = $('table tbody tr').length;
            var tableCells = [1, 6, 7];
            for (var i = 1; i <= lengthOfRow; i++) {
                $.map(tableCells, function (val) {
                    var tableCode = `table tbody tr:nth-child(${i}) td:nth-child(${val})`;
                    $(tableCode).text(englishToNepali($(tableCode).text()));
                });
            }
        });
    </script>
}