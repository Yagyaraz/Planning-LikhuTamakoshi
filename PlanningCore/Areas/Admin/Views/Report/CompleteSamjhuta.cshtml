@model IEnumerable<RepotCompleteSamjhutaViewModel>
@inject IUtility _Utility
@{
    ViewData["Title"] = "CompleteSamjhuta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .oval-button {
        border-radius: 25px;
    }
</style>

<div class="page-breadcrumb colr1">
    <div class="row">
        <div class="col-12 d-flex no-block align-items-center">
            <div style="display:flex;">
                <h4 class="card1" style="background-color:#3c8dbc; color:#fff; height:40px; width:180px; padding-top:5px; text-align:center;">सम्पन्न योजना सुची</h4>
                <span style="height:2rem; background-color:#3c8dbc; width:10px; height:40px;"></span>
                <span style="height: 2rem; border-top: 17px solid transparent;border-left: 25px solid #3c8dbc;border-bottom: 22px solid transparent; height:40px;"> </span>
            </div>
            <div class="ms-auto text-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            सम्पन्न योजना सुची
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid colr1">
    <div class="row">
        <div class="col-md-12">
            <div class="container">
                <form asp-action="@ViewData["Title"]" method="get">
                    <div class="pt-4 row">
                        <div class="col-2">
                            <label>आर्थिक वर्ष</label>
                            <select name="fiscalYearId" id="fiscalYearId" asp-items="@await _Utility.GetFiscalYearList()" class="form-control">
                                <option value="">--आर्थिक वर्ष छान्नुहोस--</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <label>आयोजनाको नाम</label>
                            <select name="yojanaId" id="yojanaId" asp-items="@await _Utility.GetyojanaList()" class="form-control">
                                <option value="">--आयोजनाको छान्नुहोस--</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <label>बजेट श्रोत</label>
                            <select name="budgetId" id="budgetId" asp-items="@await _Utility.GetBudgetSourceList()" class="form-control">
                                <option value="">--बजेट श्रोत छान्नुहोस--</option>
                            </select>
                        </div>
                        <div class="col-2">
                            <label>वडा</label>
                            <select name="wardId" id="wardId" asp-items="@await _Utility.GetWardList()" class="form-control">
                                <option value="">--वडा छान्नुहोस--</option>
                            </select>
                        </div>

                        <div class="col-2">
                            <label> </label><br />
                            <input type="submit" value="खोज्नुहोस्" class="btn btn-success" />
                        </div>
                    </div>
                </form>
            </div>

            <br />
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="zero_config"
                               class="table table-striped table-bordered">
                            <thead style="background-color: #ccd1d9; height:30px!important;">
                                <tr>
                                    <th style="width:5%; text-align:center;"><b>क्र.स. </b></th>
                                    <th style="text-align:center;"><b> आर्थिक वर्ष </b></th>
                                    <th style="text-align:center;"><b> बजेट श्रोत </b></th>
                                    <th style="text-align:center;"><b> आयोजनाको नाम </b></th>
                                    <th style="text-align:center;"><b> वडा नम्बर </b></th>
                                    <th style="text-align:center;"><b> आयोजनाको स्थल </b></th>
                                    <th style="text-align:center;"><b> विनियोजित रकम </b></th>
                                    <th style="text-align:center;"><b> सम्पन्न भएको मिति </b></th>
                                </tr>
                            </thead>
                            <tbody style="background-color:#fff;">
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="text-align:center;">@_Utility.ConvertEnglishToNepali(Model.ToList().IndexOf(item) + 1)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.FiscalName)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.BudgetName)</td>
                                        <td style="text-align:start;">@Html.Raw(item.YojanaName)</td>
                                        <td style="text-align:center;">@Html.Raw(item.WardName)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.YojanaAddress)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.BinyojitRkm)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.EndMiti)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="d-flex justify-content-end">
                            <a asp-action="YojanaDetailsSuchi" asp-controller="Setup" asp-area="Admin" class="btn  btn-sm mt-3 mb-2 me-2 text-white"
                               style=" background-color:#424f63;">
                                <i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {

    <script>
        $("#zero_config").DataTable();
        $(document).ready(function () {
            $('#fiscalYearId').val('@ViewBag.fiscalYearId');
            $('#yojanaId').val('@ViewBag.yojanaId');
            $('#budgetId').val('@ViewBag.budgetId');
            $('#wardId').val('@ViewBag.wardId');

            var lengthOfRow = $('table tbody tr').length;
            var tableCells = [6, 7, 8];
            for (var i = 1; i <= lengthOfRow; i++) {
                $.map(tableCells, function (val) {
                    var tableCode = `table tbody tr:nth-child(${i}) td:nth-child(${val})`;
                    $(tableCode).text(englishToNepali($(tableCode).text()));
                });
            }
        });
    </script>

}