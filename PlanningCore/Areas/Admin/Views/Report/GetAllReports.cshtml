@model IEnumerable<PrintReportViewModel>
@* @model PrintReportViewModel *@
@inject IUtility _Utility
@{
    ViewData["Title"] = "Index";
    <style>
        .oval-button {
            border-radius: 25px;
        }
    </style>
}
@{
    var i = 1;
}
<div class="page-breadcrumb">
    <div class="row">
        <div class="col-12 d-flex no-block align-items-center">
            <h4 class="page-title">रीपोर्ट</h4>
            <div class="ms-auto text-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            रीपोर्ट
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">

            <br />
            <div class="card">
                <div class="card-body">
                    @*   <h5 class="card-title">Basic Datatable</h5> *@

                    <div class="table-responsive">
                        <table id="zero_config"
                               class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th><b>क्र.स. </b></th>
                                    <th><b> @Html.DisplayNameFor(model => model.SamjhautaName) </b></th>
                                    <th></th>
                                </tr>
                            </thead>
                            @* 	<tr>
                            <td>1</td>
                            <td>@Model.SamjhautaName</td>
                            <td>
                            <a type="button" id="विवरण" class="btn btn-secondary btn-sm oval-button" asp-action="PrintReport" asp-route-id="@Model.PlanningSamjhautaId">
                            <i class="fa fa-list"> विवरण</i>
                            </a>
                            </td>
                            </tr> *@
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@_Utility.ConvertEnglishToNepali(i)</td>
                                        <td>@Html.DisplayFor(modelItem => item.SamjhautaName)</td>
                                        <td>
                                            <a type="button" id="विवरण" class="btn btn-secondary btn-sm oval-button" asp-action="PrintReport" asp-route-id="@item.PlanningSamjhautaId">
                                                <i class="fa fa-list"> विवरण</i>
                                            </a>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $("#zero_config").DataTable();
    </script>

    <script>
        $(function () { Message('@TempData["Msg"]') });
    </script>
}