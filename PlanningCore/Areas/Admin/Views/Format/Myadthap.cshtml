@inject IUtility _Utility
@model FormatViewModel
@{
	var headerdata = await _Utility.GetHeaderData();
}

<style>

    .printpage {
        width: 21cm;
        min-height: 29.7cm;
        padding: 2cm;
        margin: 1cm auto;
        border: 1px #d3d3d3 solid;
        border-radius: 5px;
        background: #fff;
        box-shadow: 0 0 5px rgb(0 0 0 / 10%);
        font-family: 'kalimati regular' !important;
    }

    p {
        font-size: 18px;
    }

    .table tbody tr td {
        height: 3rem !important;
    }

</style>

<div class="d-flex justify-content-end">
    <button class="btn btn-primary mt-5" type="button" onClick="Print('contentToPrint')"><i class="fa fa-print" aria-hidden="true"></i> Print</button>
</div>
<div class="row" id="contentToPrint">
    <style>
        p {
            font-size: 18px;
        }

        .table tbody tr td {
            height: 3rem !important;
        }
    </style>
	<section style="page-break-after:always; padding-top:1cm">
		<div class="container">
			<div>
				<h2 class="text-center">म्याद थपको लागि निवेदन</h2>
				<h5 class="d-flex justify-content-end">मितिः२०....../..../......</h5>
				<p>
					श्री प्रमुख प्रशासकीय अधिकृत ज्यू, <br />
					@headerdata.PalikaName  <br />
					गाउँ कार्यपालिकाको कार्यालय  <br />
					धोबी बजार, रामेछाप ।
				</p>
				<h4 class="text-center"><u>विषयः म्याद थप गरिदिने सम्बन्धमा ।</u></h4>
			</div>
			<div>

				<p>प्रस्तुत विषयमा @headerdata.PalikaName @Model.PlanningSamjhauta.YojanaWards मा संञ्चालित @Model.PlanningSamjhauta.YojanaNames आयोजना ......................... कारणले तोकिएको समयमा सम्पन्न नभएकोले उपभोक्ता समितिको मिति २०......../.../...  को बैठकमा म्याद थप गर्ने निर्णय भए अनुसार मिति २०......../......../...... सम्मको लागि म्याद थप गर्नुहुन विनम्र अनुरोध गर्दछौ ।</p>
				<h5>उपभोक्ता/संस्थाको तर्फबाट</h5>
				<h5>नामः @Model.UpavoktaSamiti.Adakshya </h5>
				<h5>पदः अध्यक्ष </h5>
				<h5>दस्तखतः </h5>
				<table class="table table-bordered w-100">
					<tr>
						<td><p>प्राविधिक कर्मचारी/ईन्जिनियरको सिफारिस</p></td>
						<td>
							<p>
								श्री प्रमुख प्रशासकीय अधिकृत ज्यू,
								उल्लेखित योजनाको उपभोक्ता समितिको निर्णय निवेदन र प्राविधिक अनुगमन गर्दा ................................... कारणले गर्दा मिति २०....../...../....... देखि २०......../......./..... सम्मको लागि म्याद थप गर्न उपयुक्त देखिएको सिफारिस गर्दछु ।
								<span> <br />..........................................</span>
							</p>
						</td>
					</tr>
					<tr>
						<td><p>योजना शाखाको सिफारिस</p></td>
						<td>
							<p>
								श्री प्रमुख प्रशासकीय अधिकृत ज्यू,
								उल्लिखित योजनाको उपभोक्ता समितिको निर्णय र प्राविधिक कर्मचारीको सिफारिस बमोजिम मिति २०...../....../... देखि २०....../....../......  सम्मको लागि म्याद थप गर्न उपयुक्त देखिएकोले निर्णायार्थ पेश गर्दछु ।
								<span><br />.............................</span>
							</p>
						</td>
					</tr>
					<tr>
						<td><p>कार्यालय प्रमुखको स्वीकृती</p></td>
						<td><span><br />...............................</span></td>
					</tr>
				</table>
			</div>
		</div>
	</section>
</div>

<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

@section Scripts
{
	<script type="text/javascript">
		//$(function () {
		//    $('.currentdate').html(GetNepaliCurrentDate());
		//});
		function Print() {
			var elementHTML = document.getElementById('contentToPrint').innerHTML;
			var oldPage = document.body.innerHTML;
			document.body.innerHTML = elementHTML;
			window.print();
			//document.body.innerHTML = oldPage;
			window.location.reload(true);
		}
	</script>
}