@inject IUtility _Utility
@model FormatViewModel
@{
    var headerdata = await _Utility.GetHeaderData();
    var pesgarnepost = await _Utility.GetPostById(ViewBag.PesgarneId);
    var pesgarneName = await _Utility.GetEmpNameById(ViewBag.Pesgarne);
    var sifarishgarnepost = await _Utility.GetPostById(ViewBag.SifarishGarneId);
    var sifarishgarneName = await _Utility.GetEmpNameById(ViewBag.SifarishGarne);
    var swkritgarnepost = await _Utility.GetPostById(ViewBag.SwkritGarneId);
    var swkritgargneName = await _Utility.GetEmpNameById(ViewBag.SwkritGarne);
}

<style>

    .printpage {
        width: 21cm;
        min-height: 29.7cm;
        padding: 2cm;
        margin: 1cm auto;
        border: 1px #d3d3d3 solid;
        border-radius: 5px;
        background: #fff;
        box-shadow: 0 0 5px rgb(0 0 0 / 10%);
        font-family: 'kalimati regular' !important;
    }

    p {
        font-size: 18px;
    }

    .table tbody tr td {
        height: 3rem !important;
    }
</style>
<form asp-action="TippaniAadesh" method="get">
    <div class="col-md-12 col-12 mt-5 row pl-2 mb-1" style="padding-left:10px;">
        <div class="col-md-4 col-4">
            <label style="text-align:center;font-weight:bold;font-size:20px;">पेश गर्ने</label>
        </div>
        <div class="col-md-4 col-4"> <label style="text-align:center;font-weight:bold;font-size:20px;">सिफारिस गर्ने</label></div>
        <div class="col-md-4 col-4">      <label style="text-align:center;font-weight:bold;font-size:20px;">स्वीकृत गर्ने</label></div>
    </div>
    <div class="col-md-12 col-12 row pl-5" style="padding-left:10px;">
        <div class="col-2">
            <label>पद</label>
            <select name="pesgarneId" id="PostId1" asp-items="@await _Utility.GetPadaList()" class="form-control post-dropdown">
                <option value="">--पद छान्नुहोस--</option>
            </select>
        </div>
        <div class="col-2">
            <label>नाम</label>
            <select name="pesgarne" id="EmpId1" asp-items="@await _Utility.GetEmpNameByPostId(ViewBag.PostId)" class="form-control emp-dropdown">
                <option value="">--नाम छान्नुहोस--</option>
            </select>
        </div>
        <div class="col-2">
            <label>पद</label>
            <select name="sifarishgarneId" id="PostId2" asp-items="@await _Utility.GetPadaList()" class="form-control post-dropdown">
                <option value="">--पद छान्नुहोस--</option>
            </select>
        </div>
        <div class="col-2">
            <label>नाम</label>
            <select name="sifarishgarne" id="EmpId2" asp-items="@await _Utility.GetEmpNameByPostId(ViewBag.PostId)" class="form-control emp-dropdown">
                <option value="">--नाम छान्नुहोस--</option>
            </select>
        </div>
        <div class="col-2">
            <label>पद</label>
            <select name="swkritgarneId" id="PostId3" asp-items="@await _Utility.GetPadaList()" class="form-control post-dropdown">
                <option value="">--पद छान्नुहोस--</option>
            </select>
        </div>
        <div class="col-2">
            <label>नाम</label>
            <select name="swkritgarne" id="EmpId3" asp-items="@await _Utility.GetEmpNameByPostId(ViewBag.PostId)" class="form-control emp-dropdown">
                <option value="">--नाम छान्नुहोस--</option>
            </select>
        </div>
    </div>
    <div class="col-2" style="padding-left:10px;">
        <label> </label><br />
        <input type="submit" value="खोज्नुहोस्" class="btn btn-success"/>
    </div>
</form>
<div class="d-flex justify-content-end">
    <button class="btn btn-primary mt-5" type="button" onClick="Print('contentToPrint')"><i class="fa fa-print" aria-hidden="true"></i> Print</button>
</div>
<div class="row" id="contentToPrint">
    <style>
        p {
            font-size: 18px;
        }

        .table tbody tr td {
            height: 3rem !important;
        }


        .tippani {
            color: white;
            background-color: black;
            text-align: center;
            border-radius: 20px;
        }
    </style>
    <section style="page-break-after:always; padding-top:4px;">
        <div class="container">
            <div class="row">

                <div class="Header">
                    <partial name="_PrintHeaderTippaniAndSamjhautapatrta" />
                </div>

            </div>
            <div style="display: flex; justify-content:center;">
                <h2 class="px-4 py-2 pt-3 tippani" style="color: white; background-color: black; text-align: center; border-radius:20px;">टिप्पणी र आदेश</h2>
            </div>
            <p>
                श्री प्रमुख प्रशासकीय अधिकृत,
            </p>
            <p>@headerdata.PalikaName </p>
            <p>@headerdata.Address,@headerdata.DistrictName  ।</p>

            <p style="text-align:justify">
                निम्न लेखिएको बमोजिम कार्यक्रममा आ.व. @Model.PlanningSamjhauta.FiscalYearName मा @Model.PlanningSamjhauta.YojanaNames कार्यक्रम अन्तर्गत
                बाट विनियोजित गरिएको रकमबाट सो कार्यक्रम संचालन गरि कार्य सम्पन्न गर्न सार्वजनिक खरिद
                नियमावली २०६४ को नियम ९७(३) बमोजिम उपभोक्ता समिति/टोल विकास संस्थाका
                अध्यक्ष श्री @Model.UpavoktaSamiti.Adakshya
                सचिव श्री @Model.UpavoktaSamiti.Sachib र कोषाध्यक्ष श्री @Model.UpavoktaSamiti.Kosadakshya
                र गाउँपालिका कार्यालयबिच मिति @Model.PlanningSamjhauta.Municipality_Manjuri_Date
                गते
                @Model.PlanningSamjhauta.YojanaNames योजनाको  सम्झौता भएकोमा सो योजनाको कामको योजना तथा प्राविधिक शाखा तथा
                कार्यालय प्रमुखबाट स्वीकृत प्राविधिक मुल्याङ्कन कार्य सम्पन्न प्रतिवेदन बिल, भरपाई खर्च सार्वजनिकरण गाउँपालिकास्तरीय अनुगमन
                समितिको प्रतिवेदन तथा समितिको निर्णय संलग्न राखी अन्तिम किस्ता निकासा माग भएको ।
            </p>
            <table class="table table-bordered">
                <tr>
                    <td>आर्थिक वर्ष</td>
                    <td colspan="5">@Model.PlanningSamjhauta.FiscalYearName</td>
                </tr>
                <tr>
                    <td>योजनाको नाम</td>
                    <td colspan="4">@Model.PlanningSamjhauta.YojanaNames</td>
                </tr>
                <tr>
                    <td>उ.स. </td>
                    <td colspan="4">@Model.UpavoktaSamiti.Name</td>
                </tr>
                <tr>
                    <td>योजना सम्पन्न मिति</td>
                    <td colspan="4">@Model.PlanningSamjhauta.Project_End_Date</td>
                </tr>
                <tr>
                    <td>स्वीकृत जम्मा लागत अनुमान रकम</td>
                    <td colspan="5">@Model.PlanningSamjhauta.Total_Amount_Source</td>
                </tr>
                <tr>
                    <td rowspan="2" style="vertical-align:middle;">विनियोजित रकम</td>
                    <td rowspan="1">गा.पा. बाट बेहोर्ने </td>
                    <td rowspan="1">कन्टिन्जेन्सी कट्टी रकम रु</td>
                    <td rowspan="1">मर्मत संभार कोष कट्टी</td>
                    <td rowspan="1">खुद निकासा हुने रकम</td>
                </tr>
                <tr>
                    <td>@Model.PlanningSamjhauta.Project_estimated_Amount</td>
                    <td>@Model.PlanningSamjhauta.Municipality</td>
                    <td>@Model.PlanningSamjhauta.MarmatSambhar_Amount</td>
                    <td></td>
                </tr>
                <tr>
                    <td>उपभोक्त समिति तथा सम्बन्धित निकायले बेहोर्ने रकम</td>
                    <td colspan="5"></td>
                </tr>
                <tr>
                    <td>प्राविधिक मुल्याङ्कन रकम</td>
                    <td colspan="5"></td>
                    @*               <td></td>
                    <td></td> *@
                </tr>
                <tr>
                    <td>निकासा योग्य रकम</td>
                    <td colspan="5"></td>
                    @*  <td></td> *@
                </tr>
            </table>

            <p style="text-align:justify;">
                यसमा माथि लेखिए बमोजिमको योजनामा भएको खर्चको प्राविधिक मूल्याङ्कन कार्य सम्पन्न प्रतिवेदन तथा उपभोक्ता समिति (टोल विकास संस्था) को निर्णय, खर्च सार्वजनिकरण, संलग्न बिल भरपाईहरु, गाउँपालिकास्तरीय अनुगमन समितिको प्रतिवेदनका आधारमा निकास दिन बाँकी देखिएको रकमबाट गाउँसभाबाट खर्च अनुमोदन गर्ने गरी लेखा शाखाको राय लिई उक्त समितिलाई सार्वजिक खरिद नियमावली, २०६४ को नियम ९७(४) तथा आर्थिक नियमानुसार हुन आउने रकम भुक्तानी दिन निर्णयार्थ पेश गरेको छु ।
            </p>

            <div class="pt-4 pl-5" style="display:flex; justify-content:space-between;">
                <div>
                    <p>
                        .............................. <br />
                        पेश गर्ने <br />
                        योजना शाखा <br />
                        नाम थरः @pesgarneName <br />
                        पदः @pesgarnepost <br />
                        मितिः
                    </p>
                </div>
                <div>
                    <p>
                        .............................. <br />
                        सिफारिस गर्ने <br />
                        इन्जिनियर <br />
                        नाम थरः @sifarishgarneName <br />
                        पदः @sifarishgarnepost <br />
                        मितिः
                    </p>
                </div>
                <div>
                    <p>
                        .............................. <br />
                        स्वीकृत गर्ने <br />
                        प्रमुख प्रशासकीय अधिकृत <br />
                        नाम थरः @swkritgargneName <br />
                        पदः @swkritgarnepost <br />
                        मितिः
                    </p>
                </div>
            </div>

            <p class="pt-3">प्राप्त कागजात र शाखागत रुपमा पेश भएको आधारमा खर्च लेख्ने</p>
            <p class="pt-2">..............................</p>
            <p>आर्थिक प्रशासन शाखा</p>
            <p>नाम थरः</p>
            <p>पदः </p>
        </div>
    </section>
</div>

<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

@section Scripts
{
    <script type="text/javascript">
        //$(function () {
        //    $('.currentdate').html(GetNepaliCurrentDate());
        //});
        function Print() {
            var elementHTML = document.getElementById('contentToPrint').innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = elementHTML;
            window.print();
            //document.body.innerHTML = oldPage;
            window.location.reload(true);
        }
    </script>
    <script>
        $(document).ready(function () {
            $('.post-dropdown').change(function () {
                const postDropdown = $(this); // Current Post dropdown
                const empDropdown = postDropdown.closest('.col-2').next('.col-2').find('.emp-dropdown'); // Find corresponding Emp dropdown

                $.ajax({
                    url: '@Url.Action("GetEmpNameByPostId", "Ajax", new { area = "" })',
                    type: 'GET',
                    data: { id: postDropdown.val() },
                    success: function (data) {
                        empDropdown.empty().append("<option value=''>--नाम छान्नुहोस--</option>");
                        $.each(data, function (index, item) {
                            empDropdown.append(`<option value="${item.Value}">${item.Text}</option>`);
                        });
                    },
                    error: function () {
                        alert('Error in calling Ajax!');
                    }
                });
            });
        });
    </script>

}