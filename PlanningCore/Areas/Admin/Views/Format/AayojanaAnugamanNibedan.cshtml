@inject IUtility _Utility
@model FormatViewModel
@{
    var headerdata = await _Utility.GetHeaderData();
    ViewData["Title"] = "AayojanaAnugamanNibedan";
}

<style>

    .printpage {
        width: 21cm;
        min-height: 29.7cm;
        padding: 2cm;
        margin: 1cm auto;
        border: 1px #d3d3d3 solid;
        border-radius: 5px;
        background: #fff;
        box-shadow: 0 0 5px rgb(0 0 0 / 10%);
        font-family: 'kalimati regular' !important;
    }

    p {
        font-size: 18px;
    }

    .table tbody tr td {
        height: 3rem !important;
    }

</style>
<div class="container pt-4 mt-4">
    <form asp-action="@ViewData["Title"]" method="get">
        <div class="pt-4 row">
            <div class="col-md-2 col-2">
                <label>मिति : </label> <br />
                <input type="text" name="PrintDate" required class="form-control PrintDate" value="@Model.PlanningSamjhauta.PrintDate" />
            </div>

            <div class="col-2">
                <label> </label><br />
                <input type="submit" value="खोज्नुहोस्" class="btn btn-success" />
            </div>
        </div>
    </form>
</div>
<div class="d-flex justify-content-end">
    <button class="btn btn-primary mt-5" type="button" onClick="Print('contentToPrint')"><i class="fa fa-print" aria-hidden="true"></i> Print</button>
</div>
<div class="row" id="contentToPrint">
    <style>
        p {
            font-size: 18px;
        }

        .table tbody tr td {
            height: 3rem !important;
        }
    </style>
    <section style="page-break-after:always; padding-top:4px;">
        <div class="container">
            <style>
                .footerRepeat {
                    position: relative !important;
                    bottom: 0px !important
                }

                .Header {
                    position: relative !important;
                    top: 0px !important
                }


                @@media print {
                    .footerRepeat {
                        position: fixed !important;
                        bottom: 0px !important
                    }

                    .Header {
                        position: fixed !important;
                        top: 0px !important
                    }

                    .print-body {
                        overflow: visible; /* Ensure full content is visible during printing */
                        margin-top: 230px !important; /* Matches header height */
                        margin-bottom: 30px !important; /* Matches footer height */
                        page-break-inside: auto;
                    }

                    .print-body1 {
                        overflow: visible; /* Ensure full content is visible during printing */
                        margin-top: 250px !important; /* Matches header height */
                        margin-bottom: 30px !important; /* Matches footer height */
                        page-break-inside: auto;
                    }
                }
            </style>
            <div class="d-flex" style="justify-content:space-between; align-items:center; width:100%;">
                <div style="flex:1; text-align:center;">
                    <p style="margin:0;">
                        <u><b>योजना अनुगमन निवेदनको ढाँचा</b></u>
                    </p>
                </div>
                <div style="position:absolute; right:0;margin-right:10px;margin-top:50px;">
                    <p style="margin:0; text-align:right;">
                        मिति:- @_Utility.ConvertEnglishToNepali(Model.PlanningSamjhauta.PrintDate)
                    </p>
                </div>
            </div>
            <br /><br /><br /><br /><br />
            <div style="text-align:center">
                <p><b>बिषय: योजना अनुगमन सम्बन्धमा</b></p>
            </div>
            <div style="color:black;">
                <p>श्री संयाजोक ज्यु,</p>
                <p>
                    @headerdata.PalikaName स्तरीय योजना अनुगमन समिति
                </p>
                <p>@headerdata.Address, @headerdata.DistrictName ।</p>
                <p style="text-align:justify">
                    प्रस्तुत विषयमा @headerdata.PalikaName को
                    स्वीकृत वार्षिक नीति तथा कार्यक्रम र बजेट अन्तर्गत
                    आ.व. @Model.PlanningSamjhauta.FiscalYearName मा संचालित तपशिल बमोजिमको
                    योजना कार्यक्रम निर्माण कार्य भईरहेको निर्माण कार्य सम्पन्न भएकाले अनुगमन गरिदिनु हुन अनुरोध छ ।
                </p>

                <table class="border" style="text-align:center; width:100% !important;">
                    <tr>
                        <th style="border: 1px solid black !important; width:1rem;">क्र.स.</th>
                        <th style="border: 1px solid black !important; width:5rem;">नाम</th>
                        <th style="border: 1px solid black !important; width:10rem;"></th>
                    </tr>
                    <tr>
                        <td style="border: 1px solid black !important; width:1rem;">१.</td>
                        <td style="border: 1px solid black !important; width:5rem;">योजनाको नाम</td>
                        <td style="border: 1px solid black !important; width:10rem;">@Model.PlanningSamjhauta.YojanaNames</td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid black !important; width:1rem;">२.</td>
                        <td style="border: 1px solid black !important; width:5rem;">योजनाको लागत सम्बन्धि बिबरण</td>
                        <td style="border: 1px solid black !important; width:10rem;">
                            क) लागत अनुमान रु. @Model.PlanningSamjhauta.Total_Amount_Source<br />
                            ख) लागत व्यहोर्ने स्रोतहरु <br>
                            <ul style="list-style: none; padding: 0; margin: 0;">
                                <li>I) गाउँपालिकाबाट रु. @Model.PlanningSamjhauta.Municipality</li>
                                <li>II) गैरसरकारी संघ संस्थाबाट रु. @Model.PlanningSamjhauta.NGO_INGO</li>
                                <li>III) समुदायमा आधारित संस्थाबाट रु. @Model.PlanningSamjhauta.Community_Org</li>
                                <li>IV) उपभोक्ता समिति टोल विकास संस्थाबाट रु. @Model.PlanningSamjhauta.Public_Community</li>
                                <li>V) अन्यबाट रु. @Model.PlanningSamjhauta.Other_Source</li>
                                <li>VI) जम्मा रु. @Model.PlanningSamjhauta.Total_Amount_Source</li>
                            </ul>                           
                        </td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid black !important; width:1rem;">३.</td>
                        <td style="border: 1px solid black !important; width:5rem;">योजना कार्यन्वयन स्थल</td>
                        <td style="border: 1px solid black !important; width:10rem;">@Model.PlanningSamjhauta.YojanaAddress</td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid black !important; width:1rem;">४.</td>
                        <td style="border: 1px solid black !important; width:5rem;">योजना सम्झौता मिति</td>
                        <td style="border: 1px solid black !important; width:10rem;">@Model.PlanningSamjhauta.Municipality_Manjuri_Date</td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid black !important; width:1rem;">५.</td>
                        <td style="border: 1px solid black !important; width:5rem;">उपभोक्ता समितिको पदाधिकरीको बिबरण</td>
                        <td style="border: 1px solid black !important; width:10rem;">

                            क) अध्यक्षः @Model.UpavoktaSamiti.Adakshya<br>
                            ख) सचिवः @Model.UpavoktaSamiti.Sachib<br>
                            ग) कोषाध्यक्षः @Model.UpavoktaSamiti.Kosadakshya<br>
                        </td>
                    </tr>
                    <tr>
                        <td style="border: 1px solid black !important; width:1rem;">६.</td>
                        <td style="border: 1px solid black !important; width:5rem;">अन्य बिबरण</td>
                        <td style="border: 1px solid black !important; width:10rem;"></td>
                    </tr>
                </table>
                <br />
            </div>

            <footer style=" width:100%; " class="footerRepeat" id="footer">
                <partial name="_printfooter" />
            </footer>
        </div>
    </section>
</div>

<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

@section Scripts
{
    <script>
        NepaliDatePickerCalWithClass(document.getElementsByClassName('PrintDate'))
    </script>
    <script type="text/javascript">
        //$(function () {
        //    $('.currentdate').html(GetNepaliCurrentDate());
        //});
        function Print() {
            var elementHTML = document.getElementById('contentToPrint').innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = elementHTML;
            window.print();
            //document.body.innerHTML = oldPage;
            window.location.reload(true);
        }
    </script>
}