@inject IUtility _Utility
@model FormatViewModel
@{
    var headerdata = await _Utility.GetHeaderData();
    int i = 1;
}

<style>

    .printpage {
    width: 21cm;
    min-height: 29.7cm;
    padding: 2cm;
    margin: 1cm auto;
    border: 1px #d3d3d3 solid;
    border-radius: 5px;
    background: #fff;
    box-shadow: 0 0 5px rgb(0 0 0 / 10%);
    font-family: 'kalimati regular' !important;
    }

    p {
    font-size: 18px;
    }

    .table tbody tr td {
    height: 3rem !important;
    }

</style>

<div class="d-flex justify-content-end">
    <button class="btn btn-primary mt-5" type="button" onClick="Print('contentToPrint')"><i class="fa fa-print" aria-hidden="true"></i> Print</button>
</div>
<div class="row" id="contentToPrint">
    <style>
        p {
        font-size: 18px;
        }

        .table tbody tr td {
        height: 3rem !important;
        }
    </style>
    <section style="page-break-after:always; padding-top:4px;">
        <div class="container">
            <h3 class="text-center">योजनाको  अन्तिम अनुगमन फारम</h3>
            <div style="display:flex; justify-content:space-between;">
                <h5>संक्षिप्त विवरण</h5>
                <h5>अनुगमन गरेको मितिः ..............</h5>
            </div>
            <table class="table table-bordered">
                <tr>
                    <td>आयोजनाको नाम ठेगाना</td>
                    <td style="width:60%;">@Model.PlanningSamjhauta.YojanaNames @Model.PlanningSamjhauta.YojanaAddress</td>
                </tr>
                <tr>
                    <td>टोल विकास/उपभोक्ता समितिको अध्यक्षको नामः</td>
                    <td>@Model.UpavoktaSamiti.Adakshya</td>
                </tr>
                <tr>
                    <td>उ.स.को सदस्य संख्याः ......... पू ...... म</td>
                    <td>योजनाको किसिमः</td>
                </tr>
                <tr>
                    <td>निर्माण कार्यको प्रयोग भएको विधि</td>
                    <td>कामदार/मेसिनरी उपकरण/दुबै</td>
                </tr>
                <tr>
                    <td>लाभान्वित घरधुरीः @{
                            var female = Model.PlanningSamjhauta.Total_Female;  var male=Model.PlanningSamjhauta.Total_Female;
                            var total = female + male;
                        }@total</td>
                    <td>सम्झौता मितिः@Model.PlanningSamjhauta.Municipality_Manjuri_Date   सम्पन्न मितिः@Model.PlanningSamjhauta.Project_End_Date</td>
                </tr>
            </table>

            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>क्र.स.</th>
                        <th>विवरण</th>
                        <th>भएको</th>
                        <th>नभएको</th>
                        <th>कैफियत</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>१</td>
                        <td>आयोजनाको विवरण आयोजना स्थलमा टाँस गरिएको</td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>२</td>
                        <td>विधिसम्मत निर्णय प्रक्रिया/ कामको बाँडफाँड</td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>३</td>
                        <td>विधिसम्मत आर्थिक कारोवार </td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>४</td>
                        <td>किस्तामा रकम निकासा</td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>५</td>
                        <td>सार्वजनिक लेखापरिक्षण</td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>६</td>
                        <td>लक्ष्य अनुसार प्रगति</td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>७</td>
                        <td>अन्य निकायबाट नगद तथा जिन्सी सहयोग प्राप्ति</td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>८</td>
                        <td>तोकिए बमोजिमको जनश्रमदान/लागत सहभागिता/ लक्षित बर्गको सहभागिता</td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>९</td>
                        <td>प्राविधिक लागत अनुमानमा तोकिए बमोजिमको गुणस्तर र परिणाम कायम</td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td>१०</td>
                        <td>योजनाको संरक्षण तथा मर्मत संभार सम्बन्धी योजना र मर्मत सम्भार कोष </td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>

            <table class="table table-bordered" style="position:relative; bottom: 12px;">
                <tr>
                    <td colspan="4" class="text-center" style="border-top: none!important;">अनुगमन समितिका पदाधिकारीहरु</td>
                </tr>
                @foreach(var item in Model.PlanningSamjhauta.AnugamanSamitiSetup.AnugamanSamitiListPalika)
                {
                    <tr>
                        <td style="width:50px;">
                        <td>@_Utility.ConvertEnglishToNepali(i)</td>
                        <td>@item.Name</td>
                        <td>@item.PostName</td>
                        <td style="width:25%;"></td>
                    </tr>
                }

@*                 <tr>
                    <td>२</td>
                    <td>राम बहादुर सुनुवार (कार्यपालिका सदस्य)</td>
                    <td>सदस्य</td>
                    <td></td>
                </tr>
                <tr>
                    <td>३</td>
                    <td>सरिता नेपाली (कार्यपालिका सदस्य)</td>
                    <td>सदस्य</td>
                    <td></td>
                </tr>
                <tr>
                    <td>४</td>
                    <td></td>
                    <td>प्रमुख प्रशासकीय अधिकृत</td>
                    <td></td>
                </tr>
                <tr>
                    <td>५</td>
                    <td></td>
                    <td>इन्जिनियर</td>
                    <td></td>
                </tr>
                <tr>
                    <td>६</td>
                    <td></td>
                    <td>योजना शाखा/सदस्य सचिव</td>
                    <td></td>
                </tr> *@
            </table>
        </div>
    </section>
</div>

<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

@section Scripts
{
    <script type="text/javascript">
        //$(function () {
        //    $('.currentdate').html(GetNepaliCurrentDate());
        //});
        function Print() {
            var elementHTML = document.getElementById('contentToPrint').innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = elementHTML;
            window.print();
            //document.body.innerHTML = oldPage;
            window.location.reload(true);
        }
    </script>
}