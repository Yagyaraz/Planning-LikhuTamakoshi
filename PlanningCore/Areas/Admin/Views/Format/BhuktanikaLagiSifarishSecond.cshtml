@inject IUtility _Utility
@model FormatViewModel
@{
	var headerdata = await _Utility.GetHeaderData();
	bool isSavedData = false;
}

<style>

	.printpage {
		width: 21cm;
		min-height: 29.7cm;
		padding: 2cm;
		margin: 1cm auto;
		border: 1px #d3d3d3 solid;
		border-radius: 5px;
		background: #fff;
		box-shadow: 0 0 5px rgb(0 0 0 / 10%);
		font-family: 'kalimati regular' !important;
	}

	p {
		font-size: 18px;
	}

	.table tbody tr td {
		height: 3rem !important;
	}

</style>

<div class="d-flex justify-content-end">
	<button class="btn btn-primary mt-5" type="button" onClick="Print('contentToPrint')"><i class="fa fa-print" aria-hidden="true"></i> Print</button>
</div>
<div class="row" id="contentToPrint">
	<style>
		p {
			font-size: 18px;
		}

		.table tbody tr td {
			height: 3rem !important;
		}
	</style>
	<section style="page-break-after:always; padding-top:4px;">
		<div class="container">
			<h4 class="text-center">भुक्तानीको लागि सिफारिसको निवेदन</h4>
			<div style="display:flex; justify-content:end;">
				<h4>मितिः२०.../...../......</h4>
			</div>
			<h4>
				श्री @headerdata.PalikaName
			</h4>
			<h4>@headerdata.Name</h4>
			<h4>@headerdata.Address, @headerdata.DistrictName।</h4>
			<h4 class="text-center"><u>विषयः भुक्तानीको लागि सिफारिस गराई पाउँ ।</u></h4>
			<p style="text-align:justify">
				प्रस्तुत विषयमा @headerdata.PalikaName रामेछापको आ.व.@Model.PlanningSamjhauta.FiscalYearName को @Model.PlanningSamjhauta.YojanaNames  
				योजनामा गाउँपालिकाबाट विनियोजित रकम रूः@Model.PlanningSamjhauta.Municipality तोकिए बमोजिम कार्य गर्ने गरी मिति @Model.PlanningSamjhauta.Municipality_Manjuri_Date  मा गाउँपालिका सँग भएको सम्झौता भएको थियो। योजनाका
				लागि विनियोजित रकम मध्ये रू....................................बराबरको कार्य सम्पन्न गरी सो को पुष्टि हुने गरिवडा 
				कार्यालयको सिफारिस, वडास्तरिय अनुगमन समिति तथा यसै कार्यालयको योजना अनुगमन तथा सुपरिवेक्षण समितिबाट अनुगमन तथा सुपरिवेक्षण 
				प्रतिवेदन आदिका आधारमा,सो रकम माग गर्न पेस गरेका कागजातहरुको विषयमा सम्पूर्ण जवाफदेहिता हामी स्वयं तिर्नेछौ भनि उल्लेखित रकम भुक्तानी
				उपलब्ध गराई दिनुहुन तपसिल बमोजिमका कागजात सहित अनुरोध गर्दछु/गर्दछौ ।
			</p>
			<p class="fw-bold">तपसिलः</p>
			<div style="text-indent: 20px;">
				<p>१)	योजना शाखाको प्राविधिक द्वारा जाँचपास भई तयार भएका प्राविधिक विलहरु।</p>
				<p>२)	प्राविधिक विल तथा भरपाई पुष्टि गर्ने उपभोक्ता समितिबाट प्रमाणित भएका विल भरपाई,डोर हाजिर,</p>
				<p>३)	कार्यसम्पादन भएको देखिने फोटो संलग्न थान.....</p>
				<p>४)	अध्यक्षले प्रमाणित गरेको उपभोक्ता समितिको निर्णयहरु....।</p>
				<p>५)	जनसहभागिताको अभिलेख प्रतिलिपि ।</p>
				<p>६)	वडा स्तरीय अनुगमन समितिको निर्णय तथा सिफारिसको छाँयाप्रति थान...।</p>
				<p>७)	उपभोक्ता समितिका सम्पूर्ण पदादिकारीहरुको नेपाली नागरिकता प्रमाणपत्रको प्रतिलिपि एक,एक थान (उपभोक्ता समितिका अध्यक्ष,सचिव वा कोषाध्यक्षले प्रमाणित गरको) ।</p>
				<p>८)	अन्य केही भए</p>
			</div>
			<div class="row">
				<div class="col-md-8 col-8"></div>
				<div class="col-md-4 col-4">
					<p>
						.................................
					</p>
					<h6>उपभोक्ता समिति/संस्थाको तर्फबाट</h6>
				</div>
			</div>
		</div>
	</section>
</div>

<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

@section Scripts
{
	<script type="text/javascript">
		//$(function () {
		//    $('.currentdate').html(GetNepaliCurrentDate());
		//});
		function Print() {
			var elementHTML = document.getElementById('contentToPrint').innerHTML;
			var oldPage = document.body.innerHTML;
			document.body.innerHTML = elementHTML;
			window.print();
			//document.body.innerHTML = oldPage;
			window.location.reload(true);
		}
	</script>
}