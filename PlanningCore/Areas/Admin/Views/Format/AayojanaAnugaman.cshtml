@inject IUtility _Utility
@model FormatViewModel
@{
    var headerdata = await _Utility.GetHeaderData();
}

<style>

    .printpage {
        width: 21cm;
        min-height: 29.7cm;
        padding: 2cm;
        margin: 1cm auto;
        border: 1px #d3d3d3 solid;
        border-radius: 5px;
        background: #fff;
        box-shadow: 0 0 5px rgb(0 0 0 / 10%);
        font-family: 'kalimati regular' !important;
    }

    p {
        font-size: 18px;
    }

    .table tbody tr td {
        height: 3rem !important;
    }

</style>

<div class="d-flex justify-content-end">
    <button class="btn btn-primary mt-5" type="button" onClick="Print('contentToPrint')"><i class="fa fa-print" aria-hidden="true"></i> Print</button>
</div>
<div class="row" id="contentToPrint">
    <style>
        p {
            font-size: 18px;
        }

        .table tbody tr td {
            height: 3rem !important;
        }
    </style>
    <section style="page-break-after:always; padding-top:4px;">
        <div class="container">
            <style>
                .footerRepeat {
                    position: relative !important;
                    bottom: 0px !important
                }

                .Header {
                    position: relative !important;
                    top: 0px !important
                }


                @@media print {
                    .footerRepeat {
                        position: fixed !important;
                        bottom: 0px !important
                    }

                    .Header {
                        position: fixed !important;
                        top: 0px !important
                    }

                    .print-body {
                        overflow: visible; /* Ensure full content is visible during printing */
                        margin-top: 230px !important; /* Matches header height */
                        margin-bottom: 30px !important; /* Matches footer height */
                        page-break-inside: auto;
                    }

                    .print-body1 {
                        overflow: visible; /* Ensure full content is visible during printing */
                        margin-top: 250px !important; /* Matches header height */
                        margin-bottom: 30px !important; /* Matches footer height */
                        page-break-inside: auto;
                    }
                }
            </style>
            <div class="row">

                <div class="Header">
                    <partial name="_PrintHeaderTippaniAndSamjhautapatrta" />
                </div>

            </div>
            <div class="container print-body" style="color:black;">
                <p>
                    श्री @headerdata.PalikaName को कार्यालय,
                </p>
                <p>@headerdata.Name </p>
                <p>@headerdata.Address, @headerdata.DistrictName ।</p>
                <h4 class="text-center pt-2">बिषय:-<u>योजना अनुगमन समितिको सिफारिस सम्‍बन्‍धमा।</u></h4>
                <p style="text-align:justify">
                    प्रस्तुत बिषयको सम्‍बन्‍धमा यस @Model.PlanningSamjhauta.YojanaNames कार्य मिति @Model.PlanningSamjhauta.Municipality_Manjuri_Date देखि
                    संचालन भई प्राविधिक लागत ईष्‍टिमेट बमोजिम रू:@Model.PlanningSamjhauta.Total_Amount_Source /- मध्‍ये मिति @Model.PlanningSamjhauta.Project_Complete_Date गते
                    सम्‍म प्राविधिक प्रतिवेदन अनुसार कार्य चुस्‍त,दुरुस्‍त तथा पारदर्शिता एवं प्रभावकारीताका साथ सम्‍पन्‍न भएको र हामी तपशिलका अनुगमन मुल्‍याङकन तथा सुपरिवेक्षण समितिका
                    पदाधिकारीहरुले योजना स्‍थलमा नै उपस्‍थित भई अनुगमन गरेको हुँदा प्राविधिक मुल्‍याङकन प्रतिवेदन र खर्चको बिल भर्पाईको आधारमा उक्त योजना फरफारक गरि रकम
                    भुक्तानी गरि दिनु हुन सिफारिसका साथ अनुरोध छ ।
                </p>

                <div class="row">
                    <div class="col-md-5 col-5">
                        <p>तपशिलः </p>
                    </div>
                    <div class="col-md-4 col-4">
                        <p>पद</p>
                    </div>
                    <div class="col-md-3 col-3">
                        <p>हस्‍ताक्षर</p>
                    </div>
                </div>
                <div class="row">
                    @foreach (var item in Model.PlanningSamjhauta.AnugamanSamitiSetup.AnugamanSamitiListPalika)
                    {
                        <div class="col-md-5 col-5">
                            <p>श्री @item.Name </p>
                        </div>
                        <div class="col-md-4 col-4">
                            <p>@item.PostName</p>
                        </div>
                        <div class="col-md-3 col-3">
                            <p>...................</p>
                        </div>
                    }

                </div>
            </div>

            <footer style=" width:100%; " class="footerRepeat" id="footer">
                <partial name="_printfooter" />
            </footer>
        </div>
    </section>
</div>

<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

@section Scripts
{
    <script type="text/javascript">
        //$(function () {
        //    $('.currentdate').html(GetNepaliCurrentDate());
        //});
        function Print() {
            var elementHTML = document.getElementById('contentToPrint').innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = elementHTML;
            window.print();
            //document.body.innerHTML = oldPage;
            window.location.reload(true);
        }
    </script>
}