@inject IUtility _Utility
@model FormatViewModel
@{
	var headerdata = await _Utility.GetHeaderData();
}

<style>

    .printpage {
        width: 21cm;
        min-height: 29.7cm;
        padding: 2cm;
        margin: 1cm auto;
        border: 1px #d3d3d3 solid;
        border-radius: 5px;
        background: #fff;
        box-shadow: 0 0 5px rgb(0 0 0 / 10%);
        font-family: 'kalimati regular' !important;
    }

    p {
        font-size: 18px;
    }

    .table tbody tr td {
        height: 3rem !important;
    }

</style>

<div class="d-flex justify-content-end">
    <button class="btn btn-primary mt-5" type="button" onClick="Print('contentToPrint')"><i class="fa fa-print" aria-hidden="true"></i> Print</button>
</div>
<div class="row" id="contentToPrint">
    <style>
        p {
            font-size: 18px;
        }

        .table tbody tr td {
            height: 3rem !important;
        }
    </style>
	<section style="page-break-after:always; padding-top:1cm">
		<div class="container">
			<h4 class="text-center"> प्राविधिक लगत इष्टमिट,डिजाइन तथा नक्सा निर्माणको लागि निवेदन </h4>
			<p style="float:right;">मिति:२०......./........../.........</p>
			<p style="text-align:justify;">
				श्री @headerdata.PalikaName,<br />
				@headerdata.Name <br />
				@headerdata.PalikaName @headerdata.Address, @headerdata.DistrictName ।
			</p>
			<h5 class="text-center"><u>बिषय: लागत अनुमान तयार गरिदिने सम्बन्धमा ।</u></h5>
			<p style="text-align:justify;">
				प्रस्तुत विषयमा यस @headerdata.PalikaName को गाउँसभा बाट आ.व.@Model.PlanningSamjhauta.FiscalYearName को लागि विनियोजन गरिएको बजेट रकमबाट @headerdata.PalikaName स्थित @Model.PlanningSamjhauta.YojanaWards को @Model.PlanningSamjhauta.YojanaAddress टोल/वस्तीको @Model.PlanningSamjhauta.YojanaNames
				योजनाको कार्य प्रारम्भ गर्नका लागी प्राविधिक लागत अनुमान लगायतको कार्य गर्नुपर्नेभएकोले लागत अनुमान गरिदिनु हुन तपसिलका कागजात सहित यो निवेदन पेश गरिएको बेहोरा अनुरोध छ ।
			</p>
			<p>तपसिल:</p>
			<ol style="list-style:none;">
				<li>१.	आम भेलाबाट उपभोक्ता समिति गठन गरेको बैठकको प्रमाणित प्रतिलिपि प्रत्यक्ष उपभोक्ता आमभेलाको फोटो सहित १ थान ।</li>
				<li>२.	उपभोक्ता समितिको निर्णयको प्रमाणित प्रतिलिपि ।</li>
				<li>३.	उपभोक्ता समिति सदस्यहरुको ना.प्र.प.को प्रमाणित प्रतिलिपि ।</li>
			</ol>
			<div class="row">
				<div class="col-md-4 col-4">
					<p>
						............................... <br />
						उ.स. सचिवको नाम थर:@Model.UpavoktaSamiti.Sachib <br />
						सम्पर्क नं.@Model.UpavoktaSamiti.SachibPhone <br />
						मिति:
					</p>
				</div>
				<div class="col-md-4 col-4"></div>
				<div class="col-md-4 col-4">
					<p>
						............................... <br />
						उ.स. अध्यक्षको नाम थर:@Model.UpavoktaSamiti.Adakshya <br />
						सम्पर्क नं.@Model.UpavoktaSamiti.AdakshyaPhone <br />
						मिति:
					</p>
				</div>
			</div>
		</div>
	</section>


	<section style="page-break-after:always; padding-top:1cm">
		<div class="container">
			<h3>योजनाको लगत इष्टिमेट,डिजाइन नक्सा यहाँ राख्नुहोला ।</h3>
		</div>
	</section>
</div>

<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

@section Scripts
{
	<script type="text/javascript">
		//$(function () {
		//    $('.currentdate').html(GetNepaliCurrentDate());
		//});
		function Print() {
			var elementHTML = document.getElementById('contentToPrint').innerHTML;
			var oldPage = document.body.innerHTML;
			document.body.innerHTML = elementHTML;
			window.print();
			//document.body.innerHTML = oldPage;
			window.location.reload(true);
		}
	</script>
}