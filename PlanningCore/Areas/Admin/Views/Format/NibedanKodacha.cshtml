@inject IUtility _Utility
@model FormatViewModel
@{
	var headerdata = await _Utility.GetHeaderData();
}

<style>

	.printpage {
		width: 21cm;
		min-height: 29.7cm;
		padding: 2cm;
		margin: 1cm auto;
		border: 1px #d3d3d3 solid;
		border-radius: 5px;
		background: #fff;
		box-shadow: 0 0 5px rgb(0 0 0 / 10%);
		font-family: 'kalimati regular' !important;
	}

	p {
		font-size: 18px;
	}

	.table tbody tr td {
		height: 3rem !important;
	}

</style>

<div class="d-flex justify-content-end">
	<button class="btn btn-primary mt-5" type="button" onClick="Print('contentToPrint')"><i class="fa fa-print" aria-hidden="true"></i> Print</button>
</div>
<div class="row" id="contentToPrint">
	<style>
		p {
			font-size: 18px;
		}

		.table tbody tr td {
			height: 3rem !important;
		}
	</style>
	<section style="page-break-after:always; padding-top:4px;">
		<div class="container">
			<h4 class="text-center" style="font-weight:bold;">योजना मुल्याङ्कनको लागि उ.स.ले पेश गर्ने निवेदनको ढाचाँ</h4>
			<p>
				श्री कार्यालय प्रमुख ज्यू,
			</p>
			<p>@headerdata.PalikaName </p>
			<p>@headerdata.Name </p>
			<p>@headerdata.Address, @headerdata.DistrictName ।</p>
			<h5 class="text-center" style="font-weight:bold;"><u>बिषयः योजना मुल्याङ्कन सम्बन्धमा ।</u></h5>
			<p style="text-align: justify">प्रस्तुत बिषयमा यस कार्यालयको आ.व. @Model.PlanningSamjhauta.FiscalYearName को बार्षिक बजेट मार्फत विनियोजित @Model.PlanningSamjhauta.YojanaWards @Model.PlanningSamjhauta.YojanaAddress
				टोल/समुदायमा रहेको @Model.PlanningSamjhauta.YojanaNames  योजना कार्यालयको नियम बमोजिम कार्यालय सँग योजनाको निर्माण कार्यका लागि मिति @Model.PlanningSamjhauta.Municipality_Manjuri_Date मा गरिएको सम्झौता अनुसारको निर्माण कार्य
				गरेको हुनाले सो कार्यको नाप जाँच गरी मुल्याङ्कन गरी दिनुहुन तपसिल बमोजिमका कागजातहरु यसै पत्र साथ संलग्न राखी यो निवेदन पेश गरेका छौ ।</p>
			<p style="font-weight: bold;">तपसिलः</p>
			<div class="fw-bold" style="text-indent: 15px;">
				<p>१)	उपभोक्ता समितिको बैठकबाट गरिएको निर्णयको प्रमाणित प्रतिलिपि ।</p>
				<p>२)	निर्माण कार्यको मुख्य मुख्य फोटोहरु ।</p>
				<p>३)	अन्य आवश्यक सम्पूर्ण कागजातहरु ।</p>
			</div>
			<p class="fw-bold" style="padding-top: 80px;">निवेदकहरुः </p>
			<div class="col-md-12 col-12 d-flex" style="justify-content:space-between;">
				<div>
					<p>उ.स. सचिवको नाम थर:@Model.UpavoktaSamiti.Sachib </p>
					<p>दस्तखत: </p>
					<p>मिति: </p>
					<p>सम्पर्क नं.@Model.UpavoktaSamiti.SachibPhone</p>
				</div>	
				<div>
					<p>उ.स अध्यक्षको नाम थर:@Model.UpavoktaSamiti.Adakshya </p>
					<p>दस्तखत: </p>
					<p>मिति: </p>
					<p>सम्पर्क नं.@Model.UpavoktaSamiti.AdakshyaPhone</p>
				</div>
			</div>
		</div>
	</section>

	<section style="page-break-after:always; padding-top:4px;">
		<div class="container">
			<h3 class="text-center">नापी किताब,कार्य मुल्याङ्कन फारम र कार्य सम्पन्न प्रतिवेदन</h3>
		</div>
	</section>
</div>

<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

@section Scripts
{
	<script type="text/javascript">
		//$(function () {
		//    $('.currentdate').html(GetNepaliCurrentDate());
		//});
		function Print() {
			var elementHTML = document.getElementById('contentToPrint').innerHTML;
			var oldPage = document.body.innerHTML;
			document.body.innerHTML = elementHTML;
			window.print();
			//document.body.innerHTML = oldPage;
			window.location.reload(true);
		}
	</script>
}