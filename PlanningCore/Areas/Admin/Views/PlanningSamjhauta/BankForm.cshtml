                    <br />
                    <p><b><u>तपसिल:</u></b></p>
                    <table class="border" style="text-align:center; width:100% !important;">
                        <tr>
                            <th style="border: 1px solid black !important; width:6rem;">क्र.स.</th>
                            <th style="border: 1px solid black !important; width:10rem;">नाम थर </th>
                            <th style="border: 1px solid black !important; width:10rem;">पद</th>
                            <th style="border: 1px solid black !important; width:10rem;">सम्पर्क नं.</th>
                        </tr>
                     
                        <tr>
                            <td style="border: 1px solid black !important; width:10rem;"> 1</td>
                            <td style="border: 1px solid black !important; width:10rem;"> @Model.samitiView.Adakshya</td>
                            <td style="border: 1px solid black !important; width:10rem;">अध्यक्ष</td>
                            <td style="border: 1px solid black !important; width:10rem;"> @Model.samitiView.AdakshyaPhone </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black !important; width:10rem;"> 2</td>
                            <td style="border: 1px solid black !important; width:10rem;">@Model.samitiView.Kosadakshya</td>
                            <td style="border: 1px solid black !important; width:10rem;">कोषाध्यक्ष</td>
                            <td style="border: 1px solid black !important; width:10rem;"> @Model.samitiView.KosadakshyaPhone </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid black !important; width:10rem;"> 3</td>
                            <td style="border: 1px solid black !important; width:10rem;">@Model.samitiView.Sachib</td>
                            <td style="border: 1px solid black !important; width:10rem;">सचिव</td>
                            <td style="border: 1px solid black !important; width:10rem;"> @Model.samitiView.SachibPhone </td>
                        </tr>
                       
                    </table><br /><br />
                    <div class="row">
                        <div class="col-md-4 col-4 offset-8" style="line-height:10px; text-align:center;">
                            <p>..........................................</p>
                            <p>@employee</p>
                            <p>@pada</p>
                        </div>
                    </div>
                    <footer style=" width:100%; " class="footerRepeat" id="footer">
                        <partial name="_printfooter" />
                    </footer>
                </div>
            </div>
        </div>
    }
</div>
<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />


@section Scripts
{
    <script>
        NepaliDatePickerCalWithClass(document.getElementsByClassName('PrintDate'))
    </script>
    <script>
        $('#PostId').change(function () {
            $.ajax({
                url: '@Url.Action("GetEmpNameByPostId", "Ajax", new { area = "" })',
                type: 'GET',
                data: { id: $(this).val() },
                success: function (data) {
                    $('#EmpId').empty().append("<option value=''>-नाम छान्नुहोस्-</option>");
                    $.each(data, function (index, item) {
                        $('#EmpId').append(`<option value="${item.Value}">${item.Text} </option>`);
                    });
                },
                error: function () {
                    alert('error in calling ajax !!');
                }
            });
        });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#PostId').val('@ViewBag.PostId');
            $('#EmpId').val('@ViewBag.EmpId').trigger('change');
                if ('@Model.PrintDate' != '') {
                $('.pDate').html('@Model.PrintDate')
            }
            $('#fiscalId').val('@ViewBag.fiscalId').trigger('change');
            $('#btnPrint').attr('style', "display: " + ('@ViewBag.fiscalId' != '' ? 'block' : 'none'));
            if ('@isSavedData' === 'True') {
                $.ajax({
                    url: '@Url.Action("GetPrintReportContent", "Ajax", new { area = "" })',
                    type: 'get',
                    data: { ReportName: '@ViewData["Title"]', PlanningSamjhautaId: '@Model.PlanningSamjhautaId' },
                    success: function (result) {
                        if (result) {
                            $('#contentToPrint').html(result);
                        }
                    },
                    error: function () {
                        alert('error in calling ajax !!')
                    }
                });
            }
        });


        function PrintContent(divele) {
            var elementHTML = document.getElementById(divele).innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = elementHTML;
            window.print();
            document.body.innerHTML = oldPage;
            window.location.reload();
        }

        function Print() {
            if ('@isSavedData' == 'True') {
                PrintContent('contentToPrint')
                return;
            }
            var printdata = $('#contentToPrint').html();
            var reportname = $('#reportname').html();
            var planningsamjhautaid = "@Model.PlanningSamjhautaId";
            $.ajax({
                url: '@Url.Action("PrintReport", "Ajax", new { area = "" })',
                type: 'post',
                data: { PrintContent: printdata, ReportName: '@ViewData["Title"]', PlanningSamjhautaId: planningsamjhautaid },
                success: function (result) {
                    if (result) {
                        PrintContent('contentToPrint')
                    }
                },
                error: function () {
                    alert('error in calling ajax !!')
                }
            });
        }
    </script>
}