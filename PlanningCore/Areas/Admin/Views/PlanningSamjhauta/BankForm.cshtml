                        position: relative !important;
                        bottom: 0px !important
                    }

                    .Header {
                        position: relative !important;
                        top: 0px !important
                    }


                    @@media print {
                        .footerRepeat {
                            position: fixed !important;
                            bottom: 0px !important
                        }

                        .Header {
                            position: fixed !important;
                            top: 0px !important
                        }

                        .print-body {
                            overflow: visible; /* Ensure full content is visible during printing */
                            margin-top: 230px !important; /* Matches header height */
                            margin-bottom: 30px !important; /* Matches footer height */
                            page-break-inside: auto;
                        }

                        .print-body1 {
                            overflow: visible; /* Ensure full content is visible during printing */
                            margin-top: 250px !important; /* Matches header height */
                            margin-bottom: 30px !important; /* Matches footer height */
                            page-break-inside: auto;
                        }
                    }
                </style>
                <div class="row">

                    <div class="Header">
                        <partial name="_PrintHeader" />
                    </div>

                </div>
                <div class="container print-body" style="color:black;">
                    @* <div class="d-flex p-1 text-center justify-content-end align-items-center">
						<span style="text-align:end">मिति:- @_utility.ConvertEnglishToNepali(Model.PrintDate)  </span>
					</div> *@
                    <div class="sign mt-2" style="font-weight:500; font-size:16px; line-height:13px;">
                        <p>श्री @Model.samitiView.BankName, शाखा कार्यालय</p>
                        <p>@Model.samitiView.BankAddress</p>
                    </div>
                    <p style="text-align:center; font-weight:500; font-size:16px; padding-top:15px;">
                        <span id="reportname"> <u> बिषय : खाता सञ्चालन गरिदिने सम्बन्धमा । </u> </span>
                    </p>
                    @* <p style="text-indent:24px; letter-spacing:1px; line-height:30px; font-weight:500; font-size:16px; padding-top:15px; text-align:justify !important; ">
						प्रस्तुत विषयमा यस @orgname.PalikaName को लागि चालु आ.ब.<strong>@Model.FiscalYearName</strong>
						मा स्वीकृत भएको     <strong>@Model.YojanaNames</strong> योजना रकम रु
						<strong>@_utility.ConvertEnglishToNepali(Model.Project_estimated_Amount) </strong> बिनियोजन भएको र उक्त योजनाको
						लागि <strong>@Model.Samjhauta_Org_Name</strong> गठन भएको हुदाँ समितिको
					    अध्यक्ष <strong>  @Model.samitiView.Adakshya </strong> , कोषाध्यक्ष <strong>@Model.samitiView.Kosadakshya </strong>
						र सचिब <strong>@Model.samitiView.Sachib</strong> को संयुक्त दस्तखत बाट त्यस बैंकमा चल्ति खाता खोलिदिनुहुन अनुरोध छ ।
					</p> *@
                    <p style="text-align:justify;">
                        प्रस्तुत बिषयमा यस @orgname.PalikaName<nobr></nobr>को आ.व @Model.FiscalYearName मा गाउँसभा/संघ/प्रदेश स्तरबाट
                        यस @orgname.PalikaName अर्न्तगत @Model.YojanaWards<nobr></nobr>को
                        <b>@Model.YojanaNames</b>
                        योजनालाई विनियोजित रकम रु <b>@Model.Project_estimated_Amount  (अक्षरुपी @_utility.ConvertNumberToNepaliText(Model.Project_estimated_Amount.ToString()))</b>  मिति <b>@Model.samitiView.NepaliSamitiEstdDate</b> गतेका
                        दिन उपभोक्ता समिति गठन गरि यस कार्यालयमा उक्त योजनाको योजना सम्झौता समेत भैसकेकोले उक्त योजनाको कार्य सम्पन्‍न
                        गरि रकम निकासा गर्ने प्रयोजनको लागि उक्त उपभोक्ता समितिको तपशिल बमोजिमका पदाधिकारीहरूको संयूक्त दस्तखतमा खाता
                        संञ्‍चालन गर्ने गरि नमुना दस्तखत कार्ड प्रमाणित गरि @Model.samitiView.BankName, @Model.samitiView.BankAddress शाखामा
