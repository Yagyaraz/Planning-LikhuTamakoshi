<div class="col-md-12 col-12" style="margin-top:66px;">
	<div class="d-flex p-1 text-center justify-content-start align-items-center">
		<img width="120" src="~/Images/NepalLogo.png" />

		<div class="row" style="align-content:center;">
			<h4>@headerData.PalikaName<br />@headerData.PalikaNameEng</h4>
			<h3>@headerData.Name <br />@headerData.PalikaTypeNameEng</h3>
			<h4>@headerData.Address,@headerData.DistrictName (@headerData.Address2,@headerData.DistrictNameEng)</h4>
			<h4>@headerData.StateName, नेपाल (@headerData.StateNameEng, Nepal)  </h4>
			<br />
		</div>
		<div class="col-md-2 col-2" style="text-align:end;">
			<img width="120" src="@headerData.LogoPath" />
		</div>
	</div>
</div>

<hr style="color:#8B0000; height:2px;" ; />

