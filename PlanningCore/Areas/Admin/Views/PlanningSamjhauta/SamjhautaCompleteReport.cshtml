                                        <span> १. घरपरिवार संख्याः @_Utility.ConvertEnglishToNepali(Model.Total_House) </span>
                                    </div>
                                    <div class="d-flex justify-content-start">
                                        <span> २. जनसंख्याः- @_Utility.ConvertEnglishToNepali(polulation)  </span>
                                    </div>
                                    <div class="d-flex justify-content-start">
                                        <span> ३. संगठित संस्था:- @Model.Community </span>
                                    </div>
                                    <div class="d-flex justify-content-start">
                                        <span> ४. अन्यः- @Model.Other </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="point3 print-body1">
                            <div class="d-flex justify-content-start">
                                <span style="page-break-before:always">३. उपभोक्ता समिति /गैर सरकारी संस्था /समुदायमा आधारीत संस्था सम्बन्धी विवरण :</span>
                            </div><br />
                            <div class="accordion-body1" style="margin-left: 22px;">
                                <div class="accordion-body1" style="margin-left: 24px;">
                                    @{
                                        var i = 1;
                                    }
