@inject IUtility _Utility
@model PlanningSamjhautaViewModel
@{
    var orgname = await _Utility.GetMainSettingById(0);
    var worktype = (Model.WorkTypeId == 1) ? "उपभोक्ता समिति" : (Model.WorkTypeId == 2) ? "टोल बिकास समिति" : "विद्यालय व्यवस्थापन समिति";
    var polulation = Model.Total_Female + Model.Total_Male;
}
<style>
    table {
        border-collapse: collapse !important;
        width: 80% !important;
        border: 1px solid black !important;
    }

    .tbl {
        font-weight: bold !important;
    }

    th, td {
        border: 1px solid black !important;
        padding: 8px !important;
        text-align: center !important;
    }

    span {
        font-weight: bold;
    }

    accordion-body1 {
        padding: 0.5rem 1.25rem;
    }

    .printpage {
        width: 21cm;
        min-height: 29.7cm;
        padding: 2cm;
        margin: 1cm auto;
        border: 1px #d3d3d3 solid;
        border-radius: 5px;
        background: #fff;
        box-shadow: 0 0 5px rgb(0 0 0 / 10%);
        font-family: 'kalimati regular' !important;
    }

    @@media print {
        table {
            border-collapse: collapse !important;
            width: 80% !important;
            border: 1px solid black !important;
        }

        .tbl {
            font-weight: bold !important;
        }

        th, td {
            border: 1px solid black !important;
            padding: 8px !important;
            text-align: center !important;
        }
   
    }

</style>

<div class="container mt-3">
    <div class="text-end pt-3">
        <button class="btn btn-primary mt-3 " type="button" onClick="Print('contentToPrint')">
            <i class="fa fa-print" aria-hidden="true"></i> Print
        </button>
    </div>
    <div class="row" id="contentToPrint">
        <div class="card-body printpage">
