                                <p>नामः-@Model.RepresentativeName </p>
                                <p>पदः-@Model.RepresentativeDesignition </p>
                                <p>हस्ताक्षरः-</p>
                            </div>
                            @if(Model.SifarisGarneId !=null)
                            {
                                <div >
                                    <p> <b>योजना शाखाको तर्फवाटः</b> </p>
                                    <p>नामः-@Model.SifarishGarneName </p>
                                    <p>पदः-@Model.SifarishGarnePost</p>
                                    <p>हस्ताक्षरः-</p>
                                </div>
                                <div >
                                        <p><b>@orgname.PalikaName को तर्फवाटः</b></p>
                                        <p>नामः-@Model.SwikritGarneName </p>
                                        <p>पदः-@Model.SwikritGarnePost</p>
                                        <p>हस्ताक्षरः-</p>
                                 
                                </div>
                            }
                            
                           @*  @if(Model.WardSifarishId != null)
                            {
                                <div class="col-md-3 col-3 offset-1 mt-1">
                                    <p><b>वडा कार्यलयको तर्फवाटः</b>  </p>
                                    <p>नामः-@Model.WardSwikitPost </p>
                                    <p>पदः-@Model.WardSwikritName</p>
                                    <p>हस्ताक्षरः-</p>
                                </div>
                                <div class="col-md-4 col-4 mt-1">
                                    <p><b>वडा कार्यलयको तर्फवाटः</b>  </p>
                                    <p>नामः-@Model.WardSifarishPost </p>
                                    <p>पदः-@Model.WardSifarishName</p>
                                    <p>हस्ताक्षरः-</p>
                                </div>
                            } *@
                       
                        </div>
                    </div>
                    
                </div>
                <footer style=" width:100%; " class="footerRepeat" id="footer">
                    <partial name="_printfooter" />
                </footer>
            </div>
        </div>
        @* <footer style="position:relative; bottom:0;">
            <partial name="_printfooter" />
        </footer> *@
    </div>
</div>

@section Scripts {
    <script>
        function Print(divele) {
            var elementHTML = document.getElementById(divele).innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = elementHTML;
            window.print();
            document.body.innerHTML = oldPage;
        }
    </script>
    <script>
        function Print() {
            debugger;
            var printdata = $('#contentToPrint').html();
            var reportname = $('#reportname').html();
            var planningsamjhautaid = "@Model.PlanningSamjhautaId";
            $.ajax({
                url: '@Url.Action("PrintReport", "Ajax", new { area = "" })',
                type: 'post',
                data: { PrintContent: printdata, ReportName: reportname, PlanningSamjhautaId: planningsamjhautaid },
                success: function (result) {
                    if (result) {
                        var elementHTML = document.getElementById('contentToPrint').innerHTML;
                        var oldPage = document.body.innerHTML;
                        document.body.innerHTML = elementHTML;
                        window.print();
                        document.body.innerHTML = oldPage;
                    }
                },
                error: function () {
                    alert('error in calling ajax !!')
                }
            });
        }


    </script>

}