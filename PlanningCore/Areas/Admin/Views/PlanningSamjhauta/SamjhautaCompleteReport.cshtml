                                            <td>क्र.सं.</td>
                                            <td>नाम</td>
                                            <td>पद</td>
                                            <td>ठेगाना</td>
                                            <td>नागरिकता नं</td>
                                            <td>सम्पर्क नं.</td>
                                        </tr>
