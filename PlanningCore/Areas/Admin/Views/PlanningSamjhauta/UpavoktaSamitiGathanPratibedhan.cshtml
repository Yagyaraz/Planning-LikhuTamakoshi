@inject IUtility _utility
@model PlanningSamjhautaViewModel
@{
	ViewData["Title"] = "UpavoktaSamitiGathanPratibedhan";
	var orgname = await _utility.GetMainSettingById(0);
	var worktype = (Model.WorkTypeId == 1) ? "उपभोक्ता समिति" : "टोल बिकास समिति";
	var Adakshya = Model.samitiView.samitiMemberDetaillist.Select(x => x.Adakshya).FirstOrDefault();
	int? post = ViewBag.EmpId;
	var pada = await _utility.GetPostById(ViewBag.PostId);
	var employee = await _utility.GetEmpNameById(post);
	bool isSavedData = Convert.ToBoolean(ViewBag.isSavedData);
	var headerData = await _utility.GetHeaderData();
	var fiscal = await _utility.GetCurrentFiscalYearName();
}
<style>
	table {
		border-collapse: collapse !important;
		width: 80% !important;
		border: 1px solid black !important;
	}

	.tbl {
		font-weight: bold !important;
	}

	th, td {
		border: 1px solid black !important;
		padding: 8px !important;
		text-align: center !important;
	}

	span {
		font-weight: bold;
	}

	accordion-body1 {
		padding: 0.5rem 1.25rem;
	}

	.printpage {
		width: 21cm;
		min-height: 29.7cm;
		padding: 2cm;
		margin: 1cm auto;
		border: 1px #d3d3d3 solid;
		border-radius: 5px;
		background: #fff;
		box-shadow: 0 0 5px rgb(0 0 0 / 10%);
		font-family: 'kalimati regular' !important;
	}

	@@media print {
		table {
			border-collapse: collapse !important;
			width: 80% !important;
			border: 1px solid black !important;
		}

		.tbl {
			font-weight: bold !important;
		}

		th, td {
			border: 1px solid black !important;
			padding: 8px !important;
			text-align: center !important;
		}
	}

</style>

@if (!isSavedData)
{
	<div class="container pt-4 mt-4">
		<form asp-action="@ViewData["Title"]" method="get">
			<div class="pt-4 row">
				<div class="col-2">
					<label>पद</label>
					<select name="PostId" id="PostId" asp-items="@await _utility.GetPadaList()" required class="form-control">
						<option value="">--पद छान्नुहोस--</option>
					</select>
				</div>
				<div class="col-2">
					<label>नाम</label>
					<select name="EmpId" id="EmpId" asp-items="@await _utility.GetEmpNameByPostId(ViewBag.PostId)" required class="form-control">
						<option value="">--नाम छान्नुहोस--</option>
					</select>
				</div>
				<div class="col-md-2 col-2">
					<label>मिति : </label> <br />
					<input type="text" name="PrintDate" required class="form-control PrintDate" value="@Model.PrintDate" />
				</div>

				<div class="col-2">
					<label> </label><br />
					<input type="submit" value="खोज्नुहोस्" class="btn btn-success" />
				</div>
			</div>
		</form>
	</div>
}

<button style="float:right; margin-top:50px !important;" class="btn btn-primary mt-2" type="button" onClick="Print('contentToPrint')"><i class="fa fa-print" aria-hidden="true"></i> Print</button>
<div class="row" id="contentToPrint">
	@if (!isSavedData)
	{
		<div class="card-body printpage">
			<div class="printcontent">
				<style>
					.footerRepeat {
						position: relative !important;
						bottom: 0px !important
					}

					.Header {
						position: relative !important;
						top: 0px !important
					}


					@@media print {
						.footerRepeat {
							position: fixed !important;
							bottom: 0px !important
						}

						.Header {
							position: fixed !important;
							top: 0px !important
						}

						.print-body {
							overflow: visible; /* Ensure full content is visible during printing */
							margin-top: 300px !important; /* Matches header height */
							margin-bottom: 30px !important; /* Matches footer height */
							page-break-inside: auto;
						}

						.print-body1 {
							overflow: visible; /* Ensure full content is visible during printing */
							margin-top: 300px !important; /* Matches header height */
							margin-bottom: 30px !important; /* Matches footer height */
							page-break-inside: auto;
						}
					}
				</style>
				<div class="row">
					<div class="Header">
						<div class="col-md-12 col-12" style="font-family:kalimati regular !important">
							<div class="row">
								<div class="col-md-2 col-2">
									<img width="120" src="~/Images/NepalLogo.png" />
								</div>
								<div class="col-md-8 col-8" style="text-align:center; color:red;">
									@* <h3>स्थानीय सरकार</h3>
									<h3>Local Government</h3> *@
									<h3>@headerData.PalikaName</h3>
									<h3>@headerData.PalikaNameEng</h3>
									<h1>@Model.YojanaWards</h1>
									<h2 style="font-family:Open Sans">@Model.YojanaWardsEng </h2>
									<h4>@Model.WardAddress, @headerData.DistrictName (@Model.YojanaAddressEng,@headerData.DistrictNameEng)  </h4>
									<h4>@headerData.StateName, नेपाल (@headerData.StateNameEng,Nepal) </h4>
								</div>
								<div class="col-md-2 col-2" style="text-align:end;">
									<img width="120" src="@headerData.LogoPath" />
								</div>
							</div>
						</div>

						<div class="row">
							<div class="col-md-6 col-6">
								<span style="margin-left:5px;">
									<span style="color:red;">पत्र संख्या (Ref No):- <b style="color:black;"> @fiscal</b> </span>  <br />
									<span style="color:red; margin-left:5px;">चलानी नम्बर (Dispatch No):-</span>
								</span>
							</div>
							<div class="col-md-6 col-6">
								<br />
								<span style="float:right;"> <span style="color:red;">मिति (Date):- </span> <b class="pDate" style="color:black;"></b> </span>
							</div>
						</div>
						<div style="border-top:5px solid red; width:100%;"></div>
						<br />
					</div>
				</div>
				<div class="container print-body" style="color:black;">
					<div class="sign mt-2" style="font-weight:500; font-size:16px; line-height:12px;">
						<p>श्री प्रमुख प्रशासकीय अधिकृत ज्यू, </p>
						<p>@orgname.Name </p>
						<p>@orgname.Address </p>
					</div>
					<p style="text-align:center; font-weight:500; font-size:16px;">
						<span id="reportname"> <u>  विषय: उपभोक्ता समिति गठन गरेको प्रतीबेदन पेश गरेको सम्बन्धमा । </u> </span>
					</p>
					<p style="text-indent:24px; letter-spacing:1px; line-height:27px; font-weight:500; font-size:16px; text-align:justify !important; ">
						उपरोक्त सम्बन्धमा यस @orgname.Name @orgname.PalikaTypeName सभाबाट चालु आ.ब
						@Model.FiscalYearName को लागि स्वीकृत भएको यस को वडा न. @Model.YojanaAddress मा
						<b>@Model.YojanaNames</b> योजना कार्यक्रम छनौट भई प्राथामिकतामा परेको हुँदा स्थानीय
						तहको उपभोक्ता समिति गठन परिचालन तथा ब्यावस्थापन सम्बन्धी कार्यविधि २०७६ को
						दफा ४ बमोजिम उक्त आयोजनाबाट प्रत्यक्ष लाभान्वित हुने परिवारको
						पहिचान गरी त्यस्ता घर परिवारको  आमभेलाबाट सम्बन्धित आयोजना स्थलमै श्री @Model.samitiView.Adakshya को
						अध्यक्षतामा मिति <b>@Model.samitiView.NepaliSamitiEstdDate</b>  मा उपभोक्ता समिति गठन भएको व्यहोरा अनुरोध छ ।
					</p>
					<table class="border" style="text-align:center; width:100% !important;">
						<tr>
							<th style="border: 1px solid black !important; width:6rem;">क्र.स.</th>
							<th style="border: 1px solid black !important; width:10rem;">नाम</th>
							<th style="border: 1px solid black !important; width:10rem;">पद</th>
							<th style="border: 1px solid black !important; width:10rem;">ठेगाना</th>
							<th style="border: 1px solid black !important; width:10rem;">सम्पर्क नं.</th>
						</tr>
						@foreach (var item in Model.samitiView.samitiMemberDetaillist)
						{							
							<tr>
								<td style="border: 1px solid black !important; width:10rem;">@(Model.samitiView.samitiMemberDetaillist.ToList().IndexOf(item) + 1)</td>
								<td style="border: 1px solid black !important; width:10rem;">@item.MemberName</td>
								<td style="border: 1px solid black !important; width:10rem;">@item.PadaName</td>
								<td style="border: 1px solid black !important; width:10rem;">@item.Address</td>
								<td style="border: 1px solid black !important; width:10rem;">@item.PhoneNo</td>
							</tr>
						}
					</table>
					<br />
					<br />
					<div class="row">
						<div class="col-md-4 col-4 offset-8" style="line-height:8px; text-align:center;">
							<p>..........................................</p>
							<p>@employee</p>
							<p>@pada</p>
						</div>
					</div>
				</div>
				<footer style=" width:100%; " class="footerRepeat" id="footer">
					<partial name="_printfooter" />
				</footer>
			</div>
		</div>
	}
</div>
<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />


@section Scripts
{
	<script>
		NepaliDatePickerCalWithClass(document.getElementsByClassName('PrintDate'))
	</script>
	<script>
		$('#PostId').change(function () {
			$.ajax({
				url: '@Url.Action("GetEmpNameByPostId", "Ajax", new { area = "" })',
				type: 'GET',
				data: { id: $(this).val() },
				success: function (data) {
					$('#EmpId').empty().append("<option value=''>-नाम छान्नुहोस्-</option>");
					$.each(data, function (index, item) {
						$('#EmpId').append(`<option value="${item.Value}">${item.Text} </option>`);
					});
				},
				error: function () {
					alert('error in calling ajax !!');
				}
			});
		});
	</script>
	<script type="text/javascript">
		$(document).ready(function () {
			$('#PostId').val('@ViewBag.PostId');
			$('#EmpId').val('@ViewBag.EmpId').trigger('change');
					if ('@Model.PrintDate' != '') {
			$('.pDate').html('@Model.PrintDate')
		}
			$('#fiscalId').val('@ViewBag.fiscalId').trigger('change');
			$('#btnPrint').attr('style', "display: " + ('@ViewBag.fiscalId' != '' ? 'block' : 'none'));
			if ('@isSavedData' === 'True') {
				$.ajax({
					url: '@Url.Action("GetPrintReportContent", "Ajax", new { area = "" })',
					type: 'get',
					data: { ReportName: '@ViewData["Title"]', PlanningSamjhautaId: '@Model.PlanningSamjhautaId' },
					success: function (result) {
						if (result) {
							$('#contentToPrint').html(result);
						}
					},
					error: function () {
						alert('error in calling ajax !!')
					}
				});
			}
		});

		function PrintContent(divele) {
			var elementHTML = document.getElementById(divele).innerHTML;
			var oldPage = document.body.innerHTML;
			document.body.innerHTML = elementHTML;
			window.print();
			document.body.innerHTML = oldPage;
			window.location.reload();
		}

		function Print() {
			if ('@isSavedData' == 'True') {
				PrintContent('contentToPrint')
				return;
			}
			var printdata = $('#contentToPrint').html();
			var reportname = $('#reportname').html();
			var planningsamjhautaid = "@Model.PlanningSamjhautaId";
			$.ajax({
				url: '@Url.Action("PrintReport", "Ajax", new { area = "" })',
				type: 'post',
				data: { PrintContent: printdata, ReportName: '@ViewData["Title"]', PlanningSamjhautaId: planningsamjhautaid },
				success: function (result) {
					if (result) {
						PrintContent('contentToPrint')
					}
				},
				error: function () {
					alert('error in calling ajax !!')
				}
			});
		}
	</script>
}