@model PlanningDocumentUploadedViewModel
@{
    ViewData["Title"] = "कागजात Upload";
}


<div class="container-fluid colr1">
    <div class="row">
        <form asp-action="CreatePlanningDocument" enctype="multipart/form-data">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-row">
                            <div class="col-md-12">
                                <input asp-for="Id" type="hidden" />
                                <input asp-for="PlanningSamjhuataId" type="hidden" />
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="border-radius-4 box-shadow">
                                <div class="form-container mt-4">
                                    <h3> कागजातहरु upload गर्नुहोस </h3>
                                    <div class="row">
                                        <div class="col-sm-12 col-12">
                                            <div class="btitle">
                                            </div>
                                            <button type="button" id="docsAdd" class="btn btn-add btn-sm"
                                                    style="background-color:green; color: #fff; padding: 7px 12px;  margin-bottom: 5px; float:right;">
                                                <i class="fa fa-plus"> </i> कागजात थप्नुहोस
                                            </button>
                                        </div>
                                        <div class="col-lg-12 col-sm-12 col-12" id="docsdiv">
                                            <div class="col-lg-12 col-sm-12 col-12">
                                                @if (Model.DocumentsList.Count > 0)
                                                {
                                                    foreach (var items in Model.DocumentsList)
                                                    {
                                                        <partial name="_AddPlanningDocuments.cshtml" model="@items" />
                                                    }

                                                }
                                                else
                                                {
                                                    <partial name="_AddPlanningDocuments.cshtml" model="@new PlanningDocumentUploadedViewModel()" />
                                                }
                                            </div>
                                        </div>
                                        <hr class="mt-4" />

                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="border-top">
                            <div class="card-body d-flex gap-2 justify-content-end">
                                <button type="submit" class="btn btn-success btn-sm mt-3 mb-2 text-white">
                                    <i class="fa fa-check" aria-hidden="true"> सुरक्षित गर्नुहोस </i>
                                </button>
                                <a asp-action="BankGuaranteeIndex" asp-controller="BankGuarantee" asp-area="Contract" class="btn  btn-sm mt-3 mb-2 text-white"
                                   style=" background-color:#424f63;">
                                    <i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
