@model PlanningBhuktaniViewModel
@inject IUtility _Utility
@{
	ViewData["Title"] = "Index";
	<style>
		.oval-button {
		border-radius: 25px;
		}

		#zero_config > thead > tr > th {
		font-weight:bold;


		}

		table.table-bordered.dataTable th, table.table-bordered.dataTable td{
		border-left-width: thin;
		}

		table.table-bordered.dataTable th:last-child, table.table-bordered.dataTable th:last-child, table.table-bordered.dataTable td:last-child, table.table-bordered.dataTable td:last-child{
		border-right-width:thin;
		}
	</style>

}

<div class="page-breadcrumb colr1">
	<div class="row">
		<div class="col-12 d-flex no-block align-items-center">
			
			<div class="ms-auto text-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
						<li class="breadcrumb-item active" aria-current="page">
							
								<span>भुक्तानि</span>
							
							
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid colr1">
	<div class="row">
		<div class="col-md-12">
			<div class="d-flex justify-content-between">
				<div style="display:flex;">
					<h4 class="card1" style="background-color:#3c8dbc; color:#fff; height:40px; width:100px; padding-top:5px; text-align:center;">भुक्तानि</h4>
					<span style="height:2rem; background-color:#3c8dbc; width:10px; height:40px;"></span>
					<span style="height: 2rem; border-top: 17px solid transparent;border-left: 25px solid #3c8dbc;border-bottom: 22px solid transparent; height:40px;"> </span>
				</div>
				<a asp-controller="Planningsamjhauta" asp-action="CreateBhuktani" asp-area="Admin" class="btn btn-success btn-sm " asp-route-PlanningSamjhautaid="@Model.PlanningSamjhautaId" style="padding-top:5px; height:2rem;  background-color: #33b35a; border: 1px solid #3ec291;">
					<i class="fas fa-plus-circle"></i> नयाँ राख्नुहोस </a>
			</div>
			<br />
			<div class="card">
				<div class="card-body">
					<div class="table-responsive">
						<table  id="zero_config" class="table table-striped table-bordered border-primary" style="border-collapse:collapse!important">
							<thead>
								@{
									int i = 1;
								}
								<tr>
									<th  style="text-align:center;">क्र.स.</th>
									<th  style="text-align:center;"> @Html.DisplayNameFor(model => model.Aayojana_Karyakram)</th>
									<th  style="text-align:center;"> @Html.DisplayNameFor(model => model.Nirman_Upabhokta)</th>									
									<th  style="text-align:center;"> @Html.DisplayNameFor(model => model.Remaining_Bhuktani_Amount)</th>
									<th  style="text-align:center;"> @Html.DisplayNameFor(model => model.Katti_Rakam)</th>
									<th  style="text-align:center;"> @Html.DisplayNameFor(model => model.SamjhautaDate)</th>
									<th  style="text-align:center;">कार्य</th>

								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model.PlanningBhuktaniList)
								{
									<tr>
										<td  style="text-align:center;">@_Utility.ConvertEnglishToNepali(i)</td>
										<td  style="text-align:start;">@Html.DisplayFor(modelItem => item.Aayojana_Karyakram)</td>
										<td  style="text-align:start;">@Html.DisplayFor(modelItem => item.Nirman_Upabhokta)</td>									
										<td  style="text-align:center;">@Html.DisplayFor(modelItem => item.Remaining_Bhuktani_Amount)</td>
										<td  style="text-align:center;">@Html.DisplayFor(modelItem => item.Katti_Rakam)</td>
										<td  style="text-align:center;">@Html.DisplayFor(modelItem => item.SamjhautaDate)</td>
										<td class="d-flex" style="text-align:center; height:50px!important; border-top:none!important; border-left:none!important; border-bottom:none!important;">
											<a type="button" id="सच्याउनुहोस" class="btn btn-sm" title="सच्याउनुहोस" asp-action="CreateBhuktani" asp-route-PlanningSamjhautaid="@Model.PlanningSamjhautaId" asp-route-id="@item.PlanningBhuktaniId">
												<i class="fa fa-edit d-flex" style="font-size:13px"> </i>
											</a>
											<a type="button" id="विवरण" class="btn btn-sm" title="विवरण" asp-action="BhuktaniReport" asp-route-pid="@item.PlanningSamjhautaId" asp-route-id="@item.PlanningBhuktaniId">
												<i class="fa fa-list d-flex" style="font-size:13px"> </i>
											</a>
											<a type="button" id="भुक्तानीको लागि सिफारिस" class="btn btn-sm" title="भुक्तानीको लागि सिफारिस" asp-action="BhuktaniKoLagiSifarish" asp-route-id="@item.PlanningSamjhautaId">
												<i class="fab fa-stack-exchange"></i>
											</a>
											<a type="button" id="अनुगमन सिफारिश" class="btn btn-sm" title="अनुगमन सिफारिश" asp-action="BhuktaniKoLagiSifarish" asp-route-id="@item.PlanningSamjhautaId">
												<i class="fa fa-money-bill-alt d-flex"></i>
											</a>

											<a onclick="return confirm(' के तपाइँ निश्चित रद्द गर्न चाहानुहुन्छ??')" title="Delete" asp-action="DeleteBhukatani" asp-area="Admin"
											   class="btn btn-sm " asp-route-id="@item.PlanningBhuktaniId">
												<i class="fas fa-trash" style="color:red; font-size:13px;">
												</i>
											</a>
										</td>

									</tr>
									i++;

								}
							</tbody>

						</table>
						<div class=" d-flex justify-content-end">
							<a asp-action="PlanningsamjhautaIndex" asp-controller="Planningsamjhauta" asp-area="Admin" class="btn  btn-sm mt-3 mb-2 me-2 text-white"
							   style=" background-color:#424f63;">
								<i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	<script>
		$("#zero_config").DataTable();
	</script>
	<script>
		$(function () { Message('@TempData["Msg"]') });
	</script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/js/all.min.js"></script>

}