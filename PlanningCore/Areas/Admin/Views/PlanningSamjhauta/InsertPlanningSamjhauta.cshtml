@model PlanningSamjhautaViewModel
@inject IUtility _Utility
@{
    ViewData["Title"] = "Index";
    var orgname = await _Utility.GetMainSettingById(0);
    decimal marmat = 0;
    decimal contenjency = 0;
    int swikrit = Model.SwikritGarnePadId ?? 0;
    int sifaris = Model.SifarisGarnePadId ?? 0;
    int wardsifaris = Model.WardSifarishPadId ?? 0;
    int wardswikrit = Model.WardSwikritPadId ?? 0;
    @if (Model.TaxList.Count > 0)
    {
        foreach (var item in Model.TaxList)
        {
            Model.Contegency_Percentage = item.Kantigenci;
            Model.MarmatSambhar_Amount = item.MarmatSambar;
            marmat = item.MarmatSambar;
            contenjency = item.Kantigenci;
        }
    }

}

