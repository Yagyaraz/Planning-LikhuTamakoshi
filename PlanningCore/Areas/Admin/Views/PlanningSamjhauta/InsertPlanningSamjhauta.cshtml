<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

@section Scripts {
    <script src="~/template/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet"> </script>
    <script src="~/template/assets/libs/select2/dist/js/select2.min.js"></script>


    <script>
        $("#WorkTypeId").change(function () {
            WorkTypFun();
        });
        function WorkTypFun() {
            var data = $("#WorkTypeId").val();

            if (parseInt(data) == 1) {
                $("#tolBikash").hide();
                $("#newtolbikash").hide();
                $("#upavokta").show();

                $.ajax({
                    url: '@Url.Action("GetSamitiPost", "Ajax", new { area = "" })',
                    type: 'GET',
                    success: function (data) {
                        $('#reppost').empty().append("<option value=''>-छान्नुहोस्-</option>");
                        $.each(data, function (index, item) {
                            $('#reppost').append(`<option value="${item.Value}">${item.Text} </option>`);
                        });
                        $('#signpost').empty().append("<option value=''>-छान्नुहोस्-</option>");
                        $.each(data, function (index, item) {
                            $('#signpost').append(`<option value="${item.Value}">${item.Text} </option>`);
                        });
                        $('#reppost').val('@Model.RepresentativePostId')
