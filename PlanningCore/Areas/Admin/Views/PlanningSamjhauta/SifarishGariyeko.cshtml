					</div>
				</div>
				<div class="row">
					@foreach (var item in Model.AnugamanSamitiSetup.AnugamanSamitiListPalika)
					{
						<div class="col-md-4 col-4">

							<p>@item.Name </p>
						</div>
						<div class="col-md-2 col-2">
							<p>&nbsp;</p>

						</div>
						<div class="col-md-3 col-3">
							<p>@item.PostName</p>

						</div>
						<div class="col-md-3 col-3">
							<p>...................</p>
						</div>
