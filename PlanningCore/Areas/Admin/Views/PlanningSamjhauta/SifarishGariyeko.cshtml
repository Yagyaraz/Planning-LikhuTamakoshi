			<div class="printcontent">
				<div class="row">
					<div class="Header">
						<partial name="_PrintHeader" />
					</div>
				</div>
				@* <div class="container" style="color:black;">

					<div class="sign mt-2" style="font-weight:500; font-size:16px; line-height:13px;">
						<p>@orgname.PalikaName, @orgname.Name</p>
