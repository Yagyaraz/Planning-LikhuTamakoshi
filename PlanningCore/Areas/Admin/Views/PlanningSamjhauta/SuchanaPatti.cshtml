@inject IUtility _utility
@model PlanningSamjhautaViewModel
@{
	ViewData["Title"] = "BankClose";
	var orgname = await _utility.GetMainSettingById(0);
	int? post = ViewBag.PostId;
	var pada = await _utility.GetPostById(ViewBag.PostId);
	var employee = await _utility.GetEmpNameById(post);
	bool isSavedData = Convert.ToBoolean(ViewBag.isSavedData);
}

<style>
	table {
		border-collapse: collapse !important;
		width: 80% !important;
		border: 1px solid black !important;
	}

	.tbl {
		font-weight: bold !important;
	}

	th, td {
		border: 1px solid black !important;
		padding: 8px !important;
		text-align: center !important;
	}

	span {
		font-weight: bold;
	}

	accordion-body1 {
		padding: 0.5rem 1.25rem;
	}

	.printpage {
		width: 21cm;
		min-height: 29.7cm;
		padding: 2cm;
		margin: 1cm auto;
		border: 1px #d3d3d3 solid;
		border-radius: 5px;
		background: #fff;
		box-shadow: 0 0 5px rgb(0 0 0 / 10%);
	}

	@@media print {
		table {
			border-collapse: collapse !important;
			width: 80% !important;
			border: 1px solid black !important;
		}

		.tbl {
			font-weight: bold !important;
		}

		th, td {
			border: 1px solid black !important;
			padding: 8px !important;
			text-align: center !important;
		}
	}

</style>

<button style="float:right" class="mt-2" type="button" onClick="Print('contentToPrint')"><i class="fa fa-print" aria-hidden="true"></i> Print</button>
<div class="row" id="contentToPrint">
	@if (!isSavedData)
	{
		<div class="card-body printpage">
			<div class="printcontent">
				<div class="row">

					<div class="Header">
						सूचना पाटी
					</div>

				</div>
				<div class="container">

					<p style="text-indent:24px; letter-spacing:1px; line-height:30px; font-weight:500; font-size:16px; padding-top:15px; text-align:justify !important; ">
						श्री @orgname.PalikaName @Model.YojanaWards कार्यालय @orgname.DistrictName
					</p>
					<table>
						<tbody>
							<tr>
								<td>योजनाको नाम : @Model.YojanaNames </td>
								<td>बजेट</td>
							</tr>
							<tr>
								<td>बडा नं. : @Model.YojanaWards </td>
								<td>१. गाउँपालिका वडा कार्यालयबाट रु. : </td>
							</tr>
							<tr>
								<td>नगरपालिका : @orgname.PalikaName </td>
								<td>२. अन्य : </td>
							</tr>
							<tr>
								<td>उ.स.अ.को नाम : @Model.Samjhauta_Org_Name </td>
								<td>क. जन सह‌भागिता रु </td>
							</tr>
						</tbody>
					</table>
					<br />
					<br />
					<div class="row">
						<div class="col-md-3 col-3 offset-9">
							<p>..........................................</p>
							<p>@employee</p>
							<p>@pada</p>
						</div>
					</div>

				</div>
			</div>
		</div>
	}
</div>


@section Scripts
{
	<script type="text/javascript">
		$(document).ready(function () {
			$('#btnPrint').attr('style', "display: " + ('@ViewBag.fiscalId' != '' ? 'block' : 'none'));
			if ('@isSavedData' === 'True') {
				$.ajax({
					url: '@Url.Action("GetPrintReportContent", "Ajax", new { area = "" })',
					type: 'get',
					data: { ReportName: '@ViewData["Title"]', PlanningSamjhautaId: '@Model.PlanningSamjhautaId' },
					success: function (result) {
						if (result) {
							$('#contentToPrint').html(result);
						}
					},
					error: function () {
						alert('error in calling ajax !!')
					}
				});
			}
		});


		function PrintContent(divele) {
			var elementHTML = document.getElementById(divele).innerHTML;
			var oldPage = document.body.innerHTML;
			document.body.innerHTML = elementHTML;
			window.print();
			document.body.innerHTML = oldPage;
			window.location.reload();
		}

		function Print() {
			if ('@isSavedData' == 'True') {
				PrintContent('contentToPrint')
				return;
			}
			var printdata = $('#contentToPrint').html();
			var reportname = $('#reportname').html();
			var planningsamjhautaid = "@Model.PlanningSamjhautaId";
			$.ajax({
				url: '@Url.Action("PrintReport", "Ajax", new { area = "" })',
				type: 'post',
				data: { PrintContent: printdata, ReportName: '@ViewData["Title"]', PlanningSamjhautaId: planningsamjhautaid },
				success: function (result) {
					if (result) {
						PrintContent('contentToPrint')
					}
				},
				error: function () {
					alert('error in calling ajax !!')
				}
			});
		}

	</script>
}