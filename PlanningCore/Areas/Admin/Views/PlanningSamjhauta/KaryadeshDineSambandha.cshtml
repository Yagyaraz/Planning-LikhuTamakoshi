@inject IUtility _utility
@model PlanningSamjhautaViewModel
@{
    ViewData["Title"] = "KaryadeshDineSambandha";
    var orgname = await _utility.GetMainSettingById(0);
    int? post = ViewBag.EmpId;
    var pada = await _utility.GetPostById(ViewBag.PostId);
    var employee = await _utility.GetEmpNameById(post);
    bool isSavedData = Convert.ToBoolean(ViewBag.isSavedData);
}
<style>
    table {
        border-collapse: collapse !important;
        width: 80% !important;
        border: 1px solid black !important;
    }

    .tbl {
        font-weight: bold !important;
    }

    th, td {
        border: 1px solid black !important;
        padding: 8px !important;
        text-align: center !important;
    }

    span {
        font-weight: bold;
    }

    accordion-body1 {
        padding: 0.5rem 1.25rem;
    }

    .printpage {
        width: 21cm;
        min-height: 29.7cm;
        padding: 2cm;
        margin: 1cm auto;
        border: 1px #d3d3d3 solid;
        border-radius: 5px;
        background: #fff;
        box-shadow: 0 0 5px rgb(0 0 0 / 10%);
        font-family: 'kalimati regular' !important;
    }

    @@media print {
        table {
            border-collapse: collapse !important;
            width: 80% !important;
            border: 1px solid black !important;
        }

        .tbl {
            font-weight: bold !important;
        }

        th, td {
            border: 1px solid black !important;
            padding: 8px !important;
            text-align: center !important;
        }
    }

</style>

@if (!isSavedData)
{
    <div class="container pt-4 mt-4">
        <form asp-action="@ViewData["Title"]" method="get">
            <div class="pt-4 row">
                <div class="col-2">
                    <label>पद</label>
                    <select name="PostId" id="PostId" asp-items="@await _utility.GetPadaList()" required class="form-control">
                        <option value="">--पद छान्नुहोस--</option>
                    </select>
                </div>
                <div class="col-2">
                    <label>नाम</label>
                    <select name="EmpId" id="EmpId" asp-items="@await _utility.GetEmpNameByPostId(ViewBag.PostId)" required class="form-control">
                        <option value="">--नाम छान्नुहोस--</option>
                    </select>
                </div>
                <div class="col-md-2 col-2">
                    <label>मिति : </label> <br />
                    <input type="text" name="PrintDate" required class="form-control PrintDate" value="@Model.PrintDate" />
                </div>

                <div class="col-2">
                    <label> </label><br />
                    <input type="submit" value="खोज्नुहोस्" class="btn btn-success" />
                </div>
            </div>
        </form>
    </div>
}
<button style="float:right; margin-top:3rem !important;" class="btn btn-primary mt-2" type="button" onClick="Print('contentToPrint')"><i class="fa fa-print" aria-hidden="true"></i> Print</button>

 <div class="row" id="contentToPrint">
    @if (!isSavedData)
    {
        <div class="card-body printpage">
            <div class="row">

                <div class="Header">
                    <partial name="_PrintHeaderTippaniAndSamjhautapatrta" />
                </div>
            </div>
            
            <div class="container" style="color:black;">
                @* <div class="d-flex text-center justify-content-end align-items-center">
                    <span style="text-align:end">मिति:- @_utility.ConvertEnglishToNepali(Model.PrintDate)  </span>
                </div> *@
                @* <div style="border-top:5px solid red; width:100%;"></div><br /> *@
                <div class="accordion-header text-center font-bold text-decoration-underline" style="font-size:16px;"> टिप्पणी र आदेश ।</div>
                <div class="accordion-header text-center font-bold text-decoration-underline" style="font-size:16px;"> विषय:आयोजना सम्झौता गरी कार्यदेश दिने सम्बन्धमा।</div>
                <p style="letter-spacing:1px; line-height:30px; font-weight:500; font-size:16px; padding-top:15px;">श्रीमान्</p>
                <p style="text-indent:24px; letter-spacing:1px; line-height:30px; font-weight:500; font-size:16px; text-align:justify !important; ">
                    यस <b> @orgname.PalikaName </b>को  @orgname.PalikaTypeName सभाबाट चालु आ.व.<b> @Model.FiscalYearName </b>
                    मा स्वीकृत भएको @* <b> @Model.WardName </b> मा *@ <strong> @Model.YojanaNames  </strong>को प्राविधिक लगत इष्टिमेट समेत भएको, नियमानुसार उपभोक्ता
                    समिति गठन भई सो को प्रतिवेदन प्राप्त भएको, वडा अध्यक्षबाट आयोजना कार्यक्रम सम्झौता गरिदिने सम्बन्धमा सिफारिस प्राप्त भएको र उपभोक्ता
                    समितिका अध्यक्षबाट आयोजना कार्यक्रम सम्झौता गरी पाउँ भनी निवेदन दिएकोले देहाय बमोजिमको आयोजना सम्झौता गरी कार्यदेश दिन मुनासिव
                    देखी निर्णयार्थ पेश गरेको छु  । 
                </p>
                <br />
                <p style="font-weight:500; font-size:14px;">१. आ.व:&nbsp; @Model.FiscalYearName </p>
                <p style="font-weight:500; font-size:14px;">२. कार्यक्रम /आयोजकको नाम:<strong> &nbsp; @Model.YojanaNames </strong> </p>
                <p style="font-weight:500; font-size:14px;">३. लगत इष्टिमेट रु :&nbsp; @Model.Total_Amount_Source </p>
                <p style="font-weight:500; font-size:14px;">४. विनियोजित रकम रु: &nbsp;&nbsp; @Model.Project_estimated_Amount </p>
                <p style="font-weight:500; font-size:14px; "> ५. श्रम सहभागिता : &nbsp; @Model.Loan_Grant </p>
                <p style="font-weight:500; font-size:14px;">६. कार्य सम्झौता मिति:&nbsp; @Model.Municipality_Manjuri_Date </p>
                <p style="font-weight:500; font-size:14px;">७. उ.स.अ. को नाम :<strong>&nbsp; @Model.RepresentativeName </strong> </p>
                <p style="font-weight:500; font-size:14px;">८. कार्य सम्पन्न गर्ने मिति: &nbsp; @Model.Project_End_Date </p>
                <div class="row">
                    <div class="col-md-3 col-3 offset-9" style="line-height:10px; text-align:center;">
                        <p> पेश गर्ने</p>
                        <p>...........................................</p>
                        <p>@employee</p>
                        <p>@pada</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

@section Scripts
{
    <script>
        NepaliDatePickerCalWithClass(document.getElementsByClassName('PrintDate'))
    </script>
    <script>
        $('#PostId').change(function () {
            $.ajax({
                url: '@Url.Action("GetEmpNameByPostId", "Ajax", new { area = "" })',
                type: 'GET',
                data: { id: $(this).val() },
                success: function (data) {
                    $('#EmpId').empty().append("<option value=''>-नाम छान्नुहोस्-</option>");
                    $.each(data, function (index, item) {
                        $('#EmpId').append(`<option value="${item.Value}">${item.Text} </option>`);
                    });
                },
                error: function () {
                    alert('error in calling ajax !!');
                }
            });
        });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            $('#PostId').val('@ViewBag.PostId');
            $('#EmpId').val('@ViewBag.EmpId').trigger('change');
            $('#fiscalId').val('@ViewBag.fiscalId').trigger('change');
            if ('@Model.PrintDate' != '') {
                    $('.pDate').html('@Model.PrintDate')
                }
            $('#btnPrint').attr('style', "display: " + ('@ViewBag.fiscalId' != '' ? 'block' : 'none'));
            if ('@isSavedData' === 'True') {
                $.ajax({
                    url: '@Url.Action("GetPrintReportContent", "Ajax", new { area = "" })',
                    type: 'get',
                    data: { ReportName: '@ViewData["Title"]', PlanningSamjhautaId: '@Model.PlanningSamjhautaId' },
                    success: function (result) {
                        if (result) {
                            $('#contentToPrint').html(result);
                        }
                    },
                    error: function () {
                        alert('error in calling ajax !!')
                    }
                });
            }
        });

        function PrintContent(divele) {
            var elementHTML = document.getElementById(divele).innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = elementHTML;
            window.print();
            document.body.innerHTML = oldPage;
            window.location.reload();
        }

        function Print() {
            if ('@isSavedData' == 'True') {
                PrintContent('contentToPrint')
                return;
            }
            var printdata = $('#contentToPrint').html();
            var reportname = $('#reportname').html();
            var planningsamjhautaid = "@Model.PlanningSamjhautaId";
            $.ajax({
                url: '@Url.Action("PrintReport", "Ajax", new { area = "" })',
                type: 'post',
                data: { PrintContent: printdata, ReportName: '@ViewData["Title"]', PlanningSamjhautaId: planningsamjhautaid },
                success: function (result) {
                    if (result) {
                        PrintContent('contentToPrint')
                    }
                },
                error: function () {
                    alert('error in calling ajax !!')
                }
            });
        }
    </script>
}