									<th> @Html.DisplayNameFor(model => model.Nirman_Upabhokta)</th>
									<th> @Html.DisplayNameFor(model => model.Remaining_Bhuktani_Amount)</th>
									<th> @Html.DisplayNameFor(model => model.Katti_Rakam)</th>
									<th> @Html.DisplayNameFor(model => model.SamjhautaDate)</th>
									<th>कार्य</th>

								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model.PlanningBhuktaniList)
								{
									<tr>
										<td>@_Utility.ConvertEnglishToNepali(i)</td>
										<td>@Html.DisplayFor(modelItem => item.Aayojana_Karyakram)</td>
										<td>@Html.DisplayFor(modelItem => item.Nirman_Upabhokta)</td>
										<td>@Html.DisplayFor(modelItem => item.Remaining_Bhuktani_Amount)</td>
										<td>@Html.DisplayFor(modelItem => item.Katti_Rakam)</td>
										<td>@Html.DisplayFor(modelItem => item.SamjhautaDate)</td>
										<td class="d-flex">
											<a type="button" id="सच्याउनुहोस" class="btn btn-secondary oval-button btn-sm" asp-action="InsertPlanningSamjhauta" asp-route-pid="@item.PlanningSamjhautaId" asp-route-id="@item.PlanningBhuktaniId">
												<i class="fa fa-edit d-flex" style="font-size:10px">&nbsp;सच्याउनुहोस </i>
											</a>
											<a type="button" id="विवरण" class="btn btn-primary oval-button btn-sm" asp-action="Details" asp-route-pid="@item.PlanningSamjhautaId" asp-route-id="@item.PlanningBhuktaniId">
