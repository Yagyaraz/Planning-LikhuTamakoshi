@model PlanningDocumentUploadedViewModel
@inject IUtility _Utility
@{
	ViewData["Title"] = "Index";
	<style>
		.oval-button {
			border-radius: 25px;
		}

		#zero_config > thead > tr > th {
			font-weight: bold;
		}

		table.table-bordered.dataTable th, table.table-bordered.dataTable td {
			border-left-width: thin;
		}

			table.table-bordered.dataTable th:last-child, table.table-bordered.dataTable th:last-child, table.table-bordered.dataTable td:last-child, table.table-bordered.dataTable td:last-child {
				border-right-width: thin;
			}
	</style>

}

<div class="page-breadcrumb">
	<div class="row">
		<div class="col-12 d-flex no-block align-items-center">
			<h4 class="page-title">भुक्तानि</h4>
			<div class="ms-auto text-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
						<li class="breadcrumb-item active" aria-current="page">

							<span>भुक्तानि</span>


						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid">
	<div class="row">
		<div class="col-md-12">
			<div style="text-align: right;">
				<a asp-controller="Planningsamjhauta" asp-action="CreatePlanningDocument" asp-area="Admin" class="btn btn-success btn-sm oval-button" asp-route-PlanningSamjhautaid="@Model.PlanningSamjhuataId"><i class="fas fa-plus-circle"></i> नयाँ राख्नुहोस </a>
			</div>
			<br />
