								}
							</tbody>

						</table>
					</div>
				</div>
			</div> *@
		</div>
	</div>
</div>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	<script>
		$("#zero_config").DataTable();
	</script>
	<script>
		$(function () { Message('@TempData["Msg"]') });
	</script>
}