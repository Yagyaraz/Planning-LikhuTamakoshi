<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

@section Scripts {
    <script>
        NepaliDatePickerCalWithClass(document.getElementsByClassName('PrintDate'));
    </script>
    <script>
        $(document).ready(function () {
        if ('@Model.PrintDate' != '') {
            $('.pDate').html('@Model.PrintDate')
        }            if ('@isSavedData' === 'True') {
                $.ajax({
                    url: '@Url.Action("GetPrintReportContentUpabhokta", "Ajax", new { area = "" })',
                    type: 'get',
                    data: { ReportName: '@ViewData["Title"]', UpabhoktaSamitiDetailId: '@Model.Id' },
                    success: function (result) {
                        if (result) {
                            $('#contentToPrint').html(result);
                        }
                    },
                    error: function () {
                        alert('error in calling ajax !!')
                    }
                });
            }
        });
    </script>
    <script>
        // function PrintDateSet() {
        //     var value = $('#PrintDate').val();
        //     if (value) {
        //         $('#dateView').html(`मिति:- ${englishToNepali(value)}`)
        //     }
        // }
        function PrintContent(divele) {
            var elementHTML = document.getElementById(divele).innerHTML;
            var oldPage = document.body.innerHTML;
            document.body.innerHTML = elementHTML;
            window.print();
            document.body.innerHTML = oldPage;
            window.location.reload();
        }

        function Print() {
            if ('@isSavedData' == 'True') {
                PrintContent('contentToPrint')
                return;
            }
            var printdata = $('#contentToPrint').html();
            var reportname = $('#reportname').html();
            var upabhoktaSamitiDetailId = "@Model.Id";
            $.ajax({
                url: '@Url.Action("PrintReportUpabhokta", "Ajax", new { area = "" })',
                type: 'post',
                data: { PrintContent: printdata, ReportName: '@ViewData["Title"]', UpabhoktaSamitiDetailId: upabhoktaSamitiDetailId },
                success: function (result) {
                    if (result) {
                        PrintContent('contentToPrint')
                    }
                },
                error: function () {
                    alert('error in calling ajax !!')
                }
            });
        }

    </script>
    <script>
        $('#PostId').change(function () {
            $.ajax({
                url: '@Url.Action("GetEmpNameByPostId", "Ajax", new { area = "" })',
                type: 'GET',
                data: { id: $(this).val() },
                success: function (data) {
                    $('#EmpId').empty().append("<option value=''>-नाम छान्नुहोस्-</option>");
                    $.each(data, function (index, item) {
                        $('#EmpId').append(`<option value="${item.Value}">${item.Text} </option>`);
                    });
                },
                error: function () {
                    alert('error in calling ajax !!');
                }
            });
        });
    </script>
}