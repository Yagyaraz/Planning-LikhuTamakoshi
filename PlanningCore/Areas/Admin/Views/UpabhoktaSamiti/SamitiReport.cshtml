@model IEnumerable<UpavoktaSamitiDetailViewModel>
@inject IUtility _Utility
@{
    ViewData["Title"] = "Index";
    var headerData = await _Utility.GetMainSettingById(0);
}
@{
    var i = 1;
}

<div class="page-breadcrumb">
    <div class="row">
        <div class="col-12 d-flex no-block align-items-center">

            <div class="ms-auto text-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            उपभोक्ता समिति
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<div class="col-md-12 col-12">

    <div class="d-flex p-1 text-center justify-content-start align-items-center">
        <img width="120" src="~/Images/NepalLogo.png" />

        <div class="row" style="align-content:center;">
            <h4>@headerData.PalikaName</h4>
            <h3>@headerData.Name</h3>
            <h4>@headerData.Address </h4>
            <h4>@headerData.StateName, नेपाल </h4>
            <br />
            <br />
            <h6 style="color:red">सम्पुर्ण उपभोक्ता समितिको विवरण</h6>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">

            <br />
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="zero_config"
                               class="table table-striped table-bordered">

                            <thead>
                                <tr class="anusuchiHeading" style="background-color:skyblue; color:#ffffff; border-color:#000;">
                                    <th rowspan="2" colspan="1">क्र.स.</th>
                                    <th rowspan="2" colspan="1">दर्ता नं.</th>
                                    <th rowspan="2" colspan="1">आयोजनाको नाम</th>
                                    <th rowspan="2" colspan="1">सम्झौता गर्ने संस्थाको नाम</th>
                                    <th rowspan="2">वडा नं.</th>
                                    <th rowspan="1" colspan="3">समितिको प्रतिनिधि</th>
                                    <th rowspan="2" colspan="1">सदस्य</th>
                                    <th rowspan="2" colspan="1">जनसङ्ख्या</th>
                                    <th rowspan="2" colspan="1">समिति गठन भएको मिति</th>
                                </tr>
                                <tr class="anusuchiHeading" style="background-color:skyblue; color:#ffffff; border-color:#000;">
                                    <th rowspan="1" colspan="1"> अध्यक्ष </th>
                                    <th rowspan="1" colspan="1">सचिव </th>
                                    <th rowspan="1" colspan="1">कोषाध्यक्ष </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var male = item.Male_Present;
                                    var female = item.Female_Present;
                                    var jamma = male + female;
                                    var ad = "";
                                    var sb = "";
                                    var ko = "";
                                    var count = item.samitiMemberDetaillist.Count;
                                    var sad = string.Join(", ", item.samitiMemberDetaillist.Where(x => x.SamitiPostId == 4).Select(x => x.MemberName).ToList());
                                    <tr>

                                        <td>@i</td>
                                        <td>@item.DartaNo</td>
                                        <td>@* @item.YojanaName *@</td>
                                        <td>@item.Name</td>
                                        <td>@item.WardNo</td>

                                        @foreach (var data in item.samitiMemberDetaillist)
                                        {
                                            if (data.SamitiPostId == 1)
                                                ad = @data.MemberName;
                                            if (data.SamitiPostId == 2)
                                                sb = @data.MemberName;
                                            if (data.SamitiPostId == 3)
                                                ko = @data.MemberName;

                                        }
                                        <td rowspan="1">
                                            @if (ad != null)
                                            {
                                                @ad

                                            }
                                            else
                                            {
                                                <span>डाटा उपलब्ध हुन सकेन</span>
                                            }
                                        </td>
                                        <td rowspan="1">
                                            @sb
                                        </td>
                                        <td rowspan="1">
                                            @ko
                                        </td>
                                        <td rowspan="1">@sad </td>


                                        @* <td rowspan="1">@string.Join(", ", item.samitiMemberDetaillist.Select(x => x.Adakshya).FirstOrDefault())</td>
                                    <td rowspan="1">@string.Join(", ", item.samitiMemberDetaillist.Select(x => x.Sachib).FirstOrDefault())</td>
                                    <td rowspan="1">@string.Join(", ", item.samitiMemberDetaillist.Select(x => x.Kosadakshya).FirstOrDefault())</td>
                                    <td>@string.Join(", ", item.samitiMemberDetaillist.Select(x => x.Sadasya).ToList())</td>
                                    *@
                                        <td>@_Utility.ConvertEnglishToNepali(jamma)</td>
                                        <td>@_Utility.ConvertEnglishToNepali(item.NepaliSamitiEstdDate)</td>

                                    </tr>
                                    i++;
                                }
                            </tbody>

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $("#zero_config").DataTable();
    </script>

    <script>
        $(function () { Message('@TempData["Msg"]') });
    </script>
}