@model AnugamanViewModel
@inject IUtility _Utility
@using HtmlHelpers.BeginCollectionItemCore;

<div class="anugaman row new">
    @using (Html.BeginCollectionItem("AnugamanMemberList"))
    {
        <div class="col-lg-12 col-sm-12 col-12">
            <input asp-for="AnugamanMemberId" class="form-control" type="hidden" />
            <input asp-for="UpabhoktaSamitiDetailId" type="hidden" />
        </div>

        <div class="col-md-3 col-3 mt-3 ">

            <label asp-for="PostId" class="control-label fw-bold"></label>
            <select asp-for="PostId" asp-items="await _Utility.GetAnugamanSamitiPostList()" class="form-control form-control">
                <option>--कृपया  पद छान्नुहोस--</option>
            </select>
            <span asp-validation-for="PostId" class="text-danger"></span>

        </div>
        <div class="col-md-3 col-3 mt-3   ">

            <label asp-for="Name" class="control-label fw-bold"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>

        </div>
        <div class="col-md-3 col-3 mt-3 ">

            <label asp-for="Address" class="control-label fw-bold"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>

        </div>
        <div class="col-md-3 col-3 mt-3 ">

            <label asp-for="Contact" class="control-label fw-bold"></label>
            <input asp-for="Contact" class="form-control" />
            <span asp-validation-for="Contact" class="text-danger"></span>

        </div>
