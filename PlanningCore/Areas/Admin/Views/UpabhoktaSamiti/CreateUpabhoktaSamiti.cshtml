@model UpavoktaSamitiDetailViewModel
@inject IUtility _Utility
@{
    ViewData["Title"] = "Index";
}

<style>
    .page-samiti {
        padding-top:8px;
        padding-left:6px;
    }

 /*    .upabhokta-body{
        margin-left:50px;
        margin-right:50px;
    } */

    .form-control{
        height: 30px;
        padding: 4px 12px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

</style>


@* <link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" /> *@
<div class="page-breadcrumb colr1">
    <div class="row">
        <div class="col-12 d-flex no-block align-items-center">
            <div class="d-flex">
                <span class="page-title page-samiti" style="background-color:#3c8dbc; color:#fff; padding-top:10px; height:40px; text-align:center;"> उपभोक्ता समिति सम्बन्धि विवरण :</span>
                <span style="height:2rem; background-color:#3c8dbc; width:10px; height:40px;"></span>
                <span style="height: 2rem;border-top: 17px solid transparent;border-left: 25px solid #3c8dbc;border-bottom: 22px solid transparent; height:40px;"> </span>
            </div>
            <div class="ms-auto text-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="#">गृह पृष्ट</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            उपभोक्ता समिति सम्बन्धि विवरण :
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid colr1">
    <div class="row">
        <form asp-action="CreateUpabhoktaSamiti" enctype="multipart/form-data">
            @Html.HiddenFor(model => model.UpabhoktaSamitiDetailId)
            <div class="col-md-12">
                <div class="card">
                    <div class="card-body row upabhokta-body">
                      
                        <div class="form-group mt-3 col-md-3 col-3">
                            <label asp-for="DartaNo"></label>
                            <input type="text" asp-for="DartaNo" class="form-control" readonly>
                        </div>

@*                         <div class="form-group mt-3 col-md-3 col-3">
                            <label asp-for="Name"></label>
                            <input type="text" asp-for="Name" class="form-control">
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div> *@
                        <div class="form-group mt-3 col-md-3 col-3">
                            <label asp-for="Name" class="control-label"></label>
                            <select asp-for="Name" asp-items="await _Utility.GetUpabhhoktaSamitiList(Model.PlanningSamjhautaId)" onchange="GetOtherInfo(this)" multiple="multiple" required class="form-control select2-dropdown">
                                <option>--<label asp-for="Name"></label> --</option>
                            </select>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-3 col-md-3 col-3">
                            <label asp-for="NepaliSamitiEstdDate"></label>
                            <input type="text" asp-for="NepaliSamitiEstdDate" class="form-control">
                            <span asp-validation-for="NepaliSamitiEstdDate" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-3 col-md-3 col-3" hidden>
                            <input type="datetime" asp-for="Samiti_Estd_Date" class="form-control">
                            <span asp-validation-for="Samiti_Estd_Date" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-3 col-md-3 col-3">
                            <label asp-for="Address" class="fw-bold"></label>
                            <input type="text" asp-for="Address" class="form-control">
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                        <hr />
                        <div class="col-sm-12 col-12">
                            <div class="btitle">
                            </div>
                            <button type="button" id="SamitiAdd" class="btn btn-add btn-sm" 
                            style="background-color:green; color: #fff; padding: 7px 12px; margin-bottom: 5px; float:right;">
                                <i class="fa fa-plus-circle"> </i>&nbsp; समिति सदस्य थप्नुहोस
                            </button>
                        </div>
                        <div class="col-lg-12 col-sm-12 col-12" id="Samitidiv">
                            <div class="col-lg-12 col-sm-12 col-12">
                                @if (Model.samitiMemberDetaillist.Count > 0)
                                {
                                    foreach (var items in Model.samitiMemberDetaillist)
                                    {
                                        <partial name="_SamitiMemberList.cshtml" model="@items" />
                                    }

                                }
                                @* else
                                {
                                <partial name="_SamitiMemberList.cshtml" model="@new UpavoktaSamitiMemberDetailViewModel()" />
                                } *@
                            </div>
                        </div>

                        <hr class="mt-3"/>
                        <div class="col-sm-12 col-12">
                            <div class="btitle">
                            </div>
                            <button type="button" id="AnugamanAdd" class="btn btn-add btn-sm"
                                    style="background-color:green; color: #fff; padding: 7px 12px;  margin-bottom: 5px; float:right;">
                            <i class="fa fa-plus-circle"> &nbsp;</i> अनुगमन समिति सदस्य थप्नुहोस  </button>
                        </div>
                        <div class="col-lg-12 col-sm-12 col-12" id="anugaman">
                            <div class="col-lg-12 col-sm-12 col-12">
                                @if (Model.AnugamanMemberList.Count > 0)
                                {
                                    foreach (var items in Model.AnugamanMemberList)
                                    {
                                        <partial name="_CreateAnugaman.cshtml" model="@items" />
                                    }

                                }
                                @* else
                                {
                                <partial name="_SamitiMemberList.cshtml" model="@new UpavoktaSamitiMemberDetailViewModel()" />
                                } *@
                            </div>
                        </div>
                        <hr class="mt-3"/>
                        <div class="form-group mt-2 col-md-3 col-3">
                            <label asp-for="Beneficiaries_Attendance"></label>
                            <input type="number" asp-for="Beneficiaries_Attendance" class="form-control">
                            <span asp-validation-for="Beneficiaries_Attendance" class="text-danger"></span>
                        </div>
                        <div class="form-group mt-2 col-md-3 col-3">
                            <label asp-for="Beneficiaries_Absent"></label>
                            <input type="number" asp-for="Beneficiaries_Absent" class="form-control">
                            <span asp-validation-for="Beneficiaries_Absent" class="text-danger"></span>
                        </div>
                        <div class="form-group mt-2 col-md-3 col-3">
                            <label asp-for="Female_Present"></label>
                            <input type="number" asp-for="Female_Present" class="form-control pAge">
                            <span asp-validation-for="Female_Present" class="text-danger"></span>
                        </div>
                        <div class="form-group mt-2 col-md-3 col-3">
                            <label asp-for="Male_Present"></label>
                            <input type="number" asp-for="Male_Present" class="form-control">
                            <span asp-validation-for="Male_Present" class="text-danger"></span>
                        </div>
                        <div class="form-group mt-2 col-md-3 col-3">
                            <label asp-for="NibedanMiti"></label>
                            <input type="text" asp-for="NibedanMiti" class="form-control">
                            <span asp-validation-for="NibedanMiti" class="text-danger"></span>
                        </div>


                        <div class="form-group mt-2 col-md-3 col-3">
                            <label asp-for="YojanaIds" class="control-label"></label>
                            <select asp-for="YojanaIds" asp-items="await _Utility.GetYojanaNotContractList(Model.PlanningSamjhautaId)" onchange="GetOtherInfo(this)" multiple="multiple" required class="form-control select2-dropdown" style="width: 250px!important;">
                                <option>--<label asp-for="YojanaIds"></label> --</option>
                            </select>
                            <span asp-validation-for="YojanaIds" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-2 col-md-3 col-3">
                            <label asp-for="BankId" class="control-label"></label> <br/>
                            <select asp-for="BankId" asp-items="await _Utility.GetBankList()" class="form-control">
                                <option>--<label asp-for="BankId"></label> --</option>
                            </select>
                            <span asp-validation-for="BankId" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-2 col-md-3 col-3">
                            <label asp-for="AccountNumber"></label>
                            <input type="text" asp-for="AccountNumber" class="form-control">
                            <span asp-validation-for="AccountNumber" class="text-danger"></span>
                        </div>
                       
                    </div>
                    <div class="border-top">
                        <div class="card-body d-flex gap-2 justify-content-end">
                            <button type="submit" class="btn btn-success btn-sm mt-3 mb-2 text-white">
                                <i class="fa fa-check" aria-hidden="true"> सुरक्षित गर्नुहोस </i>
                            </button>
                            <a asp-action="SamitiIndex" asp-controller="UpabhoktaSamiti" asp-area="Admin" class="btn  btn-sm mt-3 mb-2 text-white"
                               style=" background-color:#424f63;">
                                <i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
@section Scripts {

    <script src="~/template/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet"></script>
    <script src="~/template/assets/libs/select2/dist/js/select2.min.js"></script>

    <script>
        $(function () {
            $('.select2-dropdown').select2({ width: '100%' });
        });
    </script>
    <script>
        $('#SamitiAdd').on('click', function () {
            $.ajax({
                url: '@Url.Action("CreateSamitiMemberList")',
                success: function (result) {
                    if (result) {
                        $('#Samitidiv').append(result);
                    }
                },
                error: function () {
                    alert('error in calling ajax !!')
                }
            });
        });
    </script>
    <script>
        $('#AnugamanAdd').on('click', function () {

            $.ajax({
                url: '@Url.Action("CreateAnugamanMember")',
                success: function (result) {
                    if (result) {
                        $('#anugaman').append(result);
                    }
                },
                error: function () {
                    alert('error in calling ajax !!')
                }
            });
        });
    </script>
    <script>
        function DeleteRow(e) {
            var confirmValue = confirm("Are you sure to delete ?");
            if (confirmValue) {
                $(e).closest('.new').remove();
            }
        }
    </script>

    <script>

        NepaliDatePickerCal(document.getElementById('NepaliSamitiEstdDate'), document.getElementById('NepaliSamitiEstdDate'))
        NepaliDatePickerCal(document.getElementById('NibedanMiti'), document.getElementById('NibedanMiti'))

    </script>
    <script>
        function CheckSamitiPerson(a, samitiId) {
            debugger;
            var ctzNo = a.value;
            if (ctzNo.length > 5) {
                $.ajax({
                    url: '@Url.Action("CheckSamitMember")',
                    data: { ctzno: ctzNo, samitiId: samitiId },
                    success: function (result) {
                        if (result.length > 0) {
                            var msg = '';
                            $.map(result, function (val, i) {
                                msg += `<b>उ.स नाम :</b> ${val.SamitiName} <br><b> व्यक्तिको नाम :</b> ${val.Name} <b> पद :</b> ${val.Post} <br><b> सम्पर्क नं :</b> ${val.Name}  <b>नागरिकता नं. :</b> ${ctzNo} <br>`;
                            });
                            msg += `यसले निम्न विवरण ठेकेदारसँग प्रविष्टि फेला पार्यो। यदि तपाइँ यो जानकारी सुरक्षित गर्न जारी राख्न चाहनुहुन्छ भने कृपया पुष्टि गर्नुहोस्।`;
                            $.confirm({
                                title: 'Note!!!',
                                content: msg,
                                buttons: {
                                    ok: {
                                        text: 'Ok',
                                        btnClass: 'btn-green',
                                        keys: ['enter', 'shift'],
                                        action: function () {

                                        }
                                    },
                                    cancle: {
                                        text: 'Remove',
                                        btnClass: 'btn-red',
                                        keys: ['enter', 'shift'],
                                        action: function () {
                                            $(a).closest('.new').remove();
                                            $("#SamitiAdd").trigger("click");
                                        }
                                    }
                                }
                            });
                        }
                    },
                    error: function () {
                        alert('error in calling ajax !!')
                    }
                });
            }


        }

    </script>
    <script>
        function GetOtherInfo(a) {
            var selectedValues = $('#YojanaIds').val();
            // alert(selectedValues)
        }
    </script>


}
