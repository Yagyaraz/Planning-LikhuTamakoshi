@model IEnumerable<BudgetSourceViewModel>
@inject IUtility _Utility
@{
	ViewData["Title"] = "Index";

}

<div class="page-breadcrumb colr1">
	<div class="row">
		<div class="col-12 d-flex no-block align-items-center">
			<div class="ms-auto text-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
						<li class="breadcrumb-item active" aria-current="page">
							बजेट श्रोत
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid colr1">
	<div class="row">
		<div class="col-md-12">
			<div style="display:flex; justify-content:space-between;">
				<div style="display:flex;">
					<h4 class="card1" style="background-color:#3c8dbc; color:#fff; height:40px; width:100px; padding-top:5px; text-align:center;">बजेट श्रोत</h4>
					<span style="height:2rem; background-color:#3c8dbc; width:10px; height:40px;"></span>
					<span style="height: 2rem; border-top: 17px solid transparent;border-left: 25px solid #3c8dbc;border-bottom: 22px solid transparent; height:40px;"> </span>
				</div>
				<div style="display:flex; gap:20px;">
					<a asp-controller="Budget" asp-action="CreateBudgetSource" asp-area="Admin" class="btn btn-sm
                      d-flex justify-content-center align-items-center fw-bold text-white"
					   style="height:2rem; background-color:#33b35a; border:1px solid #3ec291;">
						<i class="fas fa-plus-circle">  </i>
						<span style="padding-left:3px;"> नया बजेट श्रोत </span>
					</a>
				</div>
			</div>

			<div class="card">
				<div class="card-body">
					<div class="table-responsive">
						<table id="zero_config" class="table table-striped table-bordered">
							<thead style="background-color: #ccd1d9;">
								<tr>
									<th style="text-align:center; width:8%; border-bottom:none!important;">क्र.स.</th>
									<th style="text-align:center; border-bottom:none!important; border-left:none!important;"> @Html.DisplayNameFor(model => model.BudgetSourceName)</th>
									<th style="text-align:center; border-bottom:none!important; border-left:none!important;"> @Html.DisplayNameFor(model => model.Amount)</th>
									<th style="text-align:center; border-bottom:none!important; border-left:none!important;"></th>
								</tr>
							</thead>
							<tbody style="background-color:#fff;">
								@foreach (var item in Model)
								{
									<tr>
										<td style="text-align:center; ">@_Utility.ConvertEnglishToNepali((Model.ToList().IndexOf(item) + 1)).</td>
										<td style="text-align:center; border-left:none!important;">@Html.DisplayFor(modelItem => item.BudgetSourceName)</td>
										<td style="text-align:center; border-left:none!important;">@Html.DisplayFor(modelItem => item.Amount)</td>
										<td style="text-align:center; border-left:none!important;">
											<a type="button" id="सच्याउनुहोस" class="btn btn-sm" title="Edit" asp-action="CreateBudgetSource" asp-route-id="@item.BudgetSourceId">
												<i class="fa fa-edit"></i>
											</a>
											<a asp-action="DeleteBudgetSource" title="Delete" asp-route-id="@item.BudgetSourceId" onclick="return confirm('Are you sure?')">
												<i class="fa fa-trash" style="color:red; padding-left:3px;">
												</i>
											</a>
										</td>
									</tr>
								}
							</tbody>

						</table>
						<div class="d-flex justify-content-end">
							<a asp-action="Setup" asp-controller="Setup" asp-area="Admin" class="btn  btn-sm mt-3 mb-2 text-white"
							   style=" background-color:#424f63;">
								<i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	<script>
		$("#zero_config").DataTable();
	</script>
}