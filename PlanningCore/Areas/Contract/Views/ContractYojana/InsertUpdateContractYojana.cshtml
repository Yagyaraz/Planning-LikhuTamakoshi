@model Con_YojanaViewModel
@inject IUtility _Utility
@{
	ViewData["Title"] = "Index";
}
<style>
	.form-control {
		border-color: black;
	}

	/* .select2-container--default .select2-selection--multiple .select2-selection__choice {
		background-color: #2255a4 !important;
	} */
</style>
<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="~/template/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet" />
<div class="page-breadcrumb colr1">
	<div class="row">
		<div class="col-12 d-flex no-block align-items-center">
			<div style="display:flex;">
				<h4 class="card1" style="background-color:#3c8dbc; color:#fff; height:40px; width:170px; padding-top:5px; text-align:center;">योजना सम्बन्धि विवरण :</h4>
				<span style="height:2rem; background-color:#3c8dbc; width:10px; height:40px;"></span>
				<span style="height: 2rem; border-top: 17px solid transparent;border-left: 25px solid #3c8dbc;border-bottom: 22px solid transparent; height:40px;"> </span>
			</div>
			<div class="ms-auto text-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
						<li class="breadcrumb-item active" aria-current="page">
							योजना सम्बन्धि विवरण :
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid colr1">
	<div class="row">
		<form asp-action="InsertUpdateContractYojana" method="post">
			@Html.HiddenFor(model => model.Id)
			<div class="col-md-12">
				<div class="card">
					<div class="card-body row">

						<div class="form-group mt-3 col-md-3 col-3 ">
							<label asp-for="YojanaName"></label>
							<input type="text" asp-for="YojanaName" class="form-control">
							<span asp-validation-for="YojanaName" class="text-danger"></span>
						</div>
						<div class="form-group mt-3 col-md-3 col-3 ">
							<label asp-for="EstimatedAmount"></label>
							<input type="text" asp-for="EstimatedAmount" class="form-control">
							<span asp-validation-for="EstimatedAmount" class="text-danger"></span>
						</div>
						<div class="form-group mt-3 col-md-3 col-3  ">
							<label asp-for="YojanaAddress"></label>
							<input type="text" asp-for="YojanaAddress" class="form-control">
							<span asp-validation-for="YojanaAddress" class="text-danger"></span>
						</div>
						<div class="form-group mt-3 col-md-3 col-3 ">
							<label asp-for="WardIds"></label>
							<select asp-for="WardIds" asp-items="await _Utility.GetWardList()" class="form-control select2">
								<option value="">-- Select Ward(s) --</option>
							</select>
						</div>
						
						<div class="form-group mt-3 col-md-3 col-3  ">
							<label asp-for="Longitude" class="fw-bold"></label>
							<input type="text" asp-for="Longitude" class="form-control">
							<span asp-validation-for="Longitude" class="text-danger"></span>
						</div>
						<div class="form-group mt-3 col-md-3 col-3 ">
							<label asp-for="Latitude" class="fw-bold"></label>
							<input type="text" asp-for="Latitude" class="form-control">
							<span asp-validation-for="Latitude" class="text-danger"></span>
						</div>
						<div class="card-bodyp-10 d-flex justify-content-end gap-2">
							<button type="submit" class="btn btn-sm btn-success text-white g-2">
								<i class="fas fa-save"> <span style="font-weight:1;">  सुरक्षित गर्नुहोस  </span></i>
							</button>

							<a asp-action="ContractYojanaIndex" asp-controller="ContractYojana" asp-area="Contract" class="btn  btn-sm  text-white"
							   style=" background-color:#424f63;">
								<i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
							</a>

						</div>
					</div>

				</div>
			</div>
		</form>

	</div>
</div>
@section Scripts {
	@{

		<script src="~/template/assets/libs/select2/dist/js/select2.full.min.js"></script>
		<script src="~/template/assets/libs/select2/dist/js/select2.min.js"></script>
	}

	<script>
		$(document).ready(function () {
			$(".select2").select2();
		});
	</script>

}