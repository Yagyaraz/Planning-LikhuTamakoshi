@model IEnumerable<BidSecurityViewModel>
@inject IUtility _Utility
@{
    ViewData["Title"] = "Index";
    <style>
        .oval-button {
            border-radius: 25px;
        }

        #zero_config > thead > tr > th {
            font-weight: bold;
            font-size: 14px;
        }

        #zero_config > tbody > tr > td {
            font-size: 13px;
        }

        table.table-bordered.dataTable th, table.table-bordered.dataTable td {
            border-left-width: thin;
        }

            table.table-bordered.dataTable th:last-child, table.table-bordered.dataTable th:last-child, table.table-bordered.dataTable td:last-child, table.table-bordered.dataTable td:last-child {
                border-right-width: thin;
            }
    </style>
}

<style>
    .table thead {
        background-color: #ccd1d9;
        font-size: 13px;
        line-height: 35px !important;
    }
        .table thead th {
            font-weight: 800;
            border: 1px solid black !important;
            padding: 0px !important;
        }

    .table tbody td {
        padding: 0px !important;
        border: 1px solid black !important;
        vertical-align: middle;
    }

    .table tbody tr {
        text-align: center;
        font-size: 12px;
        height: 27px !important;
    }

    table.table-bordered.dataTable td {
        padding: 0px;
    }

    table.table-bordered.dataTable th {
        padding: 0px;
    }

    tr:nth-child(even) {
        background-color: #e9ecef;
    }

    tr:hover {
        background-color: #b3ffe6;
    }
</style>

<div class="page-breadcrumb colr1">
    <div class="row">
        <div class="col-12 d-flex no-block align-items-center">

            <div class="ms-auto text-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            Bid Security
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid colr1">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between">
                <div style="display:flex;">
                    <h4 class="card1" style="background-color:#3c8dbc; color:#fff; height:40px; width:120px; padding-top:3px; text-align:center;">Bid Security</h4>
                    <span style="height:2rem; background-color:#3c8dbc; width:10px; height:40px;"></span>
                    <span style="height: 2rem; border-top: 17px solid transparent;border-left: 25px solid #3c8dbc;border-bottom: 22px solid transparent; height:40px;"> </span>
                </div>
                <a asp-controller="BidSecurity" asp-action="InsertUpdateBidSecurity" asp-area="Contract"
                   class="btn  btn-sm d-flex justify-content-center align-items-center text-white"
                   style="height:2rem; background-color:#33b35a; border:1px solid #3ec291;">
                    <i class="fas fa-plus-circle">
                        नयाँ थप्नुहोस
                    </i>
                </a>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="zero_config"
                               class="table  table-bordered" style="border-collapse: collapse!important;">
                            <thead>
                                <tr>
                                    <th style="width:50px; text-align:center;">क्र.स.</th>
                                    <th style="width:150px; text-align:center;">@Html.DisplayNameFor(model => model.BankId)</th>
                                    <th style="width:150px; text-align:center;">@Html.DisplayNameFor(model => model.Name)</th>
                                    <th style="width:150px; text-align:center;">@Html.DisplayNameFor(model => model.Address)</th>
                                    <th style="width:100px; text-align:center;">@Html.DisplayNameFor(model => model.BGAmount)</th>
                                    <th style="text-align:center;">@Html.DisplayNameFor(model => model.JariDate)</th>
                                    <th style="text-align:center;">@Html.DisplayNameFor(model => model.FromDate)</th>
                                    <th style="text-align:center;">@Html.DisplayNameFor(model => model.TODate)</th>
                                    <th style="text-align:center;"> कार्य</th>

                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td style="text-align:center;">@_Utility.ConvertEnglishToNepali(Model.ToList().IndexOf(item) + 1)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.BankName)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.Name)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.Address)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.BGAmount)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.JariDate)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.FromDate)</td>
                                        <td style="text-align:center;">@Html.DisplayFor(modelItem => item.TODate)</td>
                                        <td class="d-flex flex-wrap gap-3 justify-content-center" style="border-top:none!important; width:100px; border-left:none!important; ">
                                            <a asp-action="InsertUpdateBidSecurity" asp-route-id="@item.Id" title="Edit">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a asp-action="DeleteBidSecurity" asp-route-id="@item.Id" title="Delete" onclick="return confirm('Are you sure?')">
                                                <i class="fa fa-trash text-danger"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="d-flex justify-content-end">
                            <a asp-action="Index" asp-controller="Setup" asp-area="Contract" class="btn  btn-sm mt-3 mb-2 text-white"
                               style=" background-color:#424f63;">
                                <i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $("#zero_config").DataTable();
    </script>

    <script>
        function rejectMe(element) {
            Delete(element, '@Url.Action("Delete")');
        }
    </script>


}