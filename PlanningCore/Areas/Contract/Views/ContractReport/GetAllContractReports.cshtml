@model IEnumerable<Con_PrintReportDetailViewModel>
@inject IUtility _Utility

@{
	ViewData["Title"] = "GetAllContractReports";
	Layout = "~/Views/Shared/_Layout.cshtml";
	var i = 1;
}
<style>
	.oval-button {
		border-radius: 25px;
	}
</style>
<div class="page-breadcrumb colr1">
	<div class="row">
		<div class="col-12 d-flex no-block align-items-center">
			<div style="display:flex;">
				<h4 class="card1" style="background-color:#3c8dbc; color:#fff; height:40px; width:100px; padding-top:3px; text-align:center;">रीपोर्ट</h4>
				<span style="height:2rem; background-color:#3c8dbc; width:10px; height:40px;"></span>
				<span style="height: 2rem; border-top: 17px solid transparent;border-left: 25px solid #3c8dbc;border-bottom: 22px solid transparent; height:40px;"> </span>
			</div>
			<div class="ms-auto text-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
						<li class="breadcrumb-item active" aria-current="page">
							रीपोर्ट
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid colr1">
	<div class="row">
		<div class="col-md-12">
			
			<br />
			<div class="card">
				<div class="card-body">
					@*   <h5 class="card-title">Basic Datatable</h5> *@

					<div class="table-responsive">
						<table id="zero_config"
							   class="table table-striped table-bordered">
							<thead style="background-color: #ccd1d9; height:30px;">
								<tr>
									<th style="width:5%; text-align:center; border-bottom:none!important;"><b>क्र.स. </b></th>
									<th style="text-align:center; border-bottom:none!important; border-left:none!important;"><b> @Html.DisplayNameFor(model => model.YojanaName) </b></th>
									<th style="text-align:center; border-bottom:none!important; border-left:none!important;">कार्य</th>
								</tr>
							</thead>
						@* 	<tr>
								<td>1</td>
								<td>@Model.SamjhautaName</td>
								<td>
									<a type="button" id="विवरण" class="btn btn-secondary btn-sm oval-button" asp-action="PrintReport" asp-route-id="@Model.PlanningSamjhautaId">
										<i class="fa fa-list"> विवरण</i>
									</a>
								</td>
							</tr> *@
							<tbody style="background-color:#fff;">
								@foreach (var item in Model)
								{
									<tr>
										<td style="text-align:center">@_Utility.ConvertEnglishToNepali(i)</td>
										<td style="border-left:none!important;">@Html.DisplayFor(modelItem => item.YojanaName)</td>
										<td style="text-align:center; border-left:none!important;">
											<a type="button" id="विवरण" title="विवरण" class="btn btn-sm" asp-action="PrintContractReport" asp-route-id="@item.YojanaId">
												<i class="fa fa-list"> </i>
									        </a>
										</td>
								</tr>
									i++;
								}
							</tbody>

						</table>
						<div class="d-flex justify-content-end">
							<a asp-action="Index" asp-controller="Setup" asp-area="Contract" class="btn  btn-sm mt-3 mb-2 text-white"
							   style=" background-color:#424f63;">
								<i class="fa fa-arrow-left" aria-hidden="true"> पछाडि फर्कनुहोस्</i>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	<script>
		$("#zero_config").DataTable();
	</script>

	<script>
		$(function () { Message('@TempData["Msg"]') });
	</script>
}

