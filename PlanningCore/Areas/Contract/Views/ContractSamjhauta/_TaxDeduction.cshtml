@model Con_TaxDeductionViewModel
@inject IUtility _Utility
@using HtmlHelpers.BeginCollectionItemCore;

<div class="taxdiv row new">
    @using (Html.BeginCollectionItem("ConTaxList"))
    {
        <div class="col-lg-12 col-sm-12 col-12">
            <input asp-for="TaxDeductionId" class="form-control" type="hidden" />
            <input asp-for="ContractBhuktaniId" type="hidden" />
        </div>

        <div class="col-lg-3 col-sm-3 col-3 mt-3 ">

            <label asp-for="ConKarkattiId" class="control-label"></label>
            <select asp-for="ConKarkattiId" asp-items="await _Utility.GetContractKarkatti()" class="form-control form-control">
                <option>--छान्नुहोस--</option>
            </select>
            <span asp-validation-for="ConKarkattiId" class="text-danger"></span>

        </div>
        <div class="col-lg-3 col-sm-3 col-3 mt-3   ">

            <label asp-for="Amount" class="control-label"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>

        </div>
       
        <div class="col-lg-1 col-sm-1 col-2  d-flex justify-content-center align-items-center flex-column">

            <button type="button" onclick="DeleteRow(this)" class="row-button btn mt-5 btn-sm btn-danger btn-delete"><i class="fa fa-minus"></i></button>

        </div>
    }
</div>

