@model ContractSamjhautaViewModel
@inject IUtility _utility

@{
	var orgname = await _utility.GetMainSettingById(0);
	var year = Model.ContractDate.Substring(0, 4);
	var month = Model.ContractDate.Substring(5, 2);
	var day = Model.ContractDate.Substring(8, 2);
}
<div class="container pt-4 mt-4">
	<form asp-action="Karyadesh" method="get">
		<div>
			<partial name="_EnglishHeader" />
			<div class="container pt-4 mt-4">
				<h3>CONTRACT AGGREEMENT</h3>
				<br />
				<br />
				<br />
				<h4>@Model.YojanaName</h4>
				<h5>@Model.YojanaAddress</h5>
				<h5>@Model.IFBNumber</h5>
				<h5>@Model.ThekkaNumber</h5>
				<br />
				<br />
				<h5> <u>ISSUED BY:</u> </h5>
				<h5> OFFICE OF RRM </h5>
			</div>
		</div>
		<div class="" style="page-break-after: always;">
			<h6>सम्झौता</h6>
			<p>

				विक्रम सम्वत @_utility.ConvertEnglishToNepali(year) साल @_utility.ConvertEnglishToNepali(month) महिना @_utility.ConvertEnglishToNepali(day) गतेका दिन @orgname.PalikaName को कार्यालय @orgname.Address
				(जसलाई कार्यालय भनेर सम्बोधन गरिने छ ) एक पक्ष र @Model.ConsultantName
				(जसलाई ठेकेदार भनेर सम्बोधन गरिने छ) अर्को पक्ष बीच कार्यालय द्वारा मिति @_utility.ConvertEnglishToNepali(Model.BolPatraDate)
				गतेको सुचना अनुसार ठेक्का @Model.ThekkaNumber को कार्य गराउन बोलपत्र गरिएकोमा ठेकेदारले सो कार्य मू.अ.कर सहित रु
				@_utility.ConvertEnglishToNepali(Model.EstimatedAmount) मात्रमा पुरा गर्ने गरि
				बोलपत्र स्वीकृत भए बमोजिमको यो ठेक्का सम्झौता गरिएको छ
			</p>
			<p>
				यसमा निम्न शर्तहरु एवं व्यवस्थाहरु समावेश छन् !
				१.	ठेक्कामा शब्द र अभिव्यक्तिको अर्थ यसपछि संकेत गरिएको ठेक्काको शर्तहरुमा निर्धारित गरे अनुसार हुने छ ।
				२.	कार्यालयले ठेकेदारलाई दिइने भुक्तानी वापत ठेकेदारले सम्झौता गरेको कार्य ठेक्काको शर्त अनुसार खरीद तथा आपुर्ति गरि पुरा गर्ने छ ।
				३.	कार्यालयले सम्झौता गरेको कार्य खरीद तथा आपुति गरि पुरा गरेको र संभार गरेको रकम ठेक्कामा उल्लेख भएको रीत अनुसार समयमा ठेकेदार लाई भुक्तानी गर्ने छ ।
				४.	कार्यालय संग सम्झौता गरेको मितिले ७ (सात) दिन भित्र ठेकेदारले खरीद तथा आपुर्ति कार्य शुरु गरी २०८० माघ १८ सम्म सम्पन्न गरिसक्नु पर्नेछ ।
				५.	कार्यालयले असामान्य एवं विशेष कारण बाहेक ठेकेदारलाई म्याद थप गर्ने छैन । यस्तो कार्यविधि सार्वजनिक
				खरिद ऐन, २०६३ र नियमावली, २०६४(संशोधन सहित) बमोजिम बोलपत्रदातालाई जानकारी भएको मानिनेछ ।
				६.	ठेक्काको म्याद थप गर्ने, जरिवाना सम्बन्धी व्यवस्था, हर्जाना र क्षतिपुर्ति सम्बन्धी कुराहरु ठेक्का तोडिने व्यवस्था र भुक्तानीको तरिका स्थानीय निकाय आर्थिक प्रशासन नियमावली २०६४(संशोधन सहित) तथा ठेकेदारले हस्ताक्षर गरेको बोलपत्र पुस्तिकामा उल्लेखित छन् । यी दुईमा द्विविधा भएमा उल्लेखित सार्वजनिक खरिद ऐन, २०६३ र नियमावली, २०६४(संशोधन सहित) उल्लेख भएकोमा सोही बमोजिम र नभएमा बोलपत्र पुस्तिकामा उल्लेख भए बमोजिम हुने कुरामा दुवै पक्षलाई मान्य छ ।
				७.	बोलपत्र आव्हान सम्बन्धी सूचनाको ठेक्का नं. ०८०÷०८१÷०३ मा उल्लेखित शर्तहरु यसै सम्झौताका अंग हुने कुरामा दुवै पक्ष मंजुर छन् ।
				८.	निम्न कागजपत्रहरु यस ठेक्काको व्याख्या गर्नको लागि ठेक्काको अंगको रुपमा मानिने छ ।
				क) बोलपत्र र संलग्न परिशिष्ट । ख) नक्साहरु । ग) ठेक्का शर्तहरु । घ) खरीद तथा आपुर्ति कार्यका नेपाल गुणस्तर चिन्हको निर्माताको स्पेशिफिकेशन । ङ) पमिाणका मुल्य पत्र । च) विशेष शर्तहरु । छ) क देखि च सम्मका कागजातहरुको परिशिष्ट भएमा । ज) ठेक्का प्रदान गरेको सूचना । झ) कार्य शुरु गर्ने सूचना पत्र ।
				ञ) कार्य सम्पन्न गर्ने कार्य तालिका ।
				९.	यस ठेक्का पट्टाको वारेण्टी अवधि कार्य सम्पन्न भएको मितिले ३ महिना हुनेछ ।
				१०.	ठेकेदारले गुण्स्तरको प्रमाण÷प्रतिवेदन नेपाल सरकारबाट मान्यता प्राप्त संस्था बाट परिक्षण गराई अनिवार्य रुपले कार्यालयमा सामान आपुर्तिको समयमा पेश गर्नुपर्ने छ ।
				यी बाहेक अन्य कुराहरुका हकमा प्रचलित सार्वजनिक खरिद ऐन, २०६३ र नियमावली, २०६४(संशोधन सहित) हुनेछ ।
				दुवै पक्षले साक्षीको रोहवरमा माथि लेखिएको मितिका दिन यस ठेक्काको ठेक्का सम्झौतामा सही छाप गरि ठेक्कापट्टा गरिएको छ ।
			</p>
			<div class="d-flex" style="justify-content: space-between;">
				<p>
					raudgad
					@Model.SamjhautaPerson <br />
					प्रतिनिधि <br />
					(कम्पनीको छाप) <br />
					रहोवरः- @Model.Rahobar
					(साक्षीको सहीछाप)
				</p>
				<p>

					@Model.SwikritPersonName <br />
					प्र्मुख प्रशासकीय अधिकृत <br />
					कार्यालयको तर्फबाट सहीछाप गर्ने <br />
					(कार्यालयको छाप) <br />
					रहोवरः- @Model.SifarishPersonName
					(साक्षीको सहीछाप)
				</p>
			</div>
		</div>
	</form>
</div>