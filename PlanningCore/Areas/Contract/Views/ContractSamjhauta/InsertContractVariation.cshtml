@model VariationViewModel
@inject IUtility _Utility
@{
	ViewData["Title"] = "Index";
	var orgname = await _Utility.GetMainSettingById(0);
}
<style>
	.form-control {
		border-color: black;
	}

	.Sign {
		border: 1px solid #000;
		padding: 20px;
		margin-left: 5px;
	}
</style>
<style>
	.row123 {
		display: none; /* Hide the div initially using CSS */
	}
</style>

<div class="page-breadcrumb">
	<div class="row">
		<partial name="_PrintHeader" />
		<div class="col-12 d-flex no-block align-items-center">
			<h4 class="page-title"><u><strong>@ViewBag.ContractName</strong> को Variation फारम </u> </h4>
			<div class="ms-auto text-end">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb">
						<li class="breadcrumb-item"><a href="#">गृह पृष्ट</a></li>
						<li class="breadcrumb-item active" aria-current="page">
							Variation फारम
						</li>
					</ol>
				</nav>
			</div>
		</div>
	</div>
</div>

<div class="container-fluid">
	<div class="row">
		<form asp-action="InsertContractVariation" method="post">
			@Html.HiddenFor(model => model.Id)
			@Html.HiddenFor(model => model.ConSamjhautaId)

			<div class="col-md-12">
				<div class="card ">
					<div class="card-body row">
					   <div class="form-group  mt-2 col-md-2 col-2">
						<label asp-for="VariationTypeId"></label>
						<select asp-for="VariationTypeId" asp-items="await _Utility.GetVariationTypeList()" class="form-control">
						<option value="">--<label asp-for="VariationTypeId"></label> --</option>
						</select>
						</div> 

						<div class="form-group mt-2 col-md-2 col-2">
							<label asp-for="ContractAmt"></label>
							<input type="text" asp-for="ContractAmt" class="form-control" class="form-control" />
							<span asp-validation-for="ContractAmt"></span>
						</div>
						<div class="form-group mt-2 col-md-2 col-2">
							<label asp-for="Amount"></label>
							<input type="text" asp-for="Amount" class="form-control" class="form-control" />
							<span asp-validation-for="Amount"></span>
						</div>
						<div class="form-group mt-2 col-md-2 col-2">
							<label asp-for="VoDate"></label>
							<input type="text" asp-for="VoDate" class="form-control VoDate" class="form-control" />
							<input type="text" asp-for="VoDateEng" class="form-control VoDateEng" class="form-control" hidden />

							<span asp-validation-for="VoDate"></span>
						</div>
						<div class="form-group mt-2 col-md-2 col-2">
							<label asp-for="SamjhautaEndDate"></label>
							<input type="text" asp-for="SamjhautaEndDate" class="form-control SamjhautaEndDate" class="form-control" />
							<input type="text" asp-for="SamjhautaEndDateEng" class="form-control SamjhautaEndDateEng" class="form-control" hidden />

							<span asp-validation-for="SamjhautaEndDate"></span>
						</div>
						
						<div class="form-group mt-2 col-md-2 col-2">
							<label asp-for="Remarks"></label>
							<input type="text" asp-for="Remarks" class="form-control" class="form-control" />
							<span asp-validation-for="Remarks"></span>
						</div>
					</div>

					<hr />

				</div>
				<hr />

				<div class="card-body">
					<button type="submit" class="btn btn-success text-white oval-button">सुरक्षित गर्नुहोस</button>
					<a asp-controller="Contract" asp-action="ContractBimaIndex" asp-area="Admin" class="btn btn-sm btn-success oval-button"><i class="mdi mdi-arrow-left-box"></i>Back to List </a>

				</div>
			</div>
		</form>
	</div>


</div>

<link href="~/lib/nepalidatepicker/css/nepali.datepicker.v3.7.min.css" rel="stylesheet" />

@section Scripts {
	<script>
		NepaliDatePickerCalWithAdDateConverter(document.getElementsByClassName('SamjhautaEndDate'), document.getElementsByClassName('SamjhautaEndDateEng'))
		NepaliDatePickerCalWithAdDateConverter(document.getElementsByClassName('VoDate'), document.getElementsByClassName('VoDateEng'))
	
	</script>

}        