@model IEnumerable<InsuranceViewModel>
@inject IUtility _Utility
@{
    ViewData["Title"] = "Index";
    var contractId = ViewBag.ContractId;

}
<style>
    .oval-button {
        border-radius: 25px;
    }

    #zero_config > thead > tr > th {
        font-weight: bold;
        font-size: 14px;
    }

    #zero_config > tbody > tr > td {
        font-size: 13px;
    }

    table.table-bordered.dataTable th, table.table-bordered.dataTable td {
        border-left-width: thin;
    }

        table.table-bordered.dataTable th:last-child, table.table-bordered.dataTable th:last-child, table.table-bordered.dataTable td:last-child, table.table-bordered.dataTable td:last-child {
            border-right-width: thin;
        }
</style>
<div class="page-breadcrumb">
    <div class="row">
        <div class="col-12 d-flex no-block align-items-center">
            <h4 class="page-title"><u><strong>@ViewBag.ContractName</strong>को बिमा लिस्ट </u> </h4>
            <div class="ms-auto text-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="">गृह पृष्ट</a></li>
                        <li class="breadcrumb-item active" aria-current="page">
                            बिमा लिस्ट
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div style="text-align: right;">
                <a asp-controller="ContractSamjhauta" asp-action="InsertContractBima" asp-route-contractSamjhautaId="@contractId" asp-area="Contract" class="btn btn-primary btn-sm oval-button">
                    <i class="fas fa-plus-circle">
                        नयाँ बिमा विवरण
                    </i>
                </a>
            </div>
            <br />
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="zero_config" class="table table-striped table-bordered">
                            <thead>
                                @{
                                    int i = 1;
                                }
                                <tr>
                                    <th>क्र.स.</th>
                                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                                    <th>@Html.DisplayNameFor(model => model.CompanyName)</th>
                               
                                    <th></th>

                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {

                                    <tr>
                                        <td>@_Utility.ConvertEnglishToNepali(i)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                        <td>@Html.DisplayFor(modelItem => item.CompanyName)</td>
                 
                                        <td>
                                            <a type="button" id="सच्याउनुहोस" class="btn btn-secondary oval-button btn-sm" asp-action="InsertContractBima" asp-route-contractSamjhautaId="@item.ConSamjhautaId" asp-route-id="@item.Id">                                               
                                                <i class="fa fa-edit"> सच्याउनुहोस</i>
                                            </a>
                                          @*   <a type="button" id="विवरण" class="btn btn-primary oval-button btn-sm" asp-action="contractagreement" asp-route-id="@item.Id">
                                                <i class="fa fa-list "> विवरण</i>
                                            </a>   *@
                                            <a onclick="return confirm(' के तपाइँ निश्चित रद्द गर्न चाहानुहुन्छ??')" asp-controller="ContractSamjhauta" asp-action="DeleteInsurance" asp-area="Contract" class="btn btn-outline-danger btn-sm oval-button" asp-route-contractSamjhautaId="@item.ConSamjhautaId" asp-route-id="@item.Id"><i class="fas fa-trash"> Delete </i></a>
                                           
                                        </td>

                                    </tr>
                                    i++;
                                }
                            </tbody>

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $("#zero_config").DataTable();
    </script>
    <script>
        $(function () { Message('@TempData["del"]') });
    </script>
}
